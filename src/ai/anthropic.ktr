// Anthropic provider: serves `ai.infer_step` and `ai.infer_object` over the Messages API. Tool arguments
// are parsed JSON inside `tool_use` content blocks keyed by a block id (this provider's
// `types.call_ref`), which the next user turn echoes back as `tool_result` blocks — one message for the
// whole batch. Files inline by content type (`anthropic_file_blocks` over `ai.file_kind`), and this is
// the one provider that asks for prompt caching by marking `cache_control` breakpoints.

import ai
import ai.types
import ai.wire_names

@"An Anthropic connection: the model id, the API key, an optional system prompt, and the output-token cap
the Messages API requires on every request. Built once per `use anthropic.provider(...)`."
data connection(
  @"The Claude model id." model: string,
  @"Where the API key lives (env key or oauth name); resolved at each request, so a rotation lands mid-run." source: credentials.source,
  @"The system prompt, or `null` for none." system: string | null,
  @"The requested output cap, or `null` for this provider's stand-in (see `anthropic_max_tokens`)." max_output_tokens: integer | null,
  @"How many times a transient step is attempted before its error propagates." retry_attempts: integer,
  @"The first backoff delay (ms), doubled per retry." retry_base_milliseconds: number,
)

@"The `max_tokens` this provider sends: the caller's @client.max_output_tokens@, or 4096 when it is
`null`. The Messages API makes the field mandatory, so `null` means this provider's stand-in rather than
'send nothing'; a program that wants long output states a number."
agent anthropic_max_tokens(@"The provider connection." client: connection) -> integer {
  match (client.max_output_tokens) {
    case null -> 4096
    case cap -> cap
  }
}

@"Serve `ai.infer_step` over Anthropic for the extent of the continuation:
`use anthropic.provider(source = credentials.env(key = \"ANTHROPIC_API_KEY\"))`.
A step's provider failure (`ai.step_error`) is handed back as an `ai.inference_failed` outcome; a
transient one (a 429, a 5xx, a dropped connection) is first retried with exponential backoff, up to
@retry_attempts@ attempts from @retry_base_milliseconds@. Prompt caching is on and needs no argument:
every step marks two `cache_control` breakpoints, one at the end of the tools+@system@ prefix and one at
the end of the conversation, so a tool loop re-reads what it already sent at a tenth of the price. The
prompt-caching section of this module says what silently undoes it."
agent provider[R, effect E](
  @"The Claude model id. Defaults to `claude-sonnet-5`, the balanced tier of the series — a program that
has not chosen gets the model that is right for most turns." model: string ?= "claude-sonnet-5",
  @"Where the API key lives (env key or oauth name); resolved at each request, so a rotation lands mid-run." source: credentials.source,
  @"An optional system prompt, sent as the top-level `system` field; `null` (the default) sends none. \"\" is not the way to say none — the API rejects an empty text block." system: string | null ?= null,
  @"The per-step output cap. `null` (the default) sends 4096, since the Messages API requires the field on every request (see `anthropic_max_tokens`)." max_output_tokens: integer | null ?= null,
  @"How many times a transient step (a 429 / 5xx / dropped connection) is attempted before its error becomes an `inference_failed` outcome." retry_attempts: integer ?= 6,
  @"The first backoff delay in milliseconds, doubled per retry (capped at one minute)." retry_base_milliseconds: number ?= 2000.0,
  @"The computation to run with `ai.infer_step` / `ai.infer_object` served." continuation: agent (value: null) -> R with {...E, ai.infer_step, ai.infer_object},
) -> R with E | io | prelude.throw[env.missing_secret | oauth.server_error] {
  // The connection is a value and not handler state: nothing ever writes it back. The handler is
  // `parallel`, so several AIs' model calls stay concurrent instead of queueing at one FIFO.
  let client = connection(model = model, source = source, system = system, max_output_tokens = max_output_tokens, retry_attempts = retry_attempts, retry_base_milliseconds = retry_base_milliseconds)
  use parallel handler {
    request ai.infer_step(history: array[types.message], tool_metas: array[reflection.agent_metadata]) {
      // The retry loop and the catching are both `ai.with_retries`; what stays here is the call, wrapped
      // in a thunk because these arguments cannot ride a partial application of one.
      agent once(value: null) -> types.step_result with io | prelude.throw[ai.step_error | env.missing_secret | oauth.server_error] {
        anthropic_infer_step(client = client, history = history, tool_metas = tool_metas)
      }
      next ai.with_retries[types.step_result](attempts = client.retry_attempts, base_milliseconds = client.retry_base_milliseconds, attempt = once)
    }
    request ai.infer_object(history: array[types.message], schema: unknown) {
      agent once(value: null) -> types.object_result with io | prelude.throw[ai.step_error | env.missing_secret | oauth.server_error] {
        anthropic_infer_object(client = client, history = history, schema = schema)
      }
      next ai.with_retries[types.object_result](attempts = client.retry_attempts, base_milliseconds = client.retry_base_milliseconds, attempt = once)
    }
  }
  continuation(value = null)
}

// ── request body ─────────────────────────────────────────────────────────────

@"Map the agnostic role sum onto the Messages API's own token: the model's side speaks as \"assistant\"
here."
agent anthropic_role(@"Who spoke the turn." role: types.role) -> string {
  match (role) {
    case types.model_role(_) -> "assistant"
    case types.user_role(_) -> "user"
  }
}

@"A text content block — `{ \"type\": \"text\", \"text\": @text@ }`, built as a raw value tree."
agent anthropic_text_block(@"The block's text." text: string) -> unknown {
  { "type" = "text", text = text }
}

@"An image content block: a base64 `source` whose `media_type` is the file's recorded type and whose
`data` slot holds the file value placed directly into the tree. `http.json` materialises that slot at the
send boundary, so the image content never rides the value plane, the durable call record or the trace."
agent anthropic_image_block(
  @"The image file to inline." attachment: file,
  @"Its recorded content type, which the API takes as the block's `media_type`." media_type: string,
) -> unknown {
  {
    "type" = "image",
    source = {
      "type" = "base64",
      media_type = media_type,
      "data" = attachment,
    },
  }
}

@"A PDF content block — the same mechanism one arm over, with the file value in the `data` slot so its
bytes base64 at the send boundary exactly like an image's. The Messages API reads a document's pages as
text and as images, which is why a PDF takes this block rather than degrading to a note."
agent anthropic_document_block(
  @"The PDF file to inline." attachment: file,
  @"Its recorded content type — `application/pdf`, the only media type this block accepts." media_type: string,
) -> unknown {
  {
    "type" = "document",
    source = {
      "type" = "base64",
      media_type = media_type,
      "data" = attachment,
    },
  }
}

@"Whether the Messages API's image block accepts @media_type@. The documented set is exactly four — jpeg,
png, gif and webp — and any other image type is a 400 on the whole request, while `image/*` is a wide
family: a scanned fax arrives as `image/tiff` and a diagram as `image/svg+xml`."
agent anthropic_image_media_type(@"The file's normalized content type." media_type: string) -> boolean {
  match (media_type) {
    case "image/jpeg" -> true
    case "image/png" -> true
    case "image/gif" -> true
    case "image/webp" -> true
    case _ -> false
  }
}

@"An image file's blocks: the handle note and the `image` block when the API accepts the media type, and
the unreadable note when it does not. A type outside the accepted four earns a 400 that fails the whole
step, where the note costs the model one honest sentence and the conversation continues."
agent anthropic_image_blocks(
  @"The image file." attachment: file,
  @"Its normalized content type." media_type: string,
) -> array[unknown] {
  if (anthropic_image_media_type(media_type = media_type)) {
    [
      anthropic_text_block(text = ai.file_handle_note(attachment = attachment)),
      anthropic_image_block(attachment = attachment, media_type = media_type),
    ]
  } else {
    [anthropic_text_block(text = ai.unreadable_file_note(attachment = attachment, content_type = media_type))]
  }
}

@"One file as the content blocks it becomes — the per-file dispatch over `ai.file_kind`, one arm per shape
the Messages API accepts. An image and a PDF inline as their own block, each preceded by its handle note
so the model keeps the replay affordance; a textual file inlines as text; audio, video and every
opaque type become the note stating the content is unreadable. The document arm needs no media-type guard, since
`ai.classify_file` reaches it only for `application/pdf`. The same block types are legal in a turn's
content and inside a tool_result's content, so one dispatch serves both positions."
agent anthropic_file_blocks(
  @"One file, attached to a turn or returned by a tool." attachment: file,
  @"Whether this element is inside the inline window (`ai.inline_from_index`)." inline: boolean,
) -> array[unknown] {
  // Outside the window the handle note rides alone, whatever the type: every step re-sends the whole
  // conversation, and the model re-reads an older file with `view_file`.
  if (!inline) {
    [anthropic_text_block(text = ai.file_handle_note(attachment = attachment))]
  } else {
    match (ai.classify_file(attachment = attachment)) {
      case ai.image_file(content_type => content_type) -> anthropic_image_blocks(attachment = attachment, media_type = content_type)
      case ai.document_file(content_type => content_type) -> [
        anthropic_text_block(text = ai.file_handle_note(attachment = attachment)),
        anthropic_document_block(attachment = attachment, media_type = content_type),
      ]
      case ai.text_file(content_type => content_type) -> [
        anthropic_text_block(text = ai.file_text_note(attachment = attachment, content_type = content_type)),
      ]
      case ai.audio_file(content_type => content_type) -> [
        anthropic_text_block(text = ai.unreadable_file_note(attachment = attachment, content_type = content_type)),
      ]
      case ai.video_file(content_type => content_type) -> [
        anthropic_text_block(text = ai.unreadable_file_note(attachment = attachment, content_type = content_type)),
      ]
      case ai.opaque_file(content_type => content_type) -> [
        anthropic_text_block(text = ai.unreadable_file_note(attachment = attachment, content_type = content_type)),
      ]
    }
  }
}

@"A turn's content: the plain string when the turn carries no file, and otherwise the turn's text block
followed by each file's blocks. A file-less turn keeps the string shape — it says the same thing in fewer
bytes, and those bytes are prompt-cache prefix."
agent anthropic_turn_content(
  @"The turn's text." text: string,
  @"The turn's files." files: array[file],
  @"Whether this turn is inside the inline window." inline: boolean,
) -> unknown {
  let file_blocks = array.flatten(target = for (let attachment in files) {
    next anthropic_file_blocks(attachment = attachment, inline = inline)
  })
  if (array.length(target = file_blocks) == 0) {
    text
  } else {
    // An empty text block is rejected by the API, so the text block rides only when there is text to put
    // in it; each file's blocks carry their own note.
    let heading: array[unknown] = if (text == "") { [] } else { [anthropic_text_block(text = text)] }
    array.concat(left = heading, right = file_blocks)
  }
}

// ── prompt caching ───────────────────────────────────────────────────────────
//
// The cache is a prefix match over the rendered request, and the render order is tools -> system ->
// messages: a `cache_control` breakpoint caches everything up to and including its block, and a later
// request whose bytes agree that far reads the span at a tenth of the price. Two breakpoints carry the
// whole shape (the API allows four) — the end of the prompt prefix (the system block, or the last tool
// when there is no system prompt) and the end of the conversation, which also keeps consecutive requests
// inside the API's 20-block lookback. Both read only while the bytes before them stay identical, which is
// what the file-keyed inline window and `ai.with_context`'s injection point preserve. It is on with no
// argument: a write costs 1.25x and a read 0.1x, so the break-even is two uses, and a prefix under the
// model's minimum (1024 tokens on Sonnet, 4096 on Haiku) is simply not cached.

@"@block@ carrying a cache breakpoint: the same content block with `cache_control` added, at the default
five-minute TTL. A block that is not a record rides unchanged — the wire has no slot to mark on it."
agent anthropic_cached_block(@"The content block to mark." block: unknown) -> unknown {
  match (block) {
    case record(fields) -> record.set(target = fields, key = "cache_control", value = { "type" = "ephemeral" })
    case other -> other
  }
}

@"@blocks@ with the breakpoint on its last element, and an empty array unchanged. The tail rides as a
one-element slice, so the rewrite is total by construction."
agent anthropic_cached_last(@"The blocks whose end carries the breakpoint." blocks: array[unknown]) -> array[unknown] {
  let last_index = array.length(target = blocks) - 1
  let tail: array[unknown] = for (let block in array.slice(target = blocks, start = last_index, end = last_index + 1)) {
    next anthropic_cached_block(block = block)
  }
  array.concat(left = array.slice(target = blocks, start = 0, end = last_index), right = tail)
}

@"The `system` field as a block array carrying the prefix breakpoint. The Messages API takes a bare string
or a block array there and only a block can be marked, so the system prompt ships as one text block and
the tool declarations rendered before it cache along with it."
agent anthropic_system_blocks(@"The system prompt; never the empty one, which sends no field at all." system: string) -> unknown {
  [anthropic_cached_block(block = anthropic_text_block(text = system))]
}

@"A message's content with the breakpoint on its last block. A turn with no attachment carries its content
as a plain string, which becomes the one-element block array that says exactly the same thing."
agent anthropic_cached_content(@"The message's content — a string or an array of blocks." content: unknown) -> unknown {
  match (content) {
    case array(blocks) -> anthropic_cached_last(blocks = blocks)
    case string(text) -> [anthropic_cached_block(block = anthropic_text_block(text = text))]
    case other -> other
  }
}

@"@messages@ with the conversation breakpoint on the last block of the LAST message, and an empty
array unchanged — the same one-element-slice rewrite as `anthropic_cached_last`, one level up."
agent anthropic_cached_messages(@"The rendered messages." messages: array[unknown]) -> array[unknown] {
  let last_index = array.length(target = messages) - 1
  let tail: array[unknown] = for (let message in array.slice(target = messages, start = last_index, end = last_index + 1)) {
    next record.set(
      target = json.entries(target = message),
      key = "content",
      value = anthropic_cached_content(content = json.field(target = message, key = "content")),
    )
  }
  array.concat(left = array.slice(target = messages, start = 0, end = last_index), right = tail)
}

agent anthropic_call_block(@"One tool call of the model's batch." call: types.tool_call, @"The step's wire-name map." map: wire_names.name_map) -> unknown {
  // Replay the model's tool_use verbatim: its block id, name and the original input. The name rides as
  // the wire name, because the API validates a replayed tool_use name like a tool declaration; the input
  // is the model's args document dropped straight into the value tree.
  {
    "type" = "tool_use",
    id = call.ref.token,
    name = wire_names.wire_name_of(map = map, real = call.name),
    input = call.args,
  }
}

@"One tool's output, keyed back to its call — with the result's files inlined inside the tool_result's own
content array, through the same `anthropic_file_blocks` dispatch the turn path uses. The API documents a
tool_result's content as taking `text`, `image`, `document` or `search_result` blocks, and inside rather
than beside is what it licenses: a user message carrying tool results may only append text after them, and
keeping tool content inside the block is what marks it untrusted."
agent anthropic_result_block(
  @"One tool's output, keyed back to its call." result: types.tool_result,
  @"Whether this result batch is inside the inline window." inline: boolean,
) -> unknown {
  let file_blocks = array.flatten(target = for (let attachment in result.files) {
    next anthropic_file_blocks(attachment = attachment, inline = inline)
  })
  if (array.length(target = file_blocks) == 0) {
    // A result with no file keeps the string content: fewer bytes, and those bytes are cache prefix.
    {
      "type" = "tool_result",
      tool_use_id = result.ref.token,
      content = result.text,
    }
  } else {
    // An empty text block is rejected by the API, so the result's own text rides only when it has some.
    let text_blocks: array[unknown] = if (result.text == "") { [] } else { [anthropic_text_block(text = result.text)] }
    {
      "type" = "tool_result",
      tool_use_id = result.ref.token,
      content = array.concat(left = text_blocks, right = file_blocks),
    }
  }
}

agent anthropic_message(
  @"One history element." message: types.message,
  @"The step's wire-name map." map: wire_names.name_map,
  @"Whether this element is inside the inline window (`ai.inline_from_index`)." inline: boolean,
) -> unknown {
  match (message) {
    case types.turn(role => role, text => text, files => files) -> {
      {
        role = anthropic_role(role = role),
        content = anthropic_turn_content(text = text, files = files, inline = inline),
      }
    }
    case types.call_turn(calls => calls) -> {
      {
        role = "assistant",
        content = for (let call in calls) { next anthropic_call_block(call = call, map = map) },
      }
    }
    case types.result_turn(results => results) -> {
      // The whole batch's results ride ONE user message: the API pairs every tool_use id of the
      // assistant turn against the tool_result blocks of the single next user message.
      {
        role = "user",
        content = for (let result in results) { next anthropic_result_block(result = result, inline = inline) },
      }
    }
  }
}

agent anthropic_tool(@"One tool's derived schema." meta: reflection.agent_metadata, @"The step's wire-name map." map: wire_names.name_map) -> unknown {
  // The tool is declared under its WIRE name (the qualified name 400s the Messages API); the loop maps
  // the model's pick back to the real name when it dispatches. `meta.input` is already a document value
  // (`$ref` / `$defs` / `$schema` keys and all), so it drops straight into the value tree verbatim.
  {
    name = wire_names.wire_name_of(map = map, real = meta.name),
    description = meta.description,
    input_schema = meta.input,
  }
}

@"The history rendered as Messages API messages, with the inline window applied. Both request bodies
render through this, so a step and a structured step re-send the same bytes for the same conversation,
which is also what lets the prompt-cache prefix match across them."
agent anthropic_messages(
  @"The conversation so far." history: array[types.message],
  @"The step's wire-name map." map: wire_names.name_map,
) -> array[unknown] {
  let boundary = ai.inline_from_index(history = history)
  let older = for (let message in array.slice(target = history, start = 0, end = boundary)) {
    next anthropic_message(message = message, map = map, inline = false)
  }
  let freshest = for (let message in array.slice(target = history, start = boundary, end = array.length(target = history))) {
    next anthropic_message(message = message, map = map, inline = true)
  }
  array.concat(left = older, right = freshest)
}

agent anthropic_request_body(
  @"The provider connection." client: connection,
  @"The conversation so far." history: array[types.message],
  @"The tools' derived schemas." tool_metas: array[reflection.agent_metadata],
  @"The step's wire-name map." map: wire_names.name_map,
) -> unknown {
  let rendered = anthropic_messages(history = history, map = map)
  // The conversation breakpoint, so the next step of this turn reads the history this one sent.
  let messages = anthropic_cached_messages(messages = rendered)
  // Thinking stays off explicitly: newer Claude models run adaptive thinking when the field is omitted,
  // and a thinking block must then be replayed verbatim on the next call turn — the agnostic vocabulary
  // has no slot for a standalone content block, and dropping it fails the follow-up request.
  let thinking = { "type" = "disabled" }
  let base: record[unknown] = {
    model = client.model,
    max_tokens = anthropic_max_tokens(client = client),
    messages = messages,
    thinking = thinking,
  }
  // The prompt prefix ends at the system block when there is one, and at the tools when there is not, so
  // exactly one of the two carries the prefix breakpoint.
  let with_system = match (client.system) {
    case null -> base
    case standing -> record.set(target = base, key = "system", value = anthropic_system_blocks(system = standing))
  }
  let prefix_on_tools = match (client.system) {
    case null -> true
    case _ -> false
  }
  // The newest user turn's opaque author tag becomes the abuse-attribution metadata; the field is omitted
  // entirely for an unattributed step, keeping the wire unchanged when no author flows.
  let with_metadata = match (ai.attribution(history = history)) {
    case null -> with_system
    case author -> record.set(target = with_system, key = "metadata", value = { user_id = author })
  }
  // The request body as a raw value tree: `post_json` serialises it, and `http.json`'s slot contract
  // base64s each `file` leaf in place at the send boundary. A tool schema's literal `$ref` / `$defs` keys
  // ride verbatim, since `meta.input` is already a document value.
  if (array.length(target = tool_metas) == 0) {
    with_metadata
  } else {
    let tools = for (let meta in tool_metas) { next anthropic_tool(meta = meta, map = map) }
    // With no system block to carry it, the prefix breakpoint rides the last tool: the declarations are
    // the bulk of a resident's prefix.
    let declared = if (prefix_on_tools) { anthropic_cached_last(blocks = tools) } else { tools }
    record.set(target = with_metadata, key = "tools", value = declared)
  }
}

@"The structured-output request body: @schema@ as the input schema of one synthetic tool with
`tool_choice` pinned to it. It takes the same prefix breakpoint as a step, but no conversation breakpoint
— an object step states its own context and is not re-sent with a growing history, so marking its messages
would pay a cache write nothing ever reads."
agent anthropic_object_body(
  @"The provider connection." client: connection,
  @"The conversation so far." history: array[types.message],
  @"The JSON Schema the reply must conform to." schema: unknown,
) -> unknown {
  // The name map is empty: a replayed call turn in @history@ rides under its real name via the fallback.
  let map = wire_names.build_name_map(tool_metas = [])
  let messages = anthropic_messages(history = history, map = map)
  let prefix_on_tools = match (client.system) {
    case null -> true
    case _ -> false
  }
  let record_result = {
    name = "record_result",
    description = "Record the final result in the required shape.",
    input_schema = schema,
  }
  let base: record[unknown] = {
    model = client.model,
    max_tokens = anthropic_max_tokens(client = client),
    messages = messages,
    thinking = { "type" = "disabled" },
    tools = if (prefix_on_tools) { [anthropic_cached_block(block = record_result)] } else { [record_result] },
    tool_choice = { "type" = "tool", name = "record_result" },
  }
  match (client.system) {
    case null -> base
    case standing -> record.set(target = base, key = "system", value = anthropic_system_blocks(system = standing))
  }
}

// ── response parsing ─────────────────────────────────────────────────────────

agent anthropic_blocks(@"The parsed response document." parsed: unknown) -> array[unknown] {
  match (json.field(target = parsed, key = "content")) {
    case array(items) -> items
    case _ -> []
  }
}

agent anthropic_block_kind(@"One response content block." block: unknown) -> string {
  match (json.field(target = block, key = "type")) {
    case string(value) -> value
    case _ -> ""
  }
}

agent anthropic_tool_call(@"A `tool_use` response block." block: unknown, @"The step's wire-name map." map: wire_names.name_map) -> types.tool_call {
  types.tool_call(
    // Reverse the wire name back to the real qualified name: the loop dispatches by matching this
    // against tool metadata, so it must be the real name, not the shortened one the model saw.
    name = wire_names.real_name_of(map = map, wire = json.text(target = json.field(target = block, key = "name"))),
    ref = types.call_ref(token = json.text(target = json.field(target = block, key = "id"))),
    args = json.field(target = block, key = "input"),
  )
}

agent anthropic_parse_step(@"The parsed response document." parsed: unknown, @"The step's wire-name map." map: wire_names.name_map) -> types.step {
  let blocks = anthropic_blocks(parsed = parsed)
  let calls = for (let block in blocks, var acc: array[types.tool_call] = []) {
    if (anthropic_block_kind(block = block) == "tool_use") {
      next with { acc = array.append(target = acc, value = anthropic_tool_call(block = block, map = map)) }
    } else {
      next with { acc = acc }
    }
  } then (_blocks) { acc }
  if (array.length(target = calls) == 0) {
    // The content array decides the step, not stop_reason: a tool_use stop always ships tool_use blocks,
    // and every other stop reads out as the step's final text, so no empty call batch can be
    // manufactured. Only `text` blocks join the reply.
    let texts = for (let block in blocks, var acc: array[string] = []) {
      if (anthropic_block_kind(block = block) == "text") {
        next with { acc = array.append(target = acc, value = json.text(target = json.field(target = block, key = "text"))) }
      } else {
        next with { acc = acc }
      }
    } then (_blocks) { acc }
    types.step_final(text = string.join(parts = texts, separator = ""))
  } else {
    types.step_call(calls = calls)
  }
}

@"The step's token accounting off the response's `usage`. The context a step read splits across
`input_tokens` and the cache counters (`cache_read_input_tokens` / `cache_creation_input_tokens`), so the
occupancy is their sum and an absent field reads as 0. A warm step therefore reports most of its context
under `cache_read_input_tokens`, which is how a run trace shows the cache working."
agent anthropic_usage(@"The parsed response document." parsed: unknown) -> types.usage {
  let counts = json.field(target = parsed, key = "usage")
  types.usage(
    input_tokens = ai.token_count(node = json.field(target = counts, key = "input_tokens"))
      + ai.token_count(node = json.field(target = counts, key = "cache_read_input_tokens"))
      + ai.token_count(node = json.field(target = counts, key = "cache_creation_input_tokens")),
    output_tokens = ai.token_count(node = json.field(target = counts, key = "output_tokens")),
  )
}

@"One Anthropic model step over the history + tool schemas: the body is built as a value tree and the
reply parsed by `post_json` in Katari, so only the POST leaves the runtime and each inlined `file` base64s
at that send boundary."
agent anthropic_infer_step(
  @"The provider connection." client: connection,
  @"The conversation so far." history: array[types.message],
  @"The tools' derived schemas." tool_metas: array[reflection.agent_metadata],
) -> types.step_result {
  // One wire-name map per step, rebuilt deterministically from the tools, so the request's tool names and
  // the response's reversal agree without durable state.
  let map = wire_names.build_name_map(tool_metas = tool_metas)
  let body = anthropic_request_body(client = client, history = history, tool_metas = tool_metas, map = map)
  // `http.post_json` serialises the value tree, parses the reply back to a document value, and classifies
  // a non-2xx itself — so what it throws is already an arm of `ai.step_error`.
  let response = http.post_json(
    url = "https://api.anthropic.com/v1/messages",
    body = body,
    headers = {
      "x-api-key" = credentials.resolve(source = client.source),
      "anthropic-version" = "2023-06-01",
    },
    context = "anthropic.infer_step",
  )
  types.step_result(step = anthropic_parse_step(parsed = response, map = map), usage = anthropic_usage(parsed = response))
}

@"One Anthropic structured-output step, as a forced tool call: @schema@ rides as the input schema of one
synthetic tool and `tool_choice` pins the model to it, so the decoded object arrives already parsed as the
tool_use block's `input` — no special API surface, every Claude model. A reply with no tool_use block
throws `json.parse_error`."
agent anthropic_infer_object(
  @"The provider connection." client: connection,
  @"The conversation so far." history: array[types.message],
  @"The JSON Schema the reply must conform to." schema: unknown,
) -> types.object_result {
  let response = http.post_json(
    url = "https://api.anthropic.com/v1/messages",
    body = anthropic_object_body(client = client, history = history, schema = schema),
    headers = {
      "x-api-key" = credentials.resolve(source = client.source),
      "anthropic-version" = "2023-06-01",
    },
    context = "anthropic.infer_object",
  )
  // The forced tool's input IS the decoded object — the same early-return scan as `dispatch_one`.
  for (let block in anthropic_blocks(parsed = response)) {
    if (anthropic_block_kind(block = block) == "tool_use") {
      return types.object_result(
        value = json.field(target = block, key = "input"),
        usage = anthropic_usage(parsed = response),
      )
    } else {
      null
    }
  }
  prelude.throw(error = json.parse_error(message = "anthropic: no tool_use block in the structured-output reply"))
}
