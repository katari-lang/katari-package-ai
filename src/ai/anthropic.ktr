// Anthropic provider: serves the `ai.infer_step` request over the Messages API. Where OpenAI ships
// tool arguments as a JSON string, Anthropic keeps them as parsed JSON inside `tool_use` content
// blocks, keyed by a block id (carried in tool_call.opaque / tool_result.call_id) that the next user
// turn echoes back as `tool_result` blocks — one message for the whole batch. A turn's image files
// inline as `image` content blocks: the request body posts as an `http.json` value tree with
// `http.fetch`, so each image's `data` slot base64s at the send boundary, never on the value plane.
// Same agnostic vocabulary, different shaping — and the same one-line integration:
// `use anthropic.provider(api_key = ...)`.

import ai
import ai.types

@"An Anthropic connection: the model id, the API key, an optional system prompt, and the
output-token cap the Messages API requires on every request. Provider handler state — built once per
`use anthropic.provider(...)`."
data connection(
  @"The Claude model id." model: string,
  @"The API key, sent as the `x-api-key` header." api_key: string of private,
  @"The system prompt; empty sends none." system: string,
  @"The required `max_tokens`: the output-token cap of one step." max_tokens: integer,
)

@"Serve `ai.infer_step` over Anthropic for the extent of the continuation:
`use anthropic.provider(api_key = env.get_secret(key = \"ANTHROPIC_API_KEY\"))`.
A step's provider failure (`ai.step_error`) is raised here, at the provider's use site."
agent provider[R, effect E](
  @"The Claude model id." model: string ?= "claude-sonnet-5",
  @"The API key, sent as the `x-api-key` header." api_key: string of private,
  @"An optional system prompt, sent as the top-level `system` field." system: string ?= "",
  @"The output-token cap of one step; the Messages API requires one on every request." max_tokens: integer ?= 4096,
  @"The computation to run with `ai.infer_step` served." continuation: agent (value: null) -> R with {...E, ai.infer_step},
) -> R with E | io | prelude.throw[ai.step_error] {
  use handler (var client = connection(model = model, api_key = api_key, system = system, max_tokens = max_tokens)) {
    request ai.infer_step(history: array[types.message], tool_metas: array[reflection.agent_metadata]) {
      next anthropic_infer_step(client = client, history = history, tool_metas = tool_metas)
    }
  }
  continuation(value = null)
}

// ── request body ─────────────────────────────────────────────────────────────

@"Map the vocabulary role onto the Messages API role: our \"model\" speaks as \"assistant\"."
agent anthropic_role(@"The `ai.types` turn role (\"user\" / \"model\")." role: string) -> string {
  match (role) {
    case "model" -> "assistant"
    case _ -> "user"
  }
}

@"Every file of a turn as a handle note, joined for the turn's text. The `$ref` handle is the exact
object the model replays into a tool call (`view_image` to re-see it, `send_files` to post it), so the
note is the replay affordance — kept for an image too, alongside the image block that lets the model
SEE it (see `anthropic_turn_content`)."
agent anthropic_file_notes(@"The files attached to a turn." files: array[file]) -> string {
  let notes = for (let attachment in files) { next f"\n[attached file: ${json.to_text(value = attachment)}]" }
  string.join(parts = notes, separator = "")
}

@"Whether a file inlines as an Anthropic image block: its recorded content type begins \"image/\" (the
Messages API image block takes only image media types). A file with another or no recorded type stays
a handle note."
agent anthropic_is_image(@"The file to test." attachment: file) -> boolean {
  string.starts_with(value = file.content_type(value = attachment), search = "image/")
}

@"A text content block — `{ \"type\": \"text\", \"text\": @text@ }`, built as a raw value tree. `type`
is a keyword, so the object is assembled with `record.set` instead of a literal."
agent anthropic_text_block(@"The block's text." text: string) -> unknown {
  let base = { text = text }
  record.set(target = base, key = "type", value = "text")
}

@"An image content block: a base64 `source` whose `media_type` is the file's recorded type and whose
`data` slot holds the file VALUE placed DIRECTLY into the tree. `http.json` materialises that slot —
reading the bytes and base64-ing them in place — only at the send boundary, so the image content never
rides the value plane, the durable call record or the trace. `type` / `data` are keywords, so those
slots are assembled with `record.set`."
agent anthropic_image_block(@"The image file to inline." attachment: file) -> unknown {
  let source_base = { media_type = file.content_type(value = attachment) }
  let source_typed = record.set(target = source_base, key = "type", value = "base64")
  let source = record.set(target = source_typed, key = "data", value = attachment)
  let block_base: record[unknown] = { source = source }
  record.set(target = block_base, key = "type", value = "image")
}

@"A turn's content: the plain string (text + every file's handle note) when the turn carries no image,
or an array of one text block plus one image block per image file when it does. An image file inlines
so the model can SEE it; a non-image file stays a handle note (the image block takes only images). The
text block still carries every file's handle note, so the model can replay any of them into a tool."
agent anthropic_turn_content(@"The turn's text." text: string, @"The turn's files." files: array[file]) -> unknown {
  let image_blocks = array.flatten(target = for (let attachment in files) {
    if (anthropic_is_image(attachment = attachment)) {
      next [anthropic_image_block(attachment = attachment)]
    } else {
      next []
    }
  })
  let note_text = f"${text}${anthropic_file_notes(files = files)}"
  if (array.length(target = image_blocks) == 0) {
    // No image to inline: the plain string content (text + handle notes), exactly as before.
    note_text
  } else {
    // Images present: a text block (text + every file's handle note) followed by the image blocks.
    array.concat(left = [anthropic_text_block(text = note_text)], right = image_blocks)
  }
}

agent anthropic_call_block(@"One tool call of the model's batch." call: types.tool_call) -> unknown {
  // Replay the model's tool_use verbatim: its block id + name + the original input. The input is a
  // literal json document (the model's parsed args) flattened straight into the value tree, so its
  // literal keys survive; `type` is a keyword, assembled with record.set instead of a literal.
  let base = {
    id = call.opaque,
    name = call.name,
    input = ai.json_to_value(node = call.args),
  }
  record.set(target = base, key = "type", value = "tool_use")
}

agent anthropic_result_block(@"One tool's output, keyed back to its call." result: types.tool_result) -> unknown {
  // `type` is a keyword, so the object is assembled with record.set instead of a literal.
  let base = {
    tool_use_id = result.call_id,
    content = result.text,
  }
  record.set(target = base, key = "type", value = "tool_result")
}

agent anthropic_message(@"One history element." message: types.message) -> unknown {
  match (message) {
    case types.turn(role => role, text => text, files => files) -> {
      {
        role = anthropic_role(role = role),
        content = anthropic_turn_content(text = text, files = files),
      }
    }
    case types.call_turn(calls => calls) -> {
      {
        role = "assistant",
        content = for (let call in calls) { next anthropic_call_block(call = call) },
      }
    }
    case types.result_turn(results => results) -> {
      // The whole batch's results ride ONE user message: the API pairs every tool_use id of the
      // assistant turn against the tool_result blocks of the single next user message.
      {
        role = "user",
        content = for (let result in results) { next anthropic_result_block(result = result) },
      }
    }
  }
}

agent anthropic_tool(@"One tool's derived schema." meta: reflection.agent_metadata) -> unknown {
  // The derived input schema is a literal json document (`$ref` / `$defs` / `$schema` keys and all)
  // spliced verbatim into the value tree; a wire-reading decode would corrupt those keys.
  {
    name = meta.name,
    description = meta.description,
    input_schema = ai.json_to_value(node = meta.input),
  }
}

agent anthropic_request_body(
  @"The provider connection." client: connection,
  @"The conversation so far." history: array[types.message],
  @"The tools' derived schemas." tool_metas: array[reflection.agent_metadata],
) -> unknown {
  let messages = for (let message in history) { next anthropic_message(message = message) }
  // Thinking stays OFF, explicitly: newer Claude models run adaptive thinking when the field is
  // omitted, and a thinking block must then be replayed VERBATIM (signature included) on the next
  // call turn — the agnostic vocabulary has no slot for one (Gemini's per-call thoughtSignature fits
  // tool_call.opaque; a standalone content block does not), and dropping it fails the follow-up
  // request.
  let thinking = record.set(target = record.empty(), key = "type", value = "disabled")
  let base: record[unknown] = {
    model = client.model,
    max_tokens = client.max_tokens,
    messages = messages,
    thinking = thinking,
  }
  let with_system = if (client.system == "") {
    base
  } else {
    record.set(target = base, key = "system", value = client.system)
  }
  // The request body as a RAW value tree, built DIRECTLY (no `json.json` round-trip): `http.json` walks
  // it at the send boundary and base64s each `file` leaf — the image `data` slots placed directly above
  // — in place, so the bytes never land on the value plane. Building `unknown` directly (rather than a
  // `json.json` tree flattened by `decode[unknown]`) keeps a tool schema's literal `$ref` / `$defs`
  // keys intact — a wire-reading decode would mistake them for file handles.
  if (array.length(target = tool_metas) == 0) {
    with_system
  } else {
    let tools = for (let meta in tool_metas) { next anthropic_tool(meta = meta) }
    record.set(target = with_system, key = "tools", value = tools)
  }
}

// ── response parsing ─────────────────────────────────────────────────────────

agent anthropic_blocks(@"The parsed response document." parsed: json.json) -> array[json.json] {
  match (json.field(target = parsed, key = "content")) {
    case json.json_array(items => items) -> items
    case _ -> []
  }
}

agent anthropic_block_kind(@"One response content block." block: json.json) -> string {
  match (json.field(target = block, key = "type")) {
    case json.json_string(value => value) -> value
    case _ -> ""
  }
}

agent anthropic_tool_call(@"A `tool_use` response block." block: json.json) -> types.tool_call {
  types.tool_call(
    name = json.text(target = json.field(target = block, key = "name")),
    opaque = json.text(target = json.field(target = block, key = "id")),
    args = json.field(target = block, key = "input"),
  )
}

agent anthropic_parse_step(@"The raw response body." response: string) -> types.step with prelude.throw[json.parse_error] {
  let blocks = anthropic_blocks(parsed = json.parse(text = response))
  let calls = for (let block in blocks, var acc: array[types.tool_call] = []) {
    if (anthropic_block_kind(block = block) == "tool_use") {
      next with { acc = array.append(target = acc, value = anthropic_tool_call(block = block)) }
    } else {
      next with { acc = acc }
    }
  } then (_blocks) { acc }
  if (array.length(target = calls) == 0) {
    // The content array decides the step, not stop_reason: a "tool_use" stop always ships tool_use
    // blocks, and every other stop ("end_turn", or the degenerate "max_tokens" / "refusal" whose
    // text is partial or empty) reads out as the step's final text. Branching on stop_reason could
    // manufacture an EMPTY call batch, which the loop must never see. Only `text` blocks join the
    // reply — any other block kind carries no user-facing text.
    let texts = for (let block in blocks, var acc: array[string] = []) {
      if (anthropic_block_kind(block = block) == "text") {
        next with { acc = array.append(target = acc, value = json.text(target = json.field(target = block, key = "text"))) }
      } else {
        next with { acc = acc }
      }
    } then (_blocks) { acc }
    types.step_final(text = string.join(parts = texts, separator = ""))
  } else {
    types.step_call(calls = calls)
  }
}

@"One Anthropic model step over the history + tool schemas (the body built as a value tree and the
reply parsed as json in Katari; only the POST leaves the runtime, and each image `file` in the body
base64s at that send boundary via `http.json`)."
agent anthropic_infer_step(
  @"The provider connection." client: connection,
  @"The conversation so far." history: array[types.message],
  @"The tools' derived schemas." tool_metas: array[reflection.agent_metadata],
) -> types.step {
  let body = anthropic_request_body(client = client, history = history, tool_metas = tool_metas)
  let headers = record.set(
    target = record.set(target = record.empty(), key = "x-api-key", value = client.api_key),
    key = "anthropic-version",
    value = "2023-06-01",
  )
  // `http.json` sends the value tree as application/json (the transport defaults the Content-Type), with
  // each image `file` leaf read from the blob store and base64'd only here. A non-2xx is raised as
  // `http.status_error` (the opinionated JSON-API stance `post_json` used to take on this provider's behalf).
  let response = http.fetch(
    url = "https://api.anthropic.com/v1/messages",
    method = "POST",
    headers = headers,
    body = http.json(value = body),
  )
  if (response.status >= 200 && response.status < 300) {
    anthropic_parse_step(response = response.body)
  } else {
    prelude.throw(error = http.status_error(status = response.status, body = response.body))
  }
}
