// Anthropic provider: serves the `ai.infer_step` request over the Messages API. Where OpenAI ships
// tool arguments as a JSON string, Anthropic keeps them as parsed JSON inside `tool_use` content
// blocks, keyed by a block id (carried in tool_call.opaque / tool_result.call_id) that the next user
// turn echoes back as `tool_result` blocks — one message for the whole batch. A turn's image files
// inline as `image` content blocks: the request body posts as an `http.json` value tree with
// `http.fetch`, so each image's `data` slot base64s at the send boundary, never on the value plane.
// Same agnostic vocabulary, different shaping — and the same one-line integration:
// `use anthropic.provider(api_key = ...)`.

import ai
import ai.types

@"An Anthropic connection: the model id, the API key, an optional system prompt, and the
output-token cap the Messages API requires on every request. Provider handler state — built once per
`use anthropic.provider(...)`."
data connection(
  @"The Claude model id." model: string,
  @"The API key, sent as the `x-api-key` header." api_key: string of private,
  @"The system prompt; empty sends none." system: string,
  @"The required `max_tokens`: the output-token cap of one step." max_tokens: integer,
  @"How many times a transient step is attempted before its error propagates." retry_attempts: integer,
  @"The first backoff delay (ms), doubled per retry." retry_base_ms: number,
)

@"Serve `ai.infer_step` over Anthropic for the extent of the continuation:
`use anthropic.provider(api_key = env.get_secret(key = \"ANTHROPIC_API_KEY\"))`.
A step's provider failure (`ai.step_error`) is raised here, at the provider's use site — but a TRANSIENT
one (a 429 rate limit, a 5xx, a dropped connection) is first retried with exponential backoff (up to
@retry_attempts@ attempts from @retry_base_ms@); only a fatal error or an exhausted budget surfaces."
agent provider[R, effect E](
  @"The Claude model id." model: string ?= "claude-sonnet-5",
  @"The API key, sent as the `x-api-key` header." api_key: string of private,
  @"An optional system prompt, sent as the top-level `system` field." system: string ?= "",
  @"The output-token cap of one step; the Messages API requires one on every request." max_tokens: integer ?= 4096,
  @"How many times a transient step (a 429 / 5xx / dropped connection) is attempted before its error propagates." retry_attempts: integer ?= 6,
  @"The first backoff delay in milliseconds, doubled per retry (capped at one minute)." retry_base_ms: number ?= 2000.0,
  @"The computation to run with `ai.infer_step` / `ai.infer_object` served." continuation: agent (value: null) -> R with {...E, ai.infer_step, ai.infer_object},
) -> R with E | io | prelude.throw[ai.step_error] {
  use handler (var client = connection(model = model, api_key = api_key, system = system, max_tokens = max_tokens, retry_attempts = retry_attempts, retry_base_ms = retry_base_ms)) {
    request ai.infer_step(history: array[types.message], tool_metas: array[reflection.agent_metadata]) {
      // Retry a transient step with exponential backoff; a fatal error (a non-retryable status, malformed
      // JSON) or an exhausted budget propagates. The attempt handler lives in its own agent so the loop
      // never nests a handler (only pure classification is inline here).
      next for (let attempt in array.range(start = 0, end = client.retry_attempts), var pending: null = null) {
        match (anthropic_step_attempt(client = client, history = history, tool_metas = tool_metas)) {
          case ai.attempt_ok(result => result) -> { break result }
          case ai.attempt_err(error => error) -> {
            if (!ai.is_transient(error = error) || attempt + 1 >= client.retry_attempts) {
              prelude.throw(error = error)
            } else {
              time.sleep(milliseconds = ai.backoff_ms(attempt = attempt, base_ms = client.retry_base_ms))
              next with { pending = null }
            }
          }
        }
      } then (_attempts) {
        prelude.throw(error = http.fetch_error(message = "anthropic step not attempted (retry_attempts must be >= 1)"))
      }
    }
    request ai.infer_object(history: array[types.message], schema: unknown) {
      next for (let attempt in array.range(start = 0, end = client.retry_attempts), var pending: null = null) {
        match (anthropic_object_attempt(client = client, history = history, schema = schema)) {
          case ai.attempt_ok(result => result) -> { break result }
          case ai.attempt_err(error => error) -> {
            if (!ai.is_transient(error = error) || attempt + 1 >= client.retry_attempts) {
              prelude.throw(error = error)
            } else {
              time.sleep(milliseconds = ai.backoff_ms(attempt = attempt, base_ms = client.retry_base_ms))
              next with { pending = null }
            }
          }
        }
      } then (_attempts) {
        prelude.throw(error = http.fetch_error(message = "anthropic object step not attempted (retry_attempts must be >= 1)"))
      }
    }
  }
  continuation(value = null)
}

@"ONE Anthropic step attempt, catching any `step_error` into an `ai.attempt` verdict so the provider's
retry loop can classify it — the catching handler lives here, at the agent top, so the loop never nests one."
agent anthropic_step_attempt(client: connection, history: array[types.message], tool_metas: array[reflection.agent_metadata]) -> ai.attempt[types.step_result] with io {
  use handler {
    request prelude.throw(error: ai.step_error) -> never { break ai.attempt_err(error = error) }
  }
  ai.attempt_ok(result = anthropic_infer_step(client = client, history = history, tool_metas = tool_metas))
}

@"ONE Anthropic structured-output attempt, the `anthropic_step_attempt` twin for `infer_object`."
agent anthropic_object_attempt(client: connection, history: array[types.message], schema: unknown) -> ai.attempt[types.object_result] with io {
  use handler {
    request prelude.throw(error: ai.step_error) -> never { break ai.attempt_err(error = error) }
  }
  ai.attempt_ok(result = anthropic_infer_object(client = client, history = history, schema = schema))
}

// ── request body ─────────────────────────────────────────────────────────────

@"Map the vocabulary role onto the Messages API role: our \"model\" speaks as \"assistant\"."
agent anthropic_role(@"The `ai.types` turn role (\"user\" / \"model\")." role: string) -> string {
  match (role) {
    case "model" -> "assistant"
    case _ -> "user"
  }
}

@"Every file of a turn as a handle note, joined for the turn's text. The `$katari_ref` handle is the exact
object the model replays into a tool call (`view_image` to re-see it, `send_files` to post it), so the
note is the replay affordance — kept for an image too, alongside the image block that lets the model
SEE it (see `anthropic_turn_content`)."
agent anthropic_file_notes(@"The files attached to a turn." files: array[file]) -> string {
  let notes = for (let attachment in files) { next f"\n[attached file: ${json.stringify(value = attachment)}]" }
  string.join(parts = notes, separator = "")
}

@"The file's recorded content type, or \"\" when the handle is gone (freed, or never named a live blob).
A gone file cannot inline — its handle note still rides — so `gone` folds to the same \"not an image\"
signal as an unrecorded type, and never fails a whole step over one stale attachment."
agent anthropic_content_type(@"The file to read." attachment: file) -> string {
  // `files.content_type` throws `files.gone` for a stale handle (freed, or an id that never named a
  // live blob). Catch exactly that and recover with "" (not an image), so one stale attachment never
  // fails a whole step. The `files` module qualifier is nameable in type position — the `file`
  // builtin-type keyword no longer shadows it.
  use handler {
    request prelude.throw(error: files.gone) -> never { break "" }
  }
  files.content_type(value = attachment)
}

@"Whether a file inlines as an Anthropic image block: its recorded content type begins \"image/\" (the
Messages API image block takes only image media types). A file with another or no recorded type stays
a handle note."
agent anthropic_is_image(@"The file to test." attachment: file) -> boolean {
  string.starts_with(value = anthropic_content_type(attachment = attachment), search = "image/")
}

@"A text content block — `{ \"type\": \"text\", \"text\": @text@ }`, built as a raw value tree."
agent anthropic_text_block(@"The block's text." text: string) -> unknown {
  { "type" = "text", text = text }
}

@"An image content block: a base64 `source` whose `media_type` is the file's recorded type and whose
`data` slot holds the file VALUE placed DIRECTLY into the tree. `http.json` materialises that slot —
reading the bytes and base64-ing them in place — only at the send boundary, so the image content never
rides the value plane, the durable call record or the trace."
agent anthropic_image_block(@"The image file to inline." attachment: file) -> unknown {
  {
    "type" = "image",
    source = {
      "type" = "base64",
      media_type = anthropic_content_type(attachment = attachment),
      "data" = attachment,
    },
  }
}

@"A turn's content: the plain string (text + every file's handle note) when the turn carries no image,
or an array of one text block plus one image block per image file when it does. An image file inlines
so the model can SEE it; a non-image file stays a handle note (the image block takes only images). The
text block still carries every file's handle note, so the model can replay any of them into a tool."
agent anthropic_turn_content(@"The turn's text." text: string, @"The turn's files." files: array[file]) -> unknown {
  let image_blocks = array.flatten(target = for (let attachment in files) {
    if (anthropic_is_image(attachment = attachment)) {
      next [anthropic_image_block(attachment = attachment)]
    } else {
      next []
    }
  })
  let note_text = f"${text}${anthropic_file_notes(files = files)}"
  if (array.length(target = image_blocks) == 0) {
    // No image to inline: the plain string content (text + handle notes), exactly as before.
    note_text
  } else {
    // Images present: a text block (text + every file's handle note) followed by the image blocks.
    array.concat(left = [anthropic_text_block(text = note_text)], right = image_blocks)
  }
}

agent anthropic_call_block(@"One tool call of the model's batch." call: types.tool_call, @"The step's wire-name map." map: ai.name_map) -> unknown {
  // Replay the model's tool_use verbatim: its block id + name + the original input. The name rides as
  // the WIRE name — the API validates the replayed history's tool_use name the same as the request's
  // tool declarations, so the qualified name would 400 here too (the opaque block id stays as-is). The
  // input is the model's args document dropped straight into the value tree, so its keys survive as-is.
  {
    "type" = "tool_use",
    id = call.opaque,
    name = ai.wire_name_of(map = map, real = call.name),
    input = call.args,
  }
}

agent anthropic_result_block(@"One tool's output, keyed back to its call." result: types.tool_result) -> unknown {
  {
    "type" = "tool_result",
    tool_use_id = result.call_id,
    content = result.text,
  }
}

agent anthropic_message(@"One history element." message: types.message, @"The step's wire-name map." map: ai.name_map) -> unknown {
  match (message) {
    case types.turn(role => role, text => text, files => files) -> {
      {
        role = anthropic_role(role = role),
        content = anthropic_turn_content(text = text, files = files),
      }
    }
    case types.call_turn(calls => calls) -> {
      {
        role = "assistant",
        content = for (let call in calls) { next anthropic_call_block(call = call, map = map) },
      }
    }
    case types.result_turn(results => results) -> {
      // The whole batch's results ride ONE user message: the API pairs every tool_use id of the
      // assistant turn against the tool_result blocks of the single next user message.
      {
        role = "user",
        content = for (let result in results) { next anthropic_result_block(result = result) },
      }
    }
  }
}

agent anthropic_tool(@"One tool's derived schema." meta: reflection.agent_metadata, @"The step's wire-name map." map: ai.name_map) -> unknown {
  // The tool is declared under its WIRE name (the qualified name 400s the Messages API); the loop maps
  // the model's pick back to the real name when it dispatches. `meta.input` is already a document value
  // (`$ref` / `$defs` / `$schema` keys and all), so it drops straight into the value tree verbatim.
  {
    name = ai.wire_name_of(map = map, real = meta.name),
    description = meta.description,
    input_schema = meta.input,
  }
}

agent anthropic_request_body(
  @"The provider connection." client: connection,
  @"The conversation so far." history: array[types.message],
  @"The tools' derived schemas." tool_metas: array[reflection.agent_metadata],
  @"The step's wire-name map." map: ai.name_map,
) -> unknown {
  let messages = for (let message in history) { next anthropic_message(message = message, map = map) }
  // Thinking stays OFF, explicitly: newer Claude models run adaptive thinking when the field is
  // omitted, and a thinking block must then be replayed VERBATIM (signature included) on the next
  // call turn — the agnostic vocabulary has no slot for one (Gemini's per-call thoughtSignature fits
  // tool_call.opaque; a standalone content block does not), and dropping it fails the follow-up
  // request.
  let thinking = { "type" = "disabled" }
  let base: record[unknown] = {
    model = client.model,
    max_tokens = client.max_tokens,
    messages = messages,
    thinking = thinking,
  }
  let with_system = if (client.system == "") {
    base
  } else {
    record.set(target = base, key = "system", value = client.system)
  }
  // The request body as a RAW value tree, built DIRECTLY: `post_json` serialises it, and `http.json`'s
  // slot contract base64s each `file` leaf — the image `data` slots placed directly above — in place at
  // the send boundary, so the bytes never land on the value plane. A tool schema's literal `$ref` /
  // `$defs` keys ride verbatim because `meta.input` is already a document value spliced in as-is.
  if (array.length(target = tool_metas) == 0) {
    with_system
  } else {
    let tools = for (let meta in tool_metas) { next anthropic_tool(meta = meta, map = map) }
    record.set(target = with_system, key = "tools", value = tools)
  }
}

// ── response parsing ─────────────────────────────────────────────────────────

agent anthropic_blocks(@"The parsed response document." parsed: unknown) -> array[unknown] {
  match (json.field(target = parsed, key = "content")) {
    case array(items) -> items
    case _ -> []
  }
}

agent anthropic_block_kind(@"One response content block." block: unknown) -> string {
  match (json.field(target = block, key = "type")) {
    case string(value) -> value
    case _ -> ""
  }
}

agent anthropic_tool_call(@"A `tool_use` response block." block: unknown, @"The step's wire-name map." map: ai.name_map) -> types.tool_call {
  types.tool_call(
    // Reverse the wire name back to the real qualified name: the loop dispatches by matching this
    // against tool metadata, so it must be the real name, not the shortened one the model saw.
    name = ai.real_name_of(map = map, wire = json.text(target = json.field(target = block, key = "name"))),
    opaque = json.text(target = json.field(target = block, key = "id")),
    args = json.field(target = block, key = "input"),
  )
}

agent anthropic_parse_step(@"The parsed response document." parsed: unknown, @"The step's wire-name map." map: ai.name_map) -> types.step {
  let blocks = anthropic_blocks(parsed = parsed)
  let calls = for (let block in blocks, var acc: array[types.tool_call] = []) {
    if (anthropic_block_kind(block = block) == "tool_use") {
      next with { acc = array.append(target = acc, value = anthropic_tool_call(block = block, map = map)) }
    } else {
      next with { acc = acc }
    }
  } then (_blocks) { acc }
  if (array.length(target = calls) == 0) {
    // The content array decides the step, not stop_reason: a "tool_use" stop always ships tool_use
    // blocks, and every other stop ("end_turn", or the degenerate "max_tokens" / "refusal" whose
    // text is partial or empty) reads out as the step's final text. Branching on stop_reason could
    // manufacture an EMPTY call batch, which the loop must never see. Only `text` blocks join the
    // reply — any other block kind carries no user-facing text.
    let texts = for (let block in blocks, var acc: array[string] = []) {
      if (anthropic_block_kind(block = block) == "text") {
        next with { acc = array.append(target = acc, value = json.text(target = json.field(target = block, key = "text"))) }
      } else {
        next with { acc = acc }
      }
    } then (_blocks) { acc }
    types.step_final(text = string.join(parts = texts, separator = ""))
  } else {
    types.step_call(calls = calls)
  }
}

@"The step's token accounting off the response's `usage`. The context a step read splits across
`input_tokens` and the cache counters (`cache_read_input_tokens` / `cache_creation_input_tokens`),
so the occupancy is their sum; an absent field reads as 0."
agent anthropic_usage(@"The parsed response document." parsed: unknown) -> types.usage {
  let counts = json.field(target = parsed, key = "usage")
  types.usage(
    input_tokens = ai.token_count(node = json.field(target = counts, key = "input_tokens"))
      + ai.token_count(node = json.field(target = counts, key = "cache_read_input_tokens"))
      + ai.token_count(node = json.field(target = counts, key = "cache_creation_input_tokens")),
    output_tokens = ai.token_count(node = json.field(target = counts, key = "output_tokens")),
  )
}

@"One Anthropic model step over the history + tool schemas (the body built as a value tree and the
reply parsed by `post_json` in Katari; only the POST leaves the runtime, and each image `file` in the
body base64s at that send boundary via the `http.json` slot contract)."
agent anthropic_infer_step(
  @"The provider connection." client: connection,
  @"The conversation so far." history: array[types.message],
  @"The tools' derived schemas." tool_metas: array[reflection.agent_metadata],
) -> types.step_result {
  // One wire-name map per step, rebuilt deterministically from the tools — so the request's tool names
  // and the response's reversal agree without any durable state (see ai's wire-tool-names section).
  let map = ai.build_name_map(tool_metas = tool_metas)
  let body = anthropic_request_body(client = client, history = history, tool_metas = tool_metas, map = map)
  // `post_json` serialises the value tree as application/json (each image `file` leaf read from the blob
  // store and base64'd only at the send boundary), checks the status (a non-2xx is `http.status_error`),
  // and parses the reply back to a document value.
  let response = http.post_json(
    url = "https://api.anthropic.com/v1/messages",
    body = body,
    headers = {
      "x-api-key" = client.api_key,
      "anthropic-version" = "2023-06-01",
    },
  )
  types.step_result(step = anthropic_parse_step(parsed = response, map = map), usage = anthropic_usage(parsed = response))
}

@"One Anthropic structured-output step, as a FORCED tool call: @schema@ rides as the input schema of
one synthetic tool and `tool_choice` pins the model to it, so the decoded object arrives already
parsed as the tool_use block's `input` — no special API surface, every Claude model. The name map is
empty — a replayed call turn in @history@ rides under its real name via the fallback, fine for the
rare structured step over a tool transcript. A reply with no tool_use block (a refusal) throws
`json.parse_error` (∈ `ai.step_error`)."
agent anthropic_infer_object(
  @"The provider connection." client: connection,
  @"The conversation so far." history: array[types.message],
  @"The JSON Schema the reply must conform to." schema: unknown,
) -> types.object_result {
  let map = ai.build_name_map(tool_metas = [])
  let messages = for (let message in history) { next anthropic_message(message = message, map = map) }
  let base: record[unknown] = {
    model = client.model,
    max_tokens = client.max_tokens,
    messages = messages,
    thinking = { "type" = "disabled" },
    tools = [{
      name = "record_result",
      description = "Record the final result in the required shape.",
      input_schema = schema,
    }],
    tool_choice = { "type" = "tool", name = "record_result" },
  }
  let body = if (client.system == "") {
    base
  } else {
    record.set(target = base, key = "system", value = client.system)
  }
  let response = http.post_json(
    url = "https://api.anthropic.com/v1/messages",
    body = body,
    headers = {
      "x-api-key" = client.api_key,
      "anthropic-version" = "2023-06-01",
    },
  )
  // The forced tool's input IS the decoded object — the same early-return scan as `dispatch_one`.
  for (let block in anthropic_blocks(parsed = response)) {
    if (anthropic_block_kind(block = block) == "tool_use") {
      return types.object_result(
        value = json.field(target = block, key = "input"),
        usage = anthropic_usage(parsed = response),
      )
    } else {
      null
    }
  }
  prelude.throw(error = json.parse_error(message = "anthropic: no tool_use block in the structured-output reply"))
}
