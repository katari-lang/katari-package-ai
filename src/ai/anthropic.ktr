// Anthropic provider: serves the `ai.infer_step` request over the Messages API. Where OpenAI ships
// tool arguments as a JSON string, Anthropic keeps them as parsed JSON inside `tool_use` content
// blocks, keyed by a block id (carried in tool_call.opaque / tool_result.call_id) that the next user
// turn echoes back as `tool_result` blocks — one message for the whole batch. A turn's files inline by
// CONTENT TYPE (`anthropic_file_blocks` dispatches over `ai.file_kind`): an image as an `image` block, a
// PDF as a `document` block, a textual file as text, and anything the API has no block for as a note that
// says so. The request body posts as an `http.json` value tree with `http.fetch`, so each inlined file's
// `data` slot base64s at the send boundary, never on the value plane.
// Same agnostic vocabulary, different shaping — and the same one-line integration:
// `use anthropic.provider(source = ...)`. Unlike the other two providers this one also has to ASK for
// prompt caching, by marking `cache_control` breakpoints on the request it builds — see the
// prompt-caching section below.

import ai
import ai.types

@"An Anthropic connection: the model id, the API key, an optional system prompt, and the
output-token cap the Messages API requires on every request. Provider handler state — built once per
`use anthropic.provider(...)`."
data connection(
  @"The Claude model id." model: string,
  @"Where the API key lives (env key or oauth name); resolved at each request, so a rotation lands mid-run." source: credentials.source,
  @"The system prompt; empty sends none." system: string,
  @"The required `max_tokens`: the output-token cap of one step." max_tokens: integer,
  @"How many times a transient step is attempted before its error propagates." retry_attempts: integer,
  @"The first backoff delay (ms), doubled per retry." retry_base_ms: number,
)

@"Serve `ai.infer_step` over Anthropic for the extent of the continuation:
`use anthropic.provider(source = credentials.env(key = \"ANTHROPIC_API_KEY\"))`.
A step's provider failure (`ai.step_error`) is handed back as an `ai.inference_failed` OUTCOME, never
thrown — but a TRANSIENT one (a 429 rate limit, a 5xx, a dropped connection) is first retried with
exponential backoff (up to @retry_attempts@ attempts from @retry_base_ms@); only a fatal error or an
exhausted budget surfaces, as a value the loop handles at its own perform site rather than a throw.
Prompt caching is ON and needs no argument: every step marks two `cache_control` breakpoints — one at
the end of the tools+@system@ prefix, one at the end of the conversation — so a tool loop re-reads
what it already sent at a tenth of the price. Caching is per-PROVIDER machinery (Gemini's is implicit,
OpenAI's automatic); Anthropic's is the one that must be asked for. See the prompt-caching section for
what silently undoes it."
agent provider[R, effect E](
  @"The Claude model id." model: string ?= "claude-sonnet-5",
  @"Where the API key lives (env key or oauth name); resolved at each request, so a rotation lands mid-run." source: credentials.source,
  @"An optional system prompt, sent as the top-level `system` field." system: string ?= "",
  @"The output-token cap of one step; the Messages API requires one on every request." max_tokens: integer ?= 4096,
  @"How many times a transient step (a 429 / 5xx / dropped connection) is attempted before its error becomes an `inference_failed` outcome." retry_attempts: integer ?= 6,
  @"The first backoff delay in milliseconds, doubled per retry (capped at one minute)." retry_base_ms: number ?= 2000.0,
  @"The computation to run with `ai.infer_step` / `ai.infer_object` served." continuation: agent (value: null) -> R with {...E, ai.infer_step, ai.infer_object},
) -> R with E | io | prelude.throw[env.missing_secret | oauth.server_error] {
  use handler (var client = connection(model = model, source = source, system = system, max_tokens = max_tokens, retry_attempts = retry_attempts, retry_base_ms = retry_base_ms)) {
    request ai.infer_step(history: array[types.message], tool_metas: array[reflection.agent_metadata]) {
      // Retry a transient step with exponential backoff; a fatal error (a non-retryable status, malformed
      // JSON) or an exhausted budget propagates. The attempt handler lives in its own agent so the loop
      // never nests a handler (only pure classification is inline here).
      next for (let attempt in array.range(start = 0, end = client.retry_attempts), var pending: null = null) {
        match (anthropic_step_attempt(client = client, history = history, tool_metas = tool_metas)) {
          case ai.attempt_ok(result => result) -> { break ai.inferred(result = result) }
          case ai.attempt_err(error => error) -> {
            if (!ai.is_transient(error = error) || attempt + 1 >= client.retry_attempts) {
              // The provider never THROWS a step failure: a fatal error or an exhausted retry budget resolves
              // the seam with `inference_failed`, so the failure reaches the loop's perform site as a value.
              break ai.inference_failed(error = error)
            } else {
              time.sleep(milliseconds = ai.backoff_ms(attempt = attempt, base_ms = client.retry_base_ms))
              next with { pending = null }
            }
          }
        }
      } then (_attempts) {
        ai.inference_failed(error = http.fetch_error(message = "anthropic step not attempted (retry_attempts must be >= 1)"))
      }
    }
    request ai.infer_object(history: array[types.message], schema: unknown) {
      next for (let attempt in array.range(start = 0, end = client.retry_attempts), var pending: null = null) {
        match (anthropic_object_attempt(client = client, history = history, schema = schema)) {
          case ai.attempt_ok(result => result) -> { break ai.inferred(result = result) }
          case ai.attempt_err(error => error) -> {
            if (!ai.is_transient(error = error) || attempt + 1 >= client.retry_attempts) {
              // The provider never THROWS a step failure: a fatal error or an exhausted retry budget resolves
              // the seam with `inference_failed`, so the failure reaches the loop's perform site as a value.
              break ai.inference_failed(error = error)
            } else {
              time.sleep(milliseconds = ai.backoff_ms(attempt = attempt, base_ms = client.retry_base_ms))
              next with { pending = null }
            }
          }
        }
      } then (_attempts) {
        ai.inference_failed(error = http.fetch_error(message = "anthropic object step not attempted (retry_attempts must be >= 1)"))
      }
    }
  }
  continuation(value = null)
}

@"ONE Anthropic step attempt, catching any `step_error` into an `ai.attempt` verdict so the provider's
retry loop can classify it — the catching handler lives here, at the agent top, so the loop never nests one."
agent anthropic_step_attempt(client: connection, history: array[types.message], tool_metas: array[reflection.agent_metadata]) -> ai.attempt[types.step_result] with io | prelude.throw[env.missing_secret | oauth.server_error] {
  use handler {
    request prelude.throw(error: ai.step_error | env.missing_secret | oauth.server_error) -> never {
      // A STEP failure folds into the verdict for the retry loop; a credential-resolution failure is
      // not a step the provider can retry (a missing secret, a dead oauth credential) — the residual
      // rethrows it toward the root, where the app's supervisor decides.
      match (error) {
        case http.fetch_error(message => message) -> { break ai.attempt_err(error = http.fetch_error(message = message)) }
        case http.status_error(status => status, body => body) -> { break ai.attempt_err(error = http.status_error(status = status, body = body)) }
        case json.parse_error(message => message) -> { break ai.attempt_err(error = json.parse_error(message = message)) }
        case ai.empty_reply(finish_reason => reason) -> { break ai.attempt_err(error = ai.empty_reply(finish_reason = reason)) }
        case rest -> { prelude.throw(error = rest) }
      }
    }
  }
  ai.attempt_ok(result = anthropic_infer_step(client = client, history = history, tool_metas = tool_metas))
}

@"ONE Anthropic structured-output attempt, the `anthropic_step_attempt` twin for `infer_object`."
agent anthropic_object_attempt(client: connection, history: array[types.message], schema: unknown) -> ai.attempt[types.object_result] with io | prelude.throw[env.missing_secret | oauth.server_error] {
  use handler {
    request prelude.throw(error: ai.step_error | env.missing_secret | oauth.server_error) -> never {
      // A STEP failure folds into the verdict for the retry loop; a credential-resolution failure is
      // not a step the provider can retry (a missing secret, a dead oauth credential) — the residual
      // rethrows it toward the root, where the app's supervisor decides.
      match (error) {
        case http.fetch_error(message => message) -> { break ai.attempt_err(error = http.fetch_error(message = message)) }
        case http.status_error(status => status, body => body) -> { break ai.attempt_err(error = http.status_error(status = status, body = body)) }
        case json.parse_error(message => message) -> { break ai.attempt_err(error = json.parse_error(message = message)) }
        case ai.empty_reply(finish_reason => reason) -> { break ai.attempt_err(error = ai.empty_reply(finish_reason = reason)) }
        case rest -> { prelude.throw(error = rest) }
      }
    }
  }
  ai.attempt_ok(result = anthropic_infer_object(client = client, history = history, schema = schema))
}

// ── request body ─────────────────────────────────────────────────────────────

@"Map the vocabulary role onto the Messages API role: our \"model\" speaks as \"assistant\"."
agent anthropic_role(@"The `ai.types` turn role (\"user\" / \"model\")." role: string) -> string {
  match (role) {
    case "model" -> "assistant"
    case _ -> "user"
  }
}

@"A text content block — `{ \"type\": \"text\", \"text\": @text@ }`, built as a raw value tree."
agent anthropic_text_block(@"The block's text." text: string) -> unknown {
  { "type" = "text", text = text }
}

@"An image content block: a base64 `source` whose `media_type` is the file's recorded type and whose
`data` slot holds the file VALUE placed DIRECTLY into the tree. `http.json` materialises that slot —
reading the bytes and base64-ing them in place — only at the send boundary, so the image content never
rides the value plane, the durable call record or the trace."
agent anthropic_image_block(
  @"The image file to inline." attachment: file,
  @"Its recorded content type, which the API takes as the block's `media_type`." media_type: string,
) -> unknown {
  {
    "type" = "image",
    source = {
      "type" = "base64",
      media_type = media_type,
      "data" = attachment,
    },
  }
}

@"A PDF content block — the SAME mechanism one arm over: `{ \"type\": \"document\", \"source\": {
\"type\": \"base64\", \"media_type\": \"application/pdf\", \"data\": … } }`, with the file value in the
`data` slot so its bytes base64 at the send boundary exactly like an image's. The Messages API reads a
document's pages as text AND as images, which is why a PDF must take this block rather than degrade to a
note: the model genuinely reads it."
agent anthropic_document_block(
  @"The PDF file to inline." attachment: file,
  @"Its recorded content type — `application/pdf`, the only media type this block accepts." media_type: string,
) -> unknown {
  {
    "type" = "document",
    source = {
      "type" = "base64",
      media_type = media_type,
      "data" = attachment,
    },
  }
}

@"ONE attached file as the content blocks it becomes — the per-file dispatch over `ai.file_kind`, one arm
per shape the Messages API accepts. An image and a PDF inline as their own block, each preceded by its
handle note so the model keeps the replay affordance; a textual file inlines as text (nothing on this wire
carries it better); audio and video have no Messages API block at all, so they and every opaque type
become the note that states the content is unreadable rather than a bare handle the model would guess from."
agent anthropic_file_blocks(@"One file attached to a turn." attachment: file) -> array[unknown] {
  match (ai.classify_file(attachment = attachment)) {
    case ai.image_file(content_type => content_type) -> [
      anthropic_text_block(text = ai.file_handle_note(attachment = attachment)),
      anthropic_image_block(attachment = attachment, media_type = content_type),
    ]
    case ai.document_file(content_type => content_type) -> [
      anthropic_text_block(text = ai.file_handle_note(attachment = attachment)),
      anthropic_document_block(attachment = attachment, media_type = content_type),
    ]
    case ai.text_file(content_type => content_type) -> [
      anthropic_text_block(text = ai.file_text_note(attachment = attachment, content_type = content_type)),
    ]
    case ai.audio_file(content_type => content_type) -> [
      anthropic_text_block(text = ai.unreadable_file_note(attachment = attachment, content_type = content_type)),
    ]
    case ai.video_file(content_type => content_type) -> [
      anthropic_text_block(text = ai.unreadable_file_note(attachment = attachment, content_type = content_type)),
    ]
    case ai.opaque_file(content_type => content_type) -> [
      anthropic_text_block(text = ai.unreadable_file_note(attachment = attachment, content_type = content_type)),
    ]
  }
}

@"A turn's content: the plain string when the turn carries no file, and otherwise the turn's text block
followed by each file's blocks (`anthropic_file_blocks`). A file-less turn keeps the string shape both
because it says the same thing in fewer bytes and because those bytes are the prompt-cache prefix — a
turn whose rendering never changes keeps reading its cached span."
agent anthropic_turn_content(@"The turn's text." text: string, @"The turn's files." files: array[file]) -> unknown {
  let file_blocks = array.flatten(target = for (let attachment in files) {
    next anthropic_file_blocks(attachment = attachment)
  })
  if (array.length(target = file_blocks) == 0) {
    text
  } else {
    // An EMPTY text block is rejected by the API, and a turn that is only attachments (an image posted
    // with no caption) has empty text — so the text block rides only when there is text to put in it.
    // Each file's blocks carry their own note, so nothing is lost when the heading is absent.
    let heading: array[unknown] = if (text == "") { [] } else { [anthropic_text_block(text = text)] }
    array.concat(left = heading, right = file_blocks)
  }
}

// ── prompt caching ───────────────────────────────────────────────────────────
//
// Anthropic's cache is a PREFIX match over the rendered request, and the render order is
// tools -> system -> messages: a `cache_control` breakpoint on a content block caches everything up
// to and including that block, and a later request whose bytes agree that far reads the span at a
// tenth of the price instead of paying for it again. One byte earlier in the prefix changes and
// every breakpoint after it misses. TWO breakpoints carry the whole shape (the API allows four):
//
//   1. THE END OF THE PROMPT PREFIX — the system block, or the last tool when no system prompt was
//      set. Tools render FIRST, so marking the system block caches the tool declarations with it,
//      and that is where the mass is: a resident's thirty tools ship their derived schemas and their
//      docs on every one of a turn's steps, unchanged every time.
//   2. THE END OF THE CONVERSATION — the last content block of the last message. A turn's tool loop
//      re-sends a history that only GROWS, so each step reads the span the previous step wrote; it
//      also keeps consecutive requests within the API's 20-block lookback, which a long batch of
//      tool_use / tool_result blocks would otherwise outrun.
//
// It is ON with no way to turn it off because the break-even is TWO uses: a five-minute write costs
// 1.25x and a read 0.1x, so a prefix that is seen twice has already paid for itself (1.35x < 2x) and
// every further step of a tool loop is nearly free. A prefix under the model's minimum (1024 tokens
// on Sonnet, 4096 on Haiku) simply is not cached — no write, so no surcharge for marking it.
//
// Caching is per-PROVIDER machinery: Gemini and OpenAI cache implicitly / automatically off the same
// prefix and take no breakpoint at all, so this provider is the only one that marks anything.
//
// WHAT SILENTLY UNDOES (2): anything that changes at the FRONT of the messages every step.
// `ai.with_context` prepends its freshly computed note as the first message, so a note carrying a
// per-step clock reading gives every step a new message prefix and breakpoint (2) never reads (it
// still writes — the messages cost 1.25x rather than 1x). Keep an injected note byte-stable across
// the steps of a turn (quantize a clock reading rather than restating the millisecond). The
// tools+system half is unaffected either way.

@"@block@ carrying a cache breakpoint: the same content block with `cache_control` added, the
five-minute (default) TTL. A block that is not a record rides unchanged — the wire has no slot to
mark on it."
agent anthropic_cached_block(@"The content block to mark." block: unknown) -> unknown {
  match (block) {
    case record(fields) -> record.set(target = fields, key = "cache_control", value = { "type" = "ephemeral" })
    case other -> other
  }
}

@"@blocks@ with the breakpoint on its LAST element, and an empty array unchanged. The tail rides as a
ONE-ELEMENT SLICE so the rewrite is total by construction — there is no index that could be out of
bounds and no absent-element case to invent a value for."
agent anthropic_cached_last(@"The blocks whose end carries the breakpoint." blocks: array[unknown]) -> array[unknown] {
  let last_index = array.length(target = blocks) - 1
  let tail: array[unknown] = for (let block in array.slice(target = blocks, start = last_index, end = last_index + 1)) {
    next anthropic_cached_block(block = block)
  }
  array.concat(left = array.slice(target = blocks, start = 0, end = last_index), right = tail)
}

@"The `system` field as a BLOCK ARRAY carrying the prefix breakpoint. The Messages API takes a bare
string or a block array there, and only a block can be marked — so the system prompt ships as one
text block, and the tool declarations rendered before it cache along with it."
agent anthropic_system_blocks(@"The system prompt; never the empty one, which sends no field at all." system: string) -> unknown {
  [anthropic_cached_block(block = anthropic_text_block(text = system))]
}

@"A message's content with the breakpoint on its last block. A turn with no attachment carries its
content as a plain STRING, which has no block to mark: it becomes the one-element block array that says
exactly the same thing."
agent anthropic_cached_content(@"The message's content — a string or an array of blocks." content: unknown) -> unknown {
  match (content) {
    case array(blocks) -> anthropic_cached_last(blocks = blocks)
    case string(text) -> [anthropic_cached_block(block = anthropic_text_block(text = text))]
    case other -> other
  }
}

@"@messages@ with the conversation breakpoint on the last block of the LAST message, and an empty
array unchanged — the same one-element-slice rewrite as `anthropic_cached_last`, one level up."
agent anthropic_cached_messages(@"The rendered messages." messages: array[unknown]) -> array[unknown] {
  let last_index = array.length(target = messages) - 1
  let tail: array[unknown] = for (let message in array.slice(target = messages, start = last_index, end = last_index + 1)) {
    next record.set(
      target = json.entries(target = message),
      key = "content",
      value = anthropic_cached_content(content = json.field(target = message, key = "content")),
    )
  }
  array.concat(left = array.slice(target = messages, start = 0, end = last_index), right = tail)
}

agent anthropic_call_block(@"One tool call of the model's batch." call: types.tool_call, @"The step's wire-name map." map: ai.name_map) -> unknown {
  // Replay the model's tool_use verbatim: its block id + name + the original input. The name rides as
  // the WIRE name — the API validates the replayed history's tool_use name the same as the request's
  // tool declarations, so the qualified name would 400 here too (the opaque block id stays as-is). The
  // input is the model's args document dropped straight into the value tree, so its keys survive as-is.
  {
    "type" = "tool_use",
    id = call.opaque,
    name = ai.wire_name_of(map = map, real = call.name),
    input = call.args,
  }
}

agent anthropic_result_block(@"One tool's output, keyed back to its call." result: types.tool_result) -> unknown {
  {
    "type" = "tool_result",
    tool_use_id = result.call_id,
    content = result.text,
  }
}

agent anthropic_message(@"One history element." message: types.message, @"The step's wire-name map." map: ai.name_map) -> unknown {
  match (message) {
    case types.turn(role => role, text => text, files => files) -> {
      {
        role = anthropic_role(role = role),
        content = anthropic_turn_content(text = text, files = files),
      }
    }
    case types.call_turn(calls => calls) -> {
      {
        role = "assistant",
        content = for (let call in calls) { next anthropic_call_block(call = call, map = map) },
      }
    }
    case types.result_turn(results => results) -> {
      // The whole batch's results ride ONE user message: the API pairs every tool_use id of the
      // assistant turn against the tool_result blocks of the single next user message.
      {
        role = "user",
        content = for (let result in results) { next anthropic_result_block(result = result) },
      }
    }
  }
}

agent anthropic_tool(@"One tool's derived schema." meta: reflection.agent_metadata, @"The step's wire-name map." map: ai.name_map) -> unknown {
  // The tool is declared under its WIRE name (the qualified name 400s the Messages API); the loop maps
  // the model's pick back to the real name when it dispatches. `meta.input` is already a document value
  // (`$ref` / `$defs` / `$schema` keys and all), so it drops straight into the value tree verbatim.
  {
    name = ai.wire_name_of(map = map, real = meta.name),
    description = meta.description,
    input_schema = meta.input,
  }
}

agent anthropic_request_body(
  @"The provider connection." client: connection,
  @"The conversation so far." history: array[types.message],
  @"The tools' derived schemas." tool_metas: array[reflection.agent_metadata],
  @"The step's wire-name map." map: ai.name_map,
) -> unknown {
  let rendered = for (let message in history) { next anthropic_message(message = message, map = map) }
  // The conversation breakpoint: the last block of the last message, so the NEXT step of this turn
  // reads the history this one sent instead of paying for it again (see the prompt-caching section).
  let messages = anthropic_cached_messages(messages = rendered)
  // Thinking stays OFF, explicitly: newer Claude models run adaptive thinking when the field is
  // omitted, and a thinking block must then be replayed VERBATIM (signature included) on the next
  // call turn — the agnostic vocabulary has no slot for one (Gemini's per-call thoughtSignature fits
  // tool_call.opaque; a standalone content block does not), and dropping it fails the follow-up
  // request.
  let thinking = { "type" = "disabled" }
  let base: record[unknown] = {
    model = client.model,
    max_tokens = client.max_tokens,
    messages = messages,
    thinking = thinking,
  }
  // The prompt prefix ENDS at the system block when there is a system prompt, and at the tools when
  // there is not — so exactly one of the two carries the prefix breakpoint (below).
  let prefix_on_tools = client.system == ""
  let with_system = if (prefix_on_tools) {
    base
  } else {
    record.set(target = base, key = "system", value = anthropic_system_blocks(system = client.system))
  }
  // The newest user turn's opaque author tag becomes the abuse-attribution metadata — the field is
  // omitted entirely for an unattributed step (a monitor tick, a loop-synthesized close), keeping
  // the wire unchanged when no author flows.
  let with_metadata = match (ai.attribution(history = history)) {
    case null -> with_system
    case author -> record.set(target = with_system, key = "metadata", value = { user_id = author })
  }
  // The request body as a RAW value tree, built DIRECTLY: `post_json` serialises it, and `http.json`'s
  // slot contract base64s each `file` leaf — the image / document `data` slots placed directly above — in
  // place at the send boundary, so the bytes never land on the value plane. A tool schema's literal `$ref` /
  // `$defs` keys ride verbatim because `meta.input` is already a document value spliced in as-is.
  if (array.length(target = tool_metas) == 0) {
    with_metadata
  } else {
    let tools = for (let meta in tool_metas) { next anthropic_tool(meta = meta, map = map) }
    // With no system block to carry it, the prefix breakpoint rides the LAST TOOL: the declarations
    // are the bulk of a resident's prefix, and leaving them unmarked would cache nothing at all.
    let declared = if (prefix_on_tools) { anthropic_cached_last(blocks = tools) } else { tools }
    record.set(target = with_metadata, key = "tools", value = declared)
  }
}

@"The structured-output request body: @schema@ as the input schema of ONE synthetic tool with
`tool_choice` pinned to it (see `anthropic_infer_object`). It takes the same prefix breakpoint as a
step — the schema tool is usually the bulk of the prefix, and a repeated extraction re-sends it
verbatim — but NO conversation breakpoint: an object step states its own context and is not re-sent
with a growing history, so marking its messages would pay a cache write nothing ever reads."
agent anthropic_object_body(
  @"The provider connection." client: connection,
  @"The conversation so far." history: array[types.message],
  @"The JSON Schema the reply must conform to." schema: unknown,
) -> unknown {
  // The name map is empty — a replayed call turn in @history@ rides under its real name via the
  // fallback, fine for the rare structured step over a tool transcript.
  let map = ai.build_name_map(tool_metas = [])
  let messages = for (let message in history) { next anthropic_message(message = message, map = map) }
  let prefix_on_tools = client.system == ""
  let record_result = {
    name = "record_result",
    description = "Record the final result in the required shape.",
    input_schema = schema,
  }
  let base: record[unknown] = {
    model = client.model,
    max_tokens = client.max_tokens,
    messages = messages,
    thinking = { "type" = "disabled" },
    tools = if (prefix_on_tools) { [anthropic_cached_block(block = record_result)] } else { [record_result] },
    tool_choice = { "type" = "tool", name = "record_result" },
  }
  if (prefix_on_tools) {
    base
  } else {
    record.set(target = base, key = "system", value = anthropic_system_blocks(system = client.system))
  }
}

// ── response parsing ─────────────────────────────────────────────────────────

agent anthropic_blocks(@"The parsed response document." parsed: unknown) -> array[unknown] {
  match (json.field(target = parsed, key = "content")) {
    case array(items) -> items
    case _ -> []
  }
}

agent anthropic_block_kind(@"One response content block." block: unknown) -> string {
  match (json.field(target = block, key = "type")) {
    case string(value) -> value
    case _ -> ""
  }
}

agent anthropic_tool_call(@"A `tool_use` response block." block: unknown, @"The step's wire-name map." map: ai.name_map) -> types.tool_call {
  types.tool_call(
    // Reverse the wire name back to the real qualified name: the loop dispatches by matching this
    // against tool metadata, so it must be the real name, not the shortened one the model saw.
    name = ai.real_name_of(map = map, wire = json.text(target = json.field(target = block, key = "name"))),
    opaque = json.text(target = json.field(target = block, key = "id")),
    args = json.field(target = block, key = "input"),
  )
}

agent anthropic_parse_step(@"The parsed response document." parsed: unknown, @"The step's wire-name map." map: ai.name_map) -> types.step {
  let blocks = anthropic_blocks(parsed = parsed)
  let calls = for (let block in blocks, var acc: array[types.tool_call] = []) {
    if (anthropic_block_kind(block = block) == "tool_use") {
      next with { acc = array.append(target = acc, value = anthropic_tool_call(block = block, map = map)) }
    } else {
      next with { acc = acc }
    }
  } then (_blocks) { acc }
  if (array.length(target = calls) == 0) {
    // The content array decides the step, not stop_reason: a "tool_use" stop always ships tool_use
    // blocks, and every other stop ("end_turn", or the degenerate "max_tokens" / "refusal" whose
    // text is partial or empty) reads out as the step's final text. Branching on stop_reason could
    // manufacture an EMPTY call batch, which the loop must never see. Only `text` blocks join the
    // reply — any other block kind carries no user-facing text.
    let texts = for (let block in blocks, var acc: array[string] = []) {
      if (anthropic_block_kind(block = block) == "text") {
        next with { acc = array.append(target = acc, value = json.text(target = json.field(target = block, key = "text"))) }
      } else {
        next with { acc = acc }
      }
    } then (_blocks) { acc }
    types.step_final(text = string.join(parts = texts, separator = ""))
  } else {
    types.step_call(calls = calls)
  }
}

@"The step's token accounting off the response's `usage`. The context a step read splits across
`input_tokens` and the cache counters (`cache_read_input_tokens` / `cache_creation_input_tokens`),
so the occupancy is their sum; an absent field reads as 0. The split is a LIVE one — the provider
marks cache breakpoints (see the prompt-caching section), so a warm step reports most of its context
under `cache_read_input_tokens`, which is also how a run trace shows the cache is working."
agent anthropic_usage(@"The parsed response document." parsed: unknown) -> types.usage {
  let counts = json.field(target = parsed, key = "usage")
  types.usage(
    input_tokens = ai.token_count(node = json.field(target = counts, key = "input_tokens"))
      + ai.token_count(node = json.field(target = counts, key = "cache_read_input_tokens"))
      + ai.token_count(node = json.field(target = counts, key = "cache_creation_input_tokens")),
    output_tokens = ai.token_count(node = json.field(target = counts, key = "output_tokens")),
  )
}

@"One Anthropic model step over the history + tool schemas (the body built as a value tree and the
reply parsed by `post_json` in Katari; only the POST leaves the runtime, and each inlined `file` in the
body base64s at that send boundary via the `http.json` slot contract)."
agent anthropic_infer_step(
  @"The provider connection." client: connection,
  @"The conversation so far." history: array[types.message],
  @"The tools' derived schemas." tool_metas: array[reflection.agent_metadata],
) -> types.step_result {
  // One wire-name map per step, rebuilt deterministically from the tools — so the request's tool names
  // and the response's reversal agree without any durable state (see ai's wire-tool-names section).
  let map = ai.build_name_map(tool_metas = tool_metas)
  let body = anthropic_request_body(client = client, history = history, tool_metas = tool_metas, map = map)
  // `post_json` serialises the value tree as application/json (each inlined `file` leaf read from the blob
  // store and base64'd only at the send boundary), checks the status (a non-2xx is `http.status_error`),
  // and parses the reply back to a document value.
  let response = http.post_json(
    url = "https://api.anthropic.com/v1/messages",
    body = body,
    headers = {
      "x-api-key" = credentials.resolve(source = client.source),
      "anthropic-version" = "2023-06-01",
    },
  )
  types.step_result(step = anthropic_parse_step(parsed = response, map = map), usage = anthropic_usage(parsed = response))
}

@"One Anthropic structured-output step, as a FORCED tool call: @schema@ rides as the input schema of
one synthetic tool and `tool_choice` pins the model to it (the body is `anthropic_object_body`), so
the decoded object arrives already parsed as the tool_use block's `input` — no special API surface,
every Claude model. A reply with no tool_use block (a refusal) throws `json.parse_error`
(∈ `ai.step_error`)."
agent anthropic_infer_object(
  @"The provider connection." client: connection,
  @"The conversation so far." history: array[types.message],
  @"The JSON Schema the reply must conform to." schema: unknown,
) -> types.object_result {
  let response = http.post_json(
    url = "https://api.anthropic.com/v1/messages",
    body = anthropic_object_body(client = client, history = history, schema = schema),
    headers = {
      "x-api-key" = credentials.resolve(source = client.source),
      "anthropic-version" = "2023-06-01",
    },
  )
  // The forced tool's input IS the decoded object — the same early-return scan as `dispatch_one`.
  for (let block in anthropic_blocks(parsed = response)) {
    if (anthropic_block_kind(block = block) == "tool_use") {
      return types.object_result(
        value = json.field(target = block, key = "input"),
        usage = anthropic_usage(parsed = response),
      )
    } else {
      null
    }
  }
  prelude.throw(error = json.parse_error(message = "anthropic: no tool_use block in the structured-output reply"))
}
