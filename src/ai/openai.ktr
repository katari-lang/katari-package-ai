// OpenAI provider: serves the `ai.infer_step` request over the Chat Completions API. Where Gemini
// keys tool calls by name + a thought signature, OpenAI keys them by a tool-call `id` (which is what
// this provider puts in `types.call_ref`, the agnostic vocabulary's one opaque per-call token) and
// ships the arguments as a JSON *string*. Same agnostic
// vocabulary, different shaping — and the same one-line integration:
// `use openai.provider(model = ..., source = ...)`.
// Files: a message's content here is a plain STRING, so a TEXTUAL attachment inlines as text (capped) and
// every other kind rides a note that tells the model plainly it cannot read that content type — see the
// comment above `openai_messages_of` for why an image or a PDF cannot inline on this wire.

import ai
import ai.types
import ai.wire_names

@"An OpenAI connection: the model id, the API key, an optional system prompt, the optional output cap,
and the transient-retry budget (@retry_attempts@ / @retry_base_milliseconds@). Provider handler state —
built once per `use openai.provider(...)`."
data connection(
  @"The Chat Completions model id." model: string,
  @"Where the API key lives (env key or oauth name); resolved at each request." source: credentials.source,
  @"The system prompt, or `null` for none." system: string | null,
  @"`max_completion_tokens`, or `null` to send none." max_output_tokens: integer | null,
  @"How many times a transient step is attempted before its error propagates." retry_attempts: integer,
  @"The first backoff delay (ms), doubled per retry." retry_base_milliseconds: number,
)

@"Serve `ai.infer_step` over OpenAI for the extent of the continuation:
`use openai.provider(source = credentials.env(key = \"OPENAI_API_KEY\"))`.
A step's provider failure (`ai.step_error`) is handed back as an `ai.inference_failed` OUTCOME, never
thrown — but a TRANSIENT one (a 429 rate limit, a 5xx, a dropped connection) is first retried with
exponential backoff (up to @retry_attempts@ attempts from @retry_base_milliseconds@); only a fatal error
or an exhausted budget surfaces, as a value the loop handles at its own perform site rather than a throw.
Prompt caching is per-PROVIDER machinery and nothing here asks for it: OpenAI caches a repeated prefix
AUTOMATICALLY, off the bytes it already receives. (Anthropic is the one that needs explicit
`cache_control` breakpoints, which `anthropic.provider` places for you.)"
agent provider[R, effect E](
  @"The Chat Completions model id. Defaults to `gpt-4o-mini`: it is the general-purpose workhorse of the
series this module is written against, it is reachable by every key that can reach the endpoint at all,
and a DEFAULT is what runs when nobody chose — so the cheapest capable model is the honest one to put
there, exactly as `gemini.provider` defaults to a flash model. A program with an opinion passes it." model: string ?= "gpt-4o-mini",
  @"Where the API key lives (env key or oauth name); resolved at each request, so a rotation lands mid-run." source: credentials.source,
  @"An optional system prompt, sent as a leading `system` message; `null` (the default) sends none. \"\" is NOT the way to say none — it sends an empty system message." system: string | null ?= null,
  @"`max_completion_tokens` — the per-step output cap; `null` (the default) sends none and lets the model's own default stand." max_output_tokens: integer | null ?= null,
  @"How many times a transient step (a 429 / 5xx / dropped connection) is attempted before its error becomes an `inference_failed` outcome." retry_attempts: integer ?= 6,
  @"The first backoff delay in milliseconds, doubled per retry (capped at one minute)." retry_base_milliseconds: number ?= 2000.0,
  @"The computation to run with `ai.infer_step` / `ai.infer_object` served." continuation: agent (value: null) -> R with {...E, ai.infer_step, ai.infer_object},
) -> R with E | io | prelude.throw[env.missing_secret | oauth.server_error] {
  use handler (var client = connection(model = model, source = source, system = system, max_output_tokens = max_output_tokens, retry_attempts = retry_attempts, retry_base_milliseconds = retry_base_milliseconds)) {
    request ai.infer_step(history: array[types.message], tool_metas: array[reflection.agent_metadata]) {
      // The retry LOOP is `ai.with_retries` — one copy for every provider and both seams, so an
      // off-by-one is fixed once. What stays here is the one thing a provider owns: the attempt, wrapped
      // in a thunk because the loop takes an agent and these three arguments cannot ride a partial
      // application of one.
      let connected = client
      agent once(value: null) -> ai.attempt[types.step_result] with io | prelude.throw[env.missing_secret | oauth.server_error] {
        openai_step_attempt(client = connected, history = history, tool_metas = tool_metas)
      }
      next ai.with_retries[types.step_result](attempts = connected.retry_attempts, base_milliseconds = connected.retry_base_milliseconds, attempt = once)
    }
    request ai.infer_object(history: array[types.message], schema: unknown) {
      let connected = client
      agent once(value: null) -> ai.attempt[types.object_result] with io | prelude.throw[env.missing_secret | oauth.server_error] {
        openai_object_attempt(client = connected, history = history, schema = schema)
      }
      next ai.with_retries[types.object_result](attempts = connected.retry_attempts, base_milliseconds = connected.retry_base_milliseconds, attempt = once)
    }
  }
  continuation(value = null)
}

@"ONE OpenAI step attempt, catching any `step_error` into an `ai.attempt` verdict so the provider's retry
loop can classify it — the catching handler lives here, at the agent top, so the retry loop never nests one."
agent openai_step_attempt(client: connection, history: array[types.message], tool_metas: array[reflection.agent_metadata]) -> ai.attempt[types.step_result] with io | prelude.throw[env.missing_secret | oauth.server_error] {
  use handler {
    request prelude.throw(error: ai.step_error | env.missing_secret | oauth.server_error) -> never {
      // A STEP failure folds into the verdict for the retry loop; a credential-resolution failure is
      // not a step the provider can retry (a missing secret, a dead oauth credential) — the residual
      // rethrows it toward the root, where the app's supervisor decides. Each arm rebuilds its own value
      // because `match` does not narrow a union: the residual `rest` still has the whole row's type, so
      // there is no arm that could hand the caught error on without naming it.
      match (error) {
        case http.fetch_error(message => message) -> { break ai.attempt_err(error = http.fetch_error(message = message)) }
        case http.auth_error(status => status, context => context, message => message) -> { break ai.attempt_err(error = http.auth_error(status = status, context = context, message = message)) }
        case http.api_error(status => status, context => context, message => message) -> { break ai.attempt_err(error = http.api_error(status = status, context = context, message = message)) }
        case json.parse_error(message => message) -> { break ai.attempt_err(error = json.parse_error(message = message)) }
        case ai.provider_error(source => source, message => message, transient => transient, detail => detail) -> { break ai.attempt_err(error = ai.provider_error(source = source, message = message, transient = transient, detail = detail)) }
        case rest -> { prelude.throw(error = rest) }
      }
    }
  }
  ai.attempt_ok(result = openai_infer_step(client = client, history = history, tool_metas = tool_metas))
}

@"ONE OpenAI structured-output attempt, the `openai_step_attempt` twin for `infer_object`."
agent openai_object_attempt(client: connection, history: array[types.message], schema: unknown) -> ai.attempt[types.object_result] with io | prelude.throw[env.missing_secret | oauth.server_error] {
  use handler {
    request prelude.throw(error: ai.step_error | env.missing_secret | oauth.server_error) -> never {
      // A STEP failure folds into the verdict for the retry loop; a credential-resolution failure is
      // not a step the provider can retry (a missing secret, a dead oauth credential) — the residual
      // rethrows it toward the root, where the app's supervisor decides.
      match (error) {
        case http.fetch_error(message => message) -> { break ai.attempt_err(error = http.fetch_error(message = message)) }
        case http.auth_error(status => status, context => context, message => message) -> { break ai.attempt_err(error = http.auth_error(status = status, context = context, message = message)) }
        case http.api_error(status => status, context => context, message => message) -> { break ai.attempt_err(error = http.api_error(status = status, context = context, message = message)) }
        case json.parse_error(message => message) -> { break ai.attempt_err(error = json.parse_error(message = message)) }
        case ai.provider_error(source => source, message => message, transient => transient, detail => detail) -> { break ai.attempt_err(error = ai.provider_error(source = source, message = message, transient = transient, detail = detail)) }
        case rest -> { prelude.throw(error = rest) }
      }
    }
  }
  ai.attempt_ok(result = openai_infer_object(client = client, history = history, schema = schema))
}

// ── request body ─────────────────────────────────────────────────────────────

@"Map the agnostic role sum onto the Chat Completions message role: the model's side speaks as
\"assistant\" here."
agent openai_role(@"Who spoke the turn." role: types.role) -> string {
  match (role) {
    case types.model_role(_) -> "assistant"
    case types.user_role(_) -> "user"
  }
}

agent openai_call_entry(call: types.tool_call, map: wire_names.name_map) -> unknown {
  // The replayed call ships the WIRE name — the API validates a history tool_call name the same as the
  // request's tool declarations (the qualified name's dot is rejected); the opaque call id stays as-is.
  // OpenAI carries the arguments as a JSON *string*, so the model's args document is stringified back.
  {
    id = call.ref.token,
    "type" = "function",
    function = {
      name = wire_names.wire_name_of(map = map, real = call.name),
      arguments = json.stringify(value = call.args),
    },
  }
}

@"ONE attached file as the text it contributes to a message's content — the per-file dispatch over
`ai.file_kind`, over the two outcomes this wire can offer. A TEXTUAL file inlines its decoded text
(capped): the Chat Completions content is a plain string, so text needs no wire shape at all and this
provider reads a .md / .csv / .json as well as either other one does. Every other kind gets the note that
states the content is unreadable — see `openai_messages_of` for why the binary kinds cannot inline here.
The arms are spelled out rather than collapsed into a catch-all so that a NEW `file_kind` fails to compile
here and this provider has to decide about it, instead of silently degrading to a note."
agent openai_file_note(attachment: file) -> string {
  match (ai.classify_file(attachment = attachment)) {
    case ai.text_file(content_type => content_type) -> ai.file_text_note(attachment = attachment, content_type = content_type)
    case ai.image_file(content_type => content_type) -> ai.unreadable_file_note(attachment = attachment, content_type = content_type)
    case ai.document_file(content_type => content_type) -> ai.unreadable_file_note(attachment = attachment, content_type = content_type)
    case ai.audio_file(content_type => content_type) -> ai.unreadable_file_note(attachment = attachment, content_type = content_type)
    case ai.video_file(content_type => content_type) -> ai.unreadable_file_note(attachment = attachment, content_type = content_type)
    case ai.opaque_file(content_type => content_type) -> ai.unreadable_file_note(attachment = attachment, content_type = content_type)
  }
}

@"A turn's files as the text they contribute, each on its own line."
agent openai_file_notes(files: array[file]) -> string {
  let notes = for (let attachment in files) { next f"\n${openai_file_note(attachment = attachment)}" }
  string.join(parts = notes, separator = "")
}

// WHY a binary attachment cannot inline on this provider, when the API itself would take it: Chat
// Completions carries an image as `image_url.url` and a PDF as `file.file_data`, and both are DATA URIs —
// a string with the base64 INSIDE it. `http.json`'s slot contract replaces a whole slot with a file's
// base64; it cannot build `"data:application/pdf;base64," ++ <the bytes>`. Producing that string means
// `files.read_base64` onto the value plane, which is exactly what this codebase moved the AI providers
// away from (docs/2026-07-18-http-file-body.md). So the binary kinds report honestly here instead, and the
// wire shape stays a plain string. Text is different in kind, not degree: its content IS a string, so it
// inlines with no data URI and no slot at all.
agent openai_messages_of(message: types.message, map: wire_names.name_map) -> array[unknown] {
  match (message) {
    case types.turn(role => role, text => text, files => files) -> {
      [{
        role = openai_role(role = role),
        content = f"${text}${openai_file_notes(files = files)}",
      }]
    }
    case types.call_turn(calls => calls) -> {
      [{
        role = "assistant",
        tool_calls = for (let call in calls) { next openai_call_entry(call = call, map = map) },
      }]
    }
    case types.result_turn(results => results) -> {
      for (let result in results) {
        next {
          role = "tool",
          // A tool message's content is a STRING (its array form admits `text` parts only — no image, no
          // file), so a file a tool handed back reaches the model here exactly as one attached to a turn
          // does: its text when it is textual, the honest note when it is not. That is the whole shape this
          // API licenses in this position, which is why nothing binary rides along.
          tool_call_id = result.ref.token,
          content = f"${result.text}${openai_file_notes(files = result.files)}",
        }
      }
    }
  }
}

agent openai_messages(client: connection, history: array[types.message], map: wire_names.name_map) -> array[unknown] {
  let base = for (let message in history, var accumulator: array[unknown] = []) {
    next with { accumulator = array.concat(left = accumulator, right = openai_messages_of(message = message, map = map)) }
  } then (_messages) { accumulator }
  // `null` is the absence, and the only absence: an empty string is a system message that says nothing,
  // which is a thing a caller may legitimately want to send and no longer a way to opt out.
  match (client.system) {
    case null -> base
    case standing -> array.concat(left = [{ role = "system", content = standing }], right = base)
  }
}

agent openai_function_tool(meta: reflection.agent_metadata, map: wire_names.name_map) -> unknown {
  // The tool is declared under its WIRE name (the qualified name's dot is rejected); the loop maps the
  // model's pick back to the real name when it dispatches. `meta.input` is already a document value, so
  // its JSON-Schema keys drop straight into the tree.
  {
    "type" = "function",
    function = {
      name = wire_names.wire_name_of(map = map, real = meta.name),
      description = meta.description,
      parameters = meta.input,
    },
  }
}

// The request body as a raw value tree — `post_json` serialises it (there are no `file` leaves here;
// OpenAI stays handle-only).
agent openai_request_body(client: connection, history: array[types.message], tool_metas: array[reflection.agent_metadata], map: wire_names.name_map) -> unknown {
  let messages = openai_messages(client = client, history = history, map = map)
  let base: record[unknown] = {
    model = client.model,
    messages = messages,
  }
  // The newest user turn's opaque author tag rides `safety_identifier` (the successor of the
  // deprecated `user` field) for abuse attribution; the field is omitted when no author flows.
  let with_attribution = match (ai.attribution(history = history)) {
    case null -> base
    case author -> record.set(target = base, key = "safety_identifier", value = author)
  }
  // `max_completion_tokens`, not the deprecated `max_tokens`: it is the field Chat Completions
  // documents for the output cap now, and the one every current model accepts. A `null` knob sends
  // nothing, so the wire is unchanged by default.
  let with_cap = record.set_if[unknown](target = with_attribution, key = "max_completion_tokens", value = client.max_output_tokens)
  if (array.length(target = tool_metas) == 0) {
    with_cap
  } else {
    let tools = for (let meta in tool_metas) { next openai_function_tool(meta = meta, map = map) }
    record.set(target = with_cap, key = "tools", value = tools)
  }
}

// ── response parsing ─────────────────────────────────────────────────────────

agent openai_message(parsed: unknown) -> unknown {
  json.field(target = json.element(target = json.field(target = parsed, key = "choices"), index = 0), key = "message")
}

agent openai_tool_call_of(tool_call: unknown, map: wire_names.name_map) -> types.tool_call with prelude.throw[json.parse_error] {
  let function = json.field(target = tool_call, key = "function")
  types.tool_call(
    // Reverse the wire name back to the real qualified name: the loop dispatches by matching this
    // against tool metadata, so it must be the real name, not the shortened one the model saw.
    name = wire_names.real_name_of(map = map, wire = json.text(target = json.field(target = function, key = "name"))),
    ref = types.call_ref(token = json.text(target = json.field(target = tool_call, key = "id"))),
    // OpenAI ships the arguments as a JSON *string*; parse it back to the plain args document.
    args = json.parse(text = json.text(target = json.field(target = function, key = "arguments"))),
  )
}

agent openai_parse_step(response: unknown, map: wire_names.name_map) -> types.step with prelude.throw[json.parse_error] {
  let message = openai_message(parsed = response)
  match (json.field(target = message, key = "tool_calls")) {
    case array(tool_calls) -> {
      let calls = for (let tool_call in tool_calls) { next openai_tool_call_of(tool_call = tool_call, map = map) }
      if (array.length(target = calls) == 0) {
        types.step_final(text = json.text(target = json.field(target = message, key = "content")))
      } else {
        types.step_call(calls = calls)
      }
    }
    case _ -> types.step_final(text = json.text(target = json.field(target = message, key = "content")))
  }
}

@"The step's token accounting off the response's `usage`: prompt tokens are the whole context the
step read, completion tokens what the model generated (an absent field reads as 0)."
agent openai_usage(parsed: unknown) -> types.usage {
  let counts = json.field(target = parsed, key = "usage")
  types.usage(
    input_tokens = ai.token_count(node = json.field(target = counts, key = "prompt_tokens")),
    output_tokens = ai.token_count(node = json.field(target = counts, key = "completion_tokens")),
  )
}

@"One OpenAI model step over the history + tool schemas (the body built as a value tree and the reply
parsed by `post_json`, in Katari; only the POST leaves the runtime)."
agent openai_infer_step(client: connection, history: array[types.message], tool_metas: array[reflection.agent_metadata]) -> types.step_result {
  // One wire-name map per step, rebuilt deterministically from the tools — so the request's tool names
  // and the response's reversal agree without any durable state (see ai's wire-tool-names section).
  let map = wire_names.build_name_map(tool_metas = tool_metas)
  let body = openai_request_body(client = client, history = history, tool_metas = tool_metas, map = map)
  // `ai.post_step` is `post_json` with the non-2xx already classified into the shared vocabulary
  // (`http.auth_error` / `http.api_error`, both carrying the status), so no raw `status_error` reaches
  // `ai.step_error`.
  let response = ai.post_step(
    url = "https://api.openai.com/v1/chat/completions",
    body = body,
    headers = { "Authorization" = "Bearer " ++ credentials.resolve(source = client.source) },
    context = "openai.infer_step",
  )
  types.step_result(step = openai_parse_step(response = response, map = map), usage = openai_usage(parsed = response))
}

@"One OpenAI structured-output step: the tool-less message list plus `response_format` pinning the
reply to JSON conforming to @schema@. The name map is empty — a replayed call turn in @history@
rides under its real name via the fallback, fine for the rare structured step over a tool
transcript. The reply content parses back to the decoded object; a non-JSON reply throws
`json.parse_error` (∈ `ai.step_error`)."
agent openai_infer_object(client: connection, history: array[types.message], schema: unknown) -> types.object_result {
  let map = wire_names.build_name_map(tool_metas = [])
  let base: record[unknown] = {
    model = client.model,
    messages = openai_messages(client = client, history = history, map = map),
    response_format = {
      "type" = "json_schema",
      json_schema = { name = "result", schema = schema },
    },
  }
  let body = record.set_if[unknown](target = base, key = "max_completion_tokens", value = client.max_output_tokens)
  let response = ai.post_step(
    url = "https://api.openai.com/v1/chat/completions",
    body = body,
    headers = { "Authorization" = "Bearer " ++ credentials.resolve(source = client.source) },
    context = "openai.infer_object",
  )
  let text = json.text(target = json.field(target = openai_message(parsed = response), key = "content"))
  types.object_result(value = json.parse(text = text), usage = openai_usage(parsed = response))
}
