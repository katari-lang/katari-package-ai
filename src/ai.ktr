// The AI orchestration layer: a provider-agnostic tool-calling loop whose only seam to a concrete model
// API is one request, `infer_step`, served by a provider module at the app root. The vocabulary is the
// closed sums of `ai.types`; a failure only a provider can name rides `provider_error` rather than
// earning an arm here. Four layers, smallest first: the one-shot calls, `take_turn`, the resident
// (`serve_observations`), and the route (`route` / `spawn` / `mail` / `dismiss`).

import ai.types

@"One model step over the conversation + tool schemas — the provider seam. A provider serves this for
the extent of a continuation (`use <some provider>.provider(...)`). The reply is an outcome and never a
throw: `inferred(result)` carries the step and its token accounting, `inference_failed(error)` the
failure the provider gave up on — so each loop decides at its own perform site whether to absorb the
failure or re-raise it."
request infer_step(history: array[types.message], tool_metas: array[reflection.agent_metadata]) -> step_outcome

// The error surface of one model step: a rejected call classified into the shared vocabulary
// (`http.api_failure`, carrying the status an app dispatches on), a transport failure, a malformed
// reply, and `provider_error` for a failure only the provider can name. (Type synonyms take no docs.)
type step_error = json.parse_error | http.api_failure | http.fetch_error | provider_error

@"A step failure only the provider can name — the arm that lets a provider carry its own failure as a
value instead of earning an arm here. @source@ names the producer, @message@ is the one human-readable
line, @transient@ is the producer's own verdict on whether a retry could help (`is_transient` reads it),
and @detail@ is the producer's own typed datum."
data provider_error(
  @"Who produced this failure — the provider module or middleware that built it." source: string,
  @"One human-readable line." message: string,
  @"The producer's own verdict: could a retry help?" transient: boolean,
  @"The producer's own typed datum, for an app that wants to match on it." detail: unknown,
)

@"One model step's outcome success: the provider produced a step. Generic over the payload so
`infer_step` and `infer_object` share one sum shape."
data inferred[T](@"The step the provider produced." result: T)

@"One model step's outcome failure: the provider gave up — a transient error past its retry budget, or a
fatal status / malformed body. Carried as a value so a loop handles it at its own perform site."
data inference_failed(@"The step error the provider surfaced." error: step_error)

// The outcome of one `infer_step`: the produced step, or the provider's surfaced failure. (Type synonyms take no docs.)
type step_outcome = inferred[types.step_result] | inference_failed

// The outcome of one `infer_object`: the produced object, or the provider's surfaced failure. (Type synonyms take no docs.)
type object_outcome = inferred[types.object_result] | inference_failed

@"One structured-output step over the conversation — the seam's second request, served by the same
provider handler as `infer_step`. @schema@ is the JSON Schema the reply must conform to; the reply is
`inferred(result)` with the decoded object and usage, or `inference_failed(error)`. Prefer
`infer_structured[T]`, which reifies T's schema, validates the reply, and re-raises a failure."
request infer_object(history: array[types.message], schema: unknown) -> object_outcome

@"Infer a single reply with no tools (the common chat case). A provider failure re-raises here as
`prelude.throw[step_error]`, so a caller that wants to survive a failed step installs its own handler."
agent infer(history: array[types.message]) -> string {
  match (infer_step(history = history, tool_metas = [])) {
    case inferred(result => result) -> {
      match (result.step) {
        case types.step_final(text => text) -> text
        case types.step_call(calls => _) -> "(unexpected tool call without tools)"
      }
    }
    case inference_failed(error => error) -> prelude.throw(error = error)
  }
}

@"Infer a single reply as a typed value: `reflection.schema_of[T]` reifies T's schema, the ambient
provider decodes against it natively, and the decoded object validates as T (`json.validate` — a
nonconforming reply throws `json.validation_error`). Instantiate T explicitly; it appears only in the
result, so it is never inferable. An object type (`type shape = { ... }`) makes the friendliest
model-facing schema — a data type asks the model to produce its `$katari_constructor` wrapper too."
agent infer_structured[T](history: array[types.message]) -> T {
  match (infer_object(history = history, schema = reflection.schema_of[T]())) {
    case inferred(result => result) -> json.validate[T](value = result.value)
    case inference_failed(error => error) -> prelude.throw(error = error)
  }
}

// ── the provider kit: one retry loop, one classification ──────────────────────
//
// A provider's handler runs at its `use` site, above the loop, so a step failure surfaces there and the
// loop cannot catch it. `with_retries` is where the retry control flow and the catching live — once, for
// every provider and both seams — so an off-by-one or a forgotten arm has one place to be.

@"Whether a step error is transient — worth a backoff and a retry — as opposed to fatal. A transport
failure always is; an `http.api_error` is for 408, 429 and any 5xx, and fatal otherwise; an
`http.auth_error` never is, because re-sending the credential that failed is a retry ladder spent on a
certainty; a `json.parse_error` never is. A `provider_error` answers with the verdict its producer wrote
into it, rather than being guessed about here."
agent is_transient(error: step_error) -> boolean {
  match (error) {
    case http.fetch_error(message => _) -> true
    case http.auth_error(status => _, context => _, message => _) -> false
    case http.api_error(status => status, context => _, message => _) -> status == 408 || status == 429 || status >= 500
    case json.parse_error(message => _) -> false
    case provider_error(source => _, message => _, transient => transient, detail => _) -> transient
  }
}

@"The backoff delay in milliseconds before retry @attempt@ (0-based): @base_milliseconds@ doubled per
attempt, capped at one minute so a long outage does not sleep unboundedly between the final tries."
agent backoff_milliseconds(attempt: integer, base_milliseconds: number) -> number {
  let grown = for (let _step in array.range(start = 0, end = attempt), var delay: number = base_milliseconds) {
    next with { delay = delay * 2.0 }
  } then (_steps) { delay }
  math.min(left = grown, right = 60000.0)
}

@"One bounded retry loop over one @attempt@ agent — the control flow and the catching every provider
shares. Run @attempt@ up to @attempts@ times with its `step_error` folded to a value by `prelude.catch`:
a completed attempt answers `inferred(result)`; a transient error sleeps `backoff_milliseconds` and tries
again while there is budget; a fatal one, or a transient one past the budget, answers
`inference_failed(error)` as a value, because that is what the seam promises its caller.

@attempt@ therefore throws rather than catching — it is a plain thunk around the provider's own call. A
credential failure is not a step failure and passes straight through to the app's supervisor
(`env.missing_secret`, `oauth.server_error`). @attempts@ below 1 is a configuration defect and answers as
one: a non-transient `provider_error` from this middleware naming the knob."
agent with_retries[T](
  @"How many attempts the budget allows; below 1 is a configuration defect (see above)." attempts: integer,
  @"The first backoff delay in milliseconds, doubled per retry." base_milliseconds: number,
  @"One attempt at the seam call — the provider's own POST and parse, throwing its failures rather than catching them." attempt: agent (value: null) -> T with io | prelude.throw[step_error | env.missing_secret | oauth.server_error],
) -> inferred[T] | inference_failed with io | prelude.throw[env.missing_secret | oauth.server_error] {
  // The attempt's result is wrapped before it is caught: `T` is a rigid type variable and a `match` does
  // not narrow a bare union, so an unwrapped success would have no arm that could name it.
  agent once(value: null) -> inferred[T] with io | prelude.throw[step_error | env.missing_secret | oauth.server_error] {
    inferred(result = attempt(value = null))
  }
  for (let index in array.range(start = 0, end = attempts), var pending: null = null) {
    // Each error arm rebuilds its value: a `match` does not narrow a union, so the bound name still
    // carries the whole row's type.
    let caught = match (prelude.catch(task = once)) {
      case inferred(result => result) -> { break inferred(result = result) }
      case http.fetch_error(message => message) -> http.fetch_error(message = message)
      case http.auth_error(status => status, context => context, message => message) -> http.auth_error(status = status, context = context, message = message)
      case http.api_error(status => status, context => context, message => message) -> http.api_error(status = status, context = context, message = message)
      case json.parse_error(message => message) -> json.parse_error(message = message)
      case provider_error(source => source, message => message, transient => transient, detail => detail) -> provider_error(source = source, message = message, transient = transient, detail = detail)
      case env.missing_secret(key => key, message => message) -> prelude.throw(error = env.missing_secret(key = key, message = message))
      case oauth.server_error(message => message) -> prelude.throw(error = oauth.server_error(message = message))
    }
    if (!is_transient(error = caught) || index + 1 >= attempts) {
      break inference_failed(error = caught)
    } else {
      time.sleep(milliseconds = backoff_milliseconds(attempt = index, base_milliseconds = base_milliseconds))
      next with { pending = null }
    }
  } then (_attempts) {
    // Only reachable when @attempts@ < 1 (the loop never ran). It is this middleware's own verdict, not
    // the wire's, so it rides `provider_error`.
    inference_failed(error = provider_error(
      source = "ai.with_retries",
      message = "the model was not called: the retry budget was empty (retry_attempts must be >= 1)",
      transient = false,
      detail = null,
    ))
  }
}

@"Two tools in one loop's tool list share a metadata name, so the model's pick could not be routed
unambiguously — dispatch matches by name, so the first match would silently win and the other tool would
be unreachable. A configuration defect the app fixes with a `prefix` on one of the colliding MCP
connections, or a rename; typed so a supervisor reports it instead of the run panicking."
data duplicate_tool(@"The name two tools share." name: string)

// A tool's derived name is a qualified Katari name and the loop dispatches by matching it, so the only
// property this layer needs is that one step's names are distinct. Whether a name is spellable on the
// wire belongs to the providers: whatever a provider sends, `tool_call.name` must come back as the real
// qualified name (`ai.wire_names` is how the narrow-alphabet providers keep that promise).

@"Validate one step's assembled tool metadata: every name unique, or the typed `duplicate_tool`. Every
loop runs its tool list through this once per turn, so a colliding list fails loudly at the first step."
agent ensure_unique_names(metas: array[reflection.agent_metadata]) -> array[reflection.agent_metadata] {
  for (let meta in metas, var seen: record[boolean] = {}) {
    if (record.has(target = seen, key = meta.name)) {
      prelude.throw(error = duplicate_tool(name = meta.name))
    } else {
      next with { seen = record.set(target = seen, key = meta.name, value = true) }
    }
  } then (_metas) { null }
  metas
}

// ── attached files: one dispatch over the recorded content type ───────────────
//
// `classify_file` turns a file's recorded content type into the closed `file_kind` sum, and each provider
// matches the sum with one arm per wire shape its own API accepts. The type is taken as recorded:
// nothing here reads a file's bytes to guess a better one, so a mislabeled file lands in `opaque_file`
// and the fix belongs at the upload boundary that recorded the type.

@"An image the model can look at (`image/*`). @content_type@ is the exact recorded type, because that is
what the wire's `media_type` / `mimeType` field must carry."
data image_file(@"The file's recorded content type." content_type: string)

@"A PDF (`application/pdf`): a document a model reads as pages — text, tables and figures alike — on a
provider whose API has a document shape for it."
data document_file(@"The file's recorded content type." content_type: string)

@"A file whose bytes are text: any `text/*`, plus `application/json`, `application/xml` and
`application/csv`. This arm needs no API support — the decoded text inlines as ordinary text (capped; see
`file_text_note`), so every provider serves it."
data text_file(@"The file's recorded content type." content_type: string)

@"Audio (`audio/*`): inlinable on a provider whose model takes audio input, a note to the model on one
that does not."
data audio_file(@"The file's recorded content type." content_type: string)

@"Video (`video/*`): inlinable on a provider whose model takes video input, a note to the model on one
that does not."
data video_file(@"The file's recorded content type." content_type: string)

@"A file no arm above covers — an archive, an office document, a font, an unrecorded or gone handle. No
provider can put its content in front of the model, so every provider reports it as unreadable instead of
shipping a bare handle the model would answer from."
data opaque_file(@"The file's recorded content type; \"\" when none was recorded." content_type: string)

// How ONE attached file can reach a model, off its recorded content type. (Type synonyms take no docs.)
type file_kind = image_file | document_file | text_file | audio_file | video_file | opaque_file

@"The file's recorded content type, or \"\" when the handle is gone (freed, or an id that never named a
live blob). A gone file folds to the same unreadable signal as an unrecorded type, so one stale
attachment never fails a whole step."
agent file_content_type(@"The file to read." attachment: file) -> string {
  use handler {
    request prelude.throw(error: files.gone) -> never { break "" }
  }
  files.content_type(value = attachment)
}

@"@content_type@ in the one form both a dispatch and a wire field can use: the media type alone,
lowercased, with any parameter dropped (\"Text/Plain; charset=utf-8\" becomes \"text/plain\") and a
confirmed alias resolved (`canonical_content_type`). An HTTP download records exactly the forms RFC 2045
permits, so the raw string is the wrong thing to compare and the wrong thing to ship."
agent normalized_content_type(@"The recorded content type." content_type: string) -> string {
  let without_parameters = match (string.index_of(value = content_type, search = ";")) {
    case null -> content_type
    case index -> string.slice(value = content_type, start = 0, end = index)
  }
  canonical_content_type(content_type = string.to_lower(value = string.trim(value = without_parameters)))
}

@"An alias resolved to the registered media type for the same format. A sender that derived its label
from a file extension writes `image/jpg` for a JPEG, and the accepted-type lists name only `image/jpeg`;
resolving the alias inlines the file and sends nothing off-list. Only labels confirmed to name the
identical format belong here — an unconfirmed guess turns a recoverable note into a 400, which is why
`image/pjpeg`, `audio/mpeg` (RFC 3003 leaves it ambiguous) and `application/x-pdf` are deliberately
absent."
agent canonical_content_type(@"The lowercased, parameter-free content type." content_type: string) -> string {
  match (content_type) {
    // IANA registers `image/jpeg` and no `image/jpg`, and `.jpg` is one of JPEG's own extensions.
    case "image/jpg" -> "image/jpeg"
    // IANA registers `video/quicktime` and no `video/mov`; `.mov` is the QuickTime container.
    case "video/mov" -> "video/quicktime"
    case recorded -> recorded
  }
}

@"The content type's family — the token before the \"/\", or the whole string when there is no slash. The
family is the dispatch key: every `image/*` reaches a model the same way."
agent content_type_family(@"The recorded content type." content_type: string) -> string {
  match (string.index_of(value = content_type, search = "/")) {
    case null -> content_type
    case index -> string.slice(value = content_type, start = 0, end = index)
  }
}

@"How @attachment@ can reach a model, from its recorded content type alone — the `file_kind` sum every
provider dispatches over. The `application/*` types that are not their own family are named exactly (a
PDF is a document; JSON / XML / CSV are text) and everything else falls to its family. The type the
verdict carries is the normalized one."
agent classify_file(@"The file to classify." attachment: file) -> file_kind {
  let content_type = normalized_content_type(content_type = file_content_type(attachment = attachment))
  match (content_type) {
    case "application/pdf" -> document_file(content_type = content_type)
    case "application/json" -> text_file(content_type = content_type)
    case "application/xml" -> text_file(content_type = content_type)
    case "application/csv" -> text_file(content_type = content_type)
    case _ -> classify_content_type_family(content_type = content_type)
  }
}

@"The family half of `classify_file`: `image/*`, `text/*`, `audio/*`, `video/*` — and `opaque_file` for
any other family, an unrecorded type included."
agent classify_content_type_family(@"The recorded content type." content_type: string) -> file_kind {
  match (content_type_family(content_type = content_type)) {
    case "image" -> image_file(content_type = content_type)
    case "text" -> text_file(content_type = content_type)
    case "audio" -> audio_file(content_type = content_type)
    case "video" -> video_file(content_type = content_type)
    case _ -> opaque_file(content_type = content_type)
  }
}

// The notes below name no other package's tool, on purpose: this package cannot know which tools the app
// handed the model, and a note promising one the holder lacks sends the model chasing a tool that is not
// there. `view_file` is the one tool this package owns, so it is the one a note may name.

@"A file as its `$katari_ref` handle note — the resting representation every provider shows for an
attachment. The handle is the exact object a model replays into a tool call, so the note is the
affordance: any tool the model holds that takes a file accepts this value."
agent file_handle_note(@"The file to note." attachment: file) -> string {
  f"[attached file: ${json.stringify(value = attachment)}]"
}

@"How a content type reads inside a note: the type itself, or the statement that none was recorded (a
bare \"\" tells a model nothing)."
agent content_type_label(@"The recorded content type." content_type: string) -> string {
  match (content_type) {
    case "" -> "no recorded content type"
    case recorded -> f"content type ${recorded}"
  }
}

@"The note for a file this model connection cannot show: the handle, the content type, and the plain
statement that the content is absent. Handed a bare handle with no explanation, a model answers from the
file's look and invents the rest, so the note tells it to report the gap instead."
agent unreadable_file_note(
  @"The file to note." attachment: file,
  @"Its recorded content type." content_type: string,
) -> string {
  f"[attached file: ${json.stringify(value = attachment)} — ${content_type_label(content_type = content_type)}. Its CONTENT is not available to you: this model connection cannot read that content type. Say so if you are asked about it; do not guess what it contains.]"
}

@"A textual file as text the model reads: a header naming the handle and the content type, then the
decoded content, cut at @max_characters@ code points with an explicit marker when it overflows — a model
that cannot tell it is holding a fragment answers confidently from the fragment. The 24000-code-point
default is ~6k tokens: an attachment cannot be re-read at another offset the way a page can be
re-fetched, and several must still fit one turn."
agent file_text_note(
  @"The file to inline." attachment: file,
  @"Its recorded content type." content_type: string,
  @"The truncation budget, in code points." max_characters: integer ?= 24000,
) -> string {
  let text = file_text(attachment = attachment)
  let length = string.length(value = text)
  let header = f"[attached file: ${json.stringify(value = attachment)} — ${content_type_label(content_type = content_type)}, ${length} characters. Its text follows.]"
  if (length > max_characters) {
    let head = string.slice(value = text, start = 0, end = max_characters)
    f"${header}\n${head}\n[… TRUNCATED: the first ${max_characters} of ${length} characters are shown; the rest was not sent. Treat this as a fragment, and say so rather than answering as if you had the whole file.]"
  } else {
    f"${header}\n${text}"
  }
}

@"A file's bytes decoded as UTF-8 text — the read behind `file_text_note`. It is a prim read, recomputed
on replay rather than recorded, so nothing durable grows by the file's size. A gone handle reads as \"\"."
agent file_text(@"The file to read." attachment: file) -> string {
  use handler {
    request prelude.throw(error: files.gone) -> never { break "" }
  }
  string.from_base64(value = files.read_base64(value = attachment))
}

// ── the inline window: how far back a file's CONTENT is re-sent ────────────────
//
// Only the newest @keep@ file-bearing history elements inline their content; older files show their
// handle note alone, and the model re-reads any of them with `view_file`. The window is keyed to files
// and not to position because every model API reuses a repeated request prefix only while it stays
// byte-identical: a positional window would slide on every step and no prefix reuse could survive it.

@"How many files a history element carries. The count is what makes an element file-bearing; a call turn
never carries one."
agent message_file_count(@"The history element to weigh." message: types.message) -> integer {
  match (message) {
    case types.turn(role => _, text => _, files => files, author => _) -> array.length(target = files)
    case types.call_turn(calls => _) -> 0
    case types.result_turn(results => results) -> {
      for (let result in results, var total: integer = 0) {
        next with { total = total + array.length(target = result.files) }
      } then (_results) { total }
    }
  }
}

@"The index of the oldest history element whose files still inline: the newest @keep@ file-bearing
elements keep their content, everything before this index shows handle notes only, and a history with no
file at all answers its own length. Providers render `slice(0, index)` with inlining off and the rest
with it on, so the whole policy is one integer."
agent inline_from_index(
  @"The conversation so far." history: array[types.message],
  @"How many of the newest file-bearing elements keep their content inline." keep: integer ?= 1,
) -> integer {
  let bearing = for (let message in history, var count: integer = 0) {
    if (message_file_count(message = message) == 0) {
      next with { count = count }
    } else {
      next with { count = count + 1 }
    }
  } then (_messages) { count }
  // One flag per element: an element inlines when it carries files and is among the newest @keep@ of the
  // file-bearing ones.
  let flags = for (let message in history, var seen: integer = 0) {
    if (message_file_count(message = message) == 0) {
      next false with { seen = seen }
    } else {
      next bearing - seen <= keep with { seen = seen + 1 }
    }
  } then (marks) { marks }
  // The first inlining element is the boundary; the elements after it that carry no file render the same
  // either way.
  match (array.index_of(target = flags, value = true)) {
    case null -> array.length(target = history)
    case index -> index
  }
}

@"Tool: read a file that is in this conversation — an image, a PDF, or a text document. Pass the file's
handle object; a bare {\"$katari_ref\": \"<id>\"} suffices (copy the id from the conversation). A text
document (`text/*`, JSON, XML, CSV) comes back as text, cut at a cap with an explicit truncation marker
when it is long; an image, a PDF, audio or video comes back as the file itself, which the model
connection places in your context if its API accepts that type — so if the content does not appear, say
you cannot see it rather than guessing. A content type nothing can read (an archive, an office document,
an unrecorded type) comes back as a note saying exactly that, and reporting it is then the correct
answer."
agent view_file(@"The file to read: its handle object, as it appears in the conversation." attachment: file) -> file | string {
  // The providers' own content-type dispatch, at the one point where an arm can answer with a value
  // instead of a wire block: text needs no API support and an unreadable type is unreadable everywhere,
  // so those two answer here and every other kind returns the file for the provider to inline.
  match (classify_file(attachment = attachment)) {
    case text_file(content_type => content_type) -> file_text_note(attachment = attachment, content_type = content_type)
    case opaque_file(content_type => content_type) -> unreadable_file_note(attachment = attachment, content_type = content_type)
    case _ -> attachment
  }
}

@"Run the tool-using model loop, generic over the tools' shared effect @E@: derive each tool's schema,
then step against the ambient provider up to @max_steps@ times, dispatching a batch of tool calls
concurrently (`parallel for`, each resolved by name and invoked by value via `reflection.call_agent`,
which validates the model's args against the tool's schema) and feeding every result back as a new turn.
A provider failure re-raises here, since a one-shot caller has no loop to absorb it into."
agent infer_with_tools[effect E lacks time.race_settled](
  history: array[types.message],
  tools: array[agent never -> unknown with {...E, prelude.throw[unknown]}],
  max_steps: integer,
  @"The per-tool-call budget in milliseconds, or `null` (the default) for no deadline — see `take_turn`." tool_budget_milliseconds: number | null ?= null,
  @"Tool names exempt from the deadline race (human-latency tools) — see `take_turn`." unbounded_tool_names: array[string] ?= [],
) -> string {
  match (take_turn[E](conversation = history, tools = tools, max_steps = max_steps, tool_budget_milliseconds = tool_budget_milliseconds, unbounded_tool_names = unbounded_tool_names)) {
    case session_turn(reply => reply_text, conversation => _, used_tokens => _, tool_events => _) -> reply_text
    case failed_turn(conversation => _, error => error, tool_events => _) -> prelude.throw(error = error)
  }
}

@"Who a step is on behalf of: the @author@ of the newest user turn in @history@, taken as-is with null
included. The newest user turn is the one that triggered the current model turn, so a system-triggered
turn (a monitor tick, whose injection carries `author = null`) shields the earlier human turns instead of
misattributing the step. A provider whose API has an end-user metadata field lifts a non-null result into
it; one that has no such field ignores it."
agent attribution(history: array[types.message]) -> string | null {
  for (let message in history, var newest: string | null = null) {
    match (message) {
      case types.turn(role => role, text => _, files => _, author => author) -> {
        // A later user turn always overwrites — a null author on the newest one deliberately erases an
        // earlier human's tag rather than letting the scan reach past the trigger.
        match (role) {
          case types.user_role(_) -> { next with { newest = author } }
          case types.model_role(_) -> { next with { newest = newest } }
        }
      }
      case _ -> { next with { newest = newest } }
    }
  } then (_messages) { newest }
}

@"The forced tool-less close every loop plays when its step budget runs out: a user turn telling the
model the budget is spent, so one last step commits to an answer from what the tools already gathered."
agent budget_exhausted_turn() -> types.message {
  types.turn(
    role = types.user_role(),
    text = "You have used your entire tool-call budget. Do not call any more tools. Answer the original question now, as best you can, using only what you have already gathered.",
    files = [],
  )
}

// ── tool events: what the loop swallowed, said out loud ───────────────────────
//
// `dispatch_one` folds every tool failure into a result the model reads and corrects from, which is right
// for the model and blind for the app — so each dispatch also yields one event and a turn carries the
// batch out. Nothing in the loop branches on an event: it is a report, and what to do with it is the
// app's.

@"One tool call went through: the tool ran and returned."
data tool_succeeded()

@"One tool call FAILED and the model was told so: the tool panicked, or threw its own typed error, or
the delegation boundary refused the model's arguments. @message@ is the same line the model reads."
data tool_failed(@"The failure, as the model was told it." message: string)

@"One tool call outran its deadline and was cancelled — the loop told the model, and this says so to the
app too, because a tool that always times out is an app-level fault."
data tool_timed_out(@"The budget it outran, in milliseconds." budget_milliseconds: number)

@"The model picked a name no tool in the list carries — a hallucinated tool, or one the app forgot to
hand out. The model is told; a run of these is worth an app's attention."
data tool_not_found()

// How ONE dispatched tool call ended. (Type synonyms take no docs.)
type tool_outcome = tool_succeeded | tool_failed | tool_timed_out | tool_not_found

@"ONE tool call of a turn, as the app can observe it: which tool the model picked and how the call
ended. The loop never branches on this — it is the report of what the loop already handled."
data tool_event(@"The tool name the model picked." name: string, @"How the call ended." outcome: tool_outcome)

@"One dispatched tool call: the result fed back to the model, and the event reported to the app. They
are returned together because they are two readings of ONE call and must not be able to disagree."
data dispatched(@"What the model is told." result: types.tool_result, @"What the app is told." event: tool_event)

@"Find the tool whose metadata name is the model's pick and invoke it by value via
`reflection.call_agent`, whose delegation boundary validates the model's args against the tool's schema
and turns any replayed `$katari_ref` into the `file` it denotes. Every way a call can go wrong — a
hallucinated name, a tool that panics, a tool's own typed throw, malformed args, and a call that outruns
@budget_milliseconds@ (raced via `time.with_deadline`, the late call cancelled) — is fed back to the
model as an error result it corrects from, and none of them reaches the app root; a thrown payload
carrying a string `message` field is shown as that line, anything else as the payload's JSON. Each also
yields a `tool_event`, and the result's `file` values are collected off the result tree so the provider
can show them to the model."
agent dispatch_one[effect E lacks time.race_settled](tools: array[agent never -> unknown with {...E, prelude.throw[unknown]}], call: types.tool_call, @"The per-call budget in milliseconds, or `null` for no deadline." budget_milliseconds: number | null, @"Metadata names exempt from the deadline race — human-latency tools; see `take_turn`." unbounded_tool_names: array[string] ?= []) -> dispatched {
  // A failing tool must never fail the conversation, and that holds for both ways a call can crash: the
  // two handlers below discharge a `panic` and the tools' explicit `prelude.throw[unknown]` alike, so `E`
  // escalates untouched while every tool failure returns to the model as feedback it can act on.
  // The failure shape, spelled once for both handlers and the two miss cases: the model reads @text@, the
  // app reads @outcome@.
  agent refused(text: string, outcome: tool_outcome) -> dispatched {
    dispatched(
      result = types.tool_result(name = call.name, ref = call.ref, text = text, files = []),
      event = tool_event(name = call.name, outcome = outcome),
    )
  }
  use handler {
    request panic(msg: string) {
      break refused(text = f"(tool failed: ${msg})", outcome = tool_failed(message = msg))
    }
  }
  use handler {
    request prelude.throw(error: unknown) -> never {
      // A tool that threw a payload with a `message` string wrote that line for a reader, so it is the
      // line the model reads; anything else falls back to the raw JSON. The two are one string, because
      // what the model is told and what the app is told must not be able to disagree.
      let stated = json.text(target = json.field(target = error, key = "message"))
      let rendered = if (stated == "") { json.stringify(value = error) } else { stated }
      break refused(text = f"(tool failed: ${rendered})", outcome = tool_failed(message = rendered))
    }
  }
  // The result a completed call folds to, shared by the bare and the deadlined path. `stringify` renders
  // the wire form (files show as `$katari_ref` handles) while the actual `file` values are collected off
  // the result tree for inlining.
  agent delivered(result: unknown) -> dispatched {
    dispatched(
      result = types.tool_result(
        name = call.name,
        ref = call.ref,
        text = json.stringify(value = result),
        files = collect_result_files(node = result),
      ),
      event = tool_event(name = call.name, outcome = tool_succeeded()),
    )
  }
  for (let tool in tools) {
    let meta = reflection.get_metadata(value = tool)
    if (meta.name == call.name) {
      // A `null` budget calls the tool bare; a number races it against the deadline, so no single tool can
      // hang the turn. A name in @unbounded_tool_names@ is exempted the same way: deadlines bound machine
      // latency, and a tool legitimately waiting on a human is visible in the admin surface while it
      // waits.
      let effective_budget = if (array.contains(target = unbounded_tool_names, value = call.name)) {
        null
      } else {
        budget_milliseconds
      }
      match (effective_budget) {
        case null -> {
          return delivered(result = reflection.call_agent(target = tool, args = call.args))
        }
        case limit -> {
          agent attempt(value: null) -> unknown with {...E, prelude.throw[unknown]} {
            reflection.call_agent(target = tool, args = call.args)
          }
          match (time.with_deadline(milliseconds = limit, task = attempt)) {
            case time.completed(value => result) -> { return delivered(result = result) }
            case time.deadline_passed() -> {
              return refused(
                text = f"(tool timed out after ${limit}ms; the call was cancelled)",
                outcome = tool_timed_out(budget_milliseconds = limit),
              )
            }
          }
        }
      }
    } else {
      null
    }
  }
  refused(text = f"(error: unknown tool \"${call.name}\")", outcome = tool_not_found())
}

@"Collect every `file` value out of a tool result's value tree — a bare return, the MCP bridge's
{ text, files } record, or nested structure alike."
agent collect_result_files(node: unknown) -> array[file] with pure {
  match (node) {
    case file(found) -> [found]
    case record(entries) -> {
      array.flatten(target = for (let [_key, value] in record.entries(target = entries)) {
        next collect_result_files(node = value)
      })
    }
    case array(items) -> {
      array.flatten(target = for (let item in items) {
        next collect_result_files(node = item)
      })
    }
    case _ -> []
  }
}

// ── context accounting and compaction ────────────────────────────────────────
//
// The seam reports each step's `usage`, so a served conversation meters its own context for free. The
// policy is data (`compaction`), the one numeric comparison is `classify_budget`, and everything
// downstream dispatches on its sum.

@"How a session compacts its context once it outgrows the threshold. @threshold_tokens@ compares against
the freshest step's measured occupancy (`usage.input_tokens + output_tokens`); @prompt@ frames the
summarization step; @keep_recent@ is how many trailing history elements survive verbatim — extended
forward to a clean `turn` boundary, so a call turn is never severed from the results that answer it."
data compaction(threshold_tokens: integer, prompt: string, keep_recent: integer)

@"The default compaction policy: compact past 100k tokens, summarize under the standard self-note
prompt, keep the last 8 history elements verbatim."
agent default_compaction() -> compaction {
  compaction(
    threshold_tokens = 100000,
    prompt = "Summarize the following conversation for your own future reference: keep every fact, decision, open question, and personal detail you might need again; drop the pleasantries and the dead ends. Answer with the summary only.",
    keep_recent = 8,
  )
}

@"The verdict on a measured context occupancy: still under the threshold, with the room left."
data within_budget(@"Tokens still free under the threshold." remaining: integer)

@"The verdict on a measured context occupancy: over the threshold — time to compact."
data over_budget(@"The measured occupancy that tripped the threshold." used: integer)

// The budget verdict. (Type synonyms take no docs.)
type budget = within_budget | over_budget

@"Classify a measured context occupancy against the policy threshold — the compaction machinery's
one numeric comparison; everything downstream dispatches on the returned sum."
agent classify_budget(used: integer, policy: compaction) -> budget {
  if (used < policy.threshold_tokens) {
    within_budget(remaining = policy.threshold_tokens - used)
  } else {
    over_budget(used = used)
  }
}

@"The integer at a provider's usage field, or 0 when the field is absent — a provider that omits a
count still yields a usable measurement. Providers read their wire usage through this."
agent token_count(node: unknown) -> integer {
  match (node) {
    case integer(value) -> value
    case _ -> 0
  }
}

@"The first index at or after @start@ whose element is a plain `turn` — the clean cut for `compact`: a
`call_turn` must never be severed from the `result_turn` that answers it, because a provider replays them
as a matched pair. No turn after @start@ means the whole history summarizes."
agent turn_boundary(history: array[types.message], start: integer) -> integer {
  for (let entry in array.slice(target = history, start = start, end = array.length(target = history)), var offset: integer = 0) {
    match (entry) {
      case types.turn(role => _, text => _, files => _) -> { break start + offset }
      case types.call_turn(calls => _) -> { next with { offset = offset + 1 } }
      case types.result_turn(results => _) -> { next with { offset = offset + 1 } }
    }
  } then (_entries) { array.length(target = history) }
}

@"A role as the word a summary reads: the label a summarizing model sees on a transcript line, chosen for
a reader rather than taken from any provider's vocabulary."
agent role_label(role: types.role) -> string {
  match (role) {
    case types.user_role(_) -> "user"
    case types.model_role(_) -> "model"
  }
}

@"A history element as summarizer-input text: turns as role-prefixed lines, tool traffic as compact
notes — enough for the summary to preserve what happened, nothing wire-shaped."
agent render_message(entry: types.message) -> string {
  match (entry) {
    case types.turn(role => role, text => text, files => files) -> {
      let notes = for (let attachment in files) { next f" [file ${json.stringify(value = attachment)}]" }
      let joined_notes = string.join(parts = notes, separator = "")
      f"${role_label(role = role)}: ${text}${joined_notes}"
    }
    case types.call_turn(calls => calls) -> {
      let names = for (let call in calls) { next call.name }
      let joined_names = string.join(parts = names, separator = ", ")
      f"model: (called ${joined_names})"
    }
    case types.result_turn(results => results) -> {
      let texts = for (let result in results) { next f"${result.name} -> ${result.text}" }
      let joined_texts = string.join(parts = texts, separator = "\n")
      f"tools: ${joined_texts}"
    }
  }
}

@"Compress a conversation to fit its budget again: everything before the kept tail (the last
@policy.keep_recent@ elements, extended to a clean turn boundary) is summarized by one tool-less model
step under @policy.prompt@, and the summary replaces it as a single opening turn. A history that is all
tail comes back unchanged. Exported on its own so a hand-rolled loop can compact too."
agent compact(history: array[types.message], policy: compaction) -> array[types.message] {
  let count = array.length(target = history)
  let wanted = if (count < policy.keep_recent) { 0 } else { count - policy.keep_recent }
  let cut = turn_boundary(history = history, start = wanted)
  if (cut == 0) {
    history
  } else {
    let head = array.slice(target = history, start = 0, end = cut)
    let tail = array.slice(target = history, start = cut, end = count)
    let rendered = for (let entry in head) { next render_message(entry = entry) }
    let joined = string.join(parts = rendered, separator = "\n")
    // A failed compaction must neither lose the conversation nor crash a long-lived loop: catch the
    // provider failure and skip compaction this time; the next over-budget turn tries again.
    use handler {
      request prelude.throw(error: step_error) -> never { break history }
    }
    let summary = infer(history = [types.turn(
      role = types.user_role(),
      text = f"${policy.prompt}\n\n${joined}",
      files = [],
    )])
    array.concat(
      left = [types.turn(role = types.user_role(), text = f"[Summary of the earlier conversation]\n${summary}", files = [])],
      right = tail,
    )
  }
}

@"One served turn's outcome: the reply, the advanced conversation, the freshest measurement, and every
tool call the turn made (`tool_events`, empty when it called none)."
data session_turn(reply: string, conversation: array[types.message], used_tokens: integer, tool_events: array[tool_event] ?= [])

@"A turn the provider failed mid-way: the conversation as far as it got, the step error, and the tool
calls that did run before it. Failure comes back as a value so a long-lived caller can absorb it as one
match arm instead of unwinding; a one-shot caller re-raises it (`infer_with_tools`)."
data failed_turn(conversation: array[types.message], error: step_error, tool_events: array[tool_event] ?= [])

type turn_result = session_turn | failed_turn

@"One tool-less step over @history@, folded to a `turn_result` — the closing move a turn plays when its
step budget runs out, and it hands a provider failure back as a value like every other step. @events@ are
the turn's tool calls so far, carried through the close."
agent closing_step(history: array[types.message], events: array[tool_event] ?= []) -> turn_result {
  match (infer_step(history = history, tool_metas = [])) {
    case inference_failed(error => error) -> failed_turn(conversation = history, error = error, tool_events = events)
    case inferred(result => result) -> {
      let answer = match (result.step) {
        case types.step_final(text => text) -> text
        case types.step_call(calls => _) -> "(unexpected tool call without tools)"
      }
      session_turn(
        reply = answer,
        conversation = array.append(target = history, value = types.turn(role = types.model_role(), text = answer, files = [])),
        used_tokens = result.usage.input_tokens + result.usage.output_tokens,
        tool_events = events,
      )
    }
  }
}

@"The turn loop — advance @conversation@ by one model turn and hand back a value either way: up to
@max_steps@ steps against the ambient provider, tool batches dispatched in parallel, the model's reply
appended as a model turn, and the last step's `input + output` carried out as the context measurement
(each step's input covers the whole context, so only the freshest figure is the occupancy). Budget spent,
one forced tool-less close commits to an answer; a provider failure at any step returns `failed_turn`
rather than unwinding, so an app-owned event loop absorbs it as one match arm. This is the package's one
loop — the one-shot calls and `serve_observations` are both compositions over it.

An empty final comes back empty, and nothing here second-guesses it: a caller that wants the model
prompted for a real answer says so in the conversation it passes."
agent take_turn[effect E lacks time.race_settled](
  conversation: array[types.message],
  tools: array[agent never -> unknown with {...E, prelude.throw[unknown]}],
  max_steps: integer,
  @"The per-tool-call budget in milliseconds — every call races it via `time.with_deadline`, and a timeout
comes back to the model as an error result. `null` (the default) sets no deadline." tool_budget_milliseconds: number | null ?= null,
  @"The metadata names of tools exempt from the deadline race — the human-latency ones: an approval-gated
adapter that blocks on an operator's click, an MCP call that may park on an OAuth authorization. A
deadline bounds machine latency, and a pending ask is visible in the admin surface while it waits.
Defaults to none — every tool stays under the budget." unbounded_tool_names: array[string] ?= [],
) -> turn_result {
  let tool_metas = ensure_unique_names(metas = for (let tool in tools) { next reflection.get_metadata(value = tool) })
  for (let _step in array.range(start = 0, end = max_steps), var state: session_turn = session_turn(reply = "", conversation = conversation, used_tokens = 0, tool_events = [])) {
    match (infer_step(history = state.conversation, tool_metas = tool_metas)) {
      case inference_failed(error => error) -> { break failed_turn(conversation = state.conversation, error = error, tool_events = state.tool_events) }
      case inferred(result => result) -> {
        let measured = result.usage.input_tokens + result.usage.output_tokens
        match (result.step) {
          case types.step_final(text => reply_text) -> {
            break session_turn(
              reply = reply_text,
              conversation = array.append(target = state.conversation, value = types.turn(role = types.model_role(), text = reply_text, files = [])),
              used_tokens = measured,
              tool_events = state.tool_events,
            )
          }
          case types.step_call(calls => calls) -> {
            let dispatches = parallel for (let call in calls) {
              next dispatch_one[E](tools = tools, call = call, budget_milliseconds = tool_budget_milliseconds, unbounded_tool_names = unbounded_tool_names)
            }
            let results = for (let one in dispatches) { next one.result }
            let events = for (let one in dispatches) { next one.event }
            let with_calls = array.append(target = state.conversation, value = types.call_turn(calls = calls))
            next with {
              state = session_turn(
                reply = "",
                conversation = array.append(target = with_calls, value = types.result_turn(results = results)),
                used_tokens = measured,
                tool_events = array.concat(left = state.tool_events, right = events),
              )
            }
          }
        }
      }
    }
  } then (_steps) {
    closing_step(history = array.append(target = state.conversation, value = budget_exhausted_turn()), events = state.tool_events)
  }
}

// ── the resident: one conversation, served for as long as the program runs ────
//
// A resident agent is a conversation nothing is waiting on: `serve_observations` injects each arriving
// `observation` as a user turn, advances the conversation with `take_turn`, and routes a non-empty reply
// to `deliver_to`. An empty reply means "nothing to say" — it is not delivered and nothing asks again.
// The bounded backlog, the dropped marker, the attachment shed and the one-notice-per-outage rule come
// with it; the breaker deliberately does not, because whether the provider answers is a fact about the
// provider and not about a conversation (see the README).

@"The event→model channel: a background fiber (an always-on source such as a chat watcher, a started
watch, or another agent's `mail`) pushes @content@ from @source@ into the model's context.
Fire-and-forget — a fiber only reports, and the serving handler injects the report as a user turn,
advances the conversation and routes the reply to its `deliver_to`. @files@ ride the injection turn's
`files` slot and @author@ its `author`, so the triggered turn's requests carry the right
abuse-attribution metadata.

@hop@ has no default: it is a fact about the message — how many agent-to-agent relays it has already
made — so it is carried rather than guessed. Write `hop = 0` for anything a person or a clock sent (a
chat message, a cron tick, a watch report, a startup line), 1 for a first-hop send, 2 for the reply to
one, and `inbound_provenance().hop + 1` in a tool that relays."
request observation(
  @"Which fiber is reporting (e.g. \"discord:<channel>\", \"mail:core\"); it labels the report's injection turn." source: string,
  @"The report to inject into the model's context." content: string,
  @"How many agent-to-agent hops this message has already made; 0 for anything a person or a clock sent. No default, on purpose — see above." hop: integer,
  @"Any files attached to the report (a Discord / Slack attachment), injected on the report's turn so the provider inlines them for the model; defaults to none." files: array[file] ?= [],
  @"The opaque end-user tag of the human behind this report (e.g. a hashed chat-user id), or `null` for a system report (a scheduled tick)." author: string | null ?= null,
) -> null

@"The provenance of the observation this conversation is serving right now: @origin@ is the observation's
`source` verbatim and @hop@ is its `hop`. Served by `serve_observations` for the extent of one dispatch —
a tool set is assembled once for the whole conversation, so a tool cannot close over the message it is
answering, and this is the frame that holds it. A tool reads both as values instead of parsing them back
out of the injected turn's prose. A program with no serving handler beneath it simply has no handler for
this, so the capability is visible in a tool's own effect row."
request inbound_provenance() -> { origin: string, hop: integer }

// Everything from here to `serve_observations` is that agent's machinery, exposed only because Katari has
// no module-private declaration. None of it is API, and a program that reaches for one of these is
// writing something `serve_observations` already does.

@"The arrivals a conversation is holding because the model was not answering: @messages@ is the bounded
tail and @dropped@ counts what fell off the front. It lives beside the conversation rather than in it,
which is what makes an outage cost the conversation nothing. Internal to `serve_observations`."
data backlog(@"The newest held arrivals, oldest first." messages: array[types.message], @"How many older ones the bound discarded." dropped: integer)

@"An empty backlog — nothing held. Internal to `serve_observations`."
agent empty_backlog() -> backlog {
  backlog(messages = [], dropped = 0)
}

@"How many arrivals the backlog holds before dropping the oldest. Twenty-four is not a knob: it is the
point past which a recovery turn's own context is the next failure. Internal to `serve_observations`."
agent backlog_retention() -> integer {
  24
}

@"One served conversation: the conversation as it stands, its freshest context measurement, and whatever
it is holding. It lives in a handler var, so it survives a runtime restart like any run state. Internal
to `serve_observations`."
data resident_state(
  @"The conversation as it stands." conversation: array[types.message],
  @"The freshest measured context occupancy — 0 until a step has run, and again right after a compaction." used_tokens: integer,
  @"What arrived while the model could not be called." held: backlog,
)

@"A fresh conversation: nothing said, nothing measured, nothing held. Standing instructions belong in the
provider's `system` parameter, which compaction never touches. Internal to `serve_observations`."
agent fresh_resident() -> resident_state {
  resident_state(conversation = [], used_tokens = 0, held = empty_backlog())
}

@"The line that stands where one message's attachments were, in the message itself — a model that knows a
file was shed can ask for a re-post, while one that does not will confidently describe an image it cannot
see. Internal to `serve_observations`."
agent shed_note(@"How many attachments this message loses." count: integer) -> string {
  f"[${string.to_string(value = count)} attachment(s) shed from this message: they rode a model call the provider refused, and a refused attachment would be refused again on every later call. If a file matters, ask for it to be posted again.]"
}

@"One tool result with its files shed and the loss noted in its text — the result-shaped half of
`shed_attachments`. Internal to `serve_observations`."
agent shed_result(@"The tool result to shed." result: types.tool_result) -> types.tool_result {
  match (array.length(target = result.files)) {
    case 0 -> result
    case count -> types.tool_result(name = result.name, ref = result.ref, text = f"${result.text}\n${shed_note(count = count)}", files = [])
  }
}

@"One message with its attachments shed and the loss noted in place; a message carrying none returns
untouched. All three message shapes are covered, because a user turn's files and a tool result's files
both inline into the request and either can be the file a provider refuses. Internal to
`serve_observations`."
agent shed_attachments(@"The message to shed." message: types.message) -> types.message {
  match (message) {
    case types.turn(role => role, text => text, files => files, author => author) -> {
      match (array.length(target = files)) {
        case 0 -> message
        case count -> types.turn(role = role, text = f"${text}\n${shed_note(count = count)}", files = [], author = author)
      }
    }
    case types.call_turn(calls => _) -> message
    case types.result_turn(results => results) -> types.result_turn(results = for (let result in results) {
      next shed_result(result = result)
    })
  }
}

@"One resident state with every attachment shed — the persistence form of `serve_observations`'s var. A
stored turn keeps no `file` (a file's bytes would be pinned in the project library forever, and a resume
wants the text either way), so what a re-run reads back is the conversation and the held arrivals as text.
Internal to `serve_observations`."
agent shed_state(state: resident_state) -> resident_state {
  resident_state(
    conversation = for (let message in state.conversation) {
      next shed_attachments(message = message)
    },
    used_tokens = state.used_tokens,
    held = backlog(
      messages = for (let message in state.held.messages) {
        next shed_attachments(message = message)
      },
      dropped = state.held.dropped,
    ),
  )
}

@"The shed decision, made once from the outage classification: a refused call's messages lose their
attachments, a passing failure's messages keep every one. `needs_operator` is exactly the family that
repeats deterministically, and an attachment is the one part of a request whose acceptability an app
cannot test before sending. The imprecision inside that family is accepted with open eyes, because a shed
attachment is a noted, re-askable loss while a poisoned conversation is one nothing revives. Internal to
`serve_observations`."
agent shed_refused(@"What the failure said about who can end it." kind: outage_kind, @"The messages that rode the failed call." messages: array[types.message]) -> array[types.message] {
  match (kind) {
    case needs_operator(remedy => _) -> for (let message in messages) {
      next shed_attachments(message = message)
    }
    case waits_out(_) -> messages
  }
}

@"File one arrival into the backlog, bounded: keep the newest @retention@ and count what fell off the
front. Written as arithmetic on the window rather than as a branch, so there is no is-it-full-yet case.
Internal to `serve_observations`."
agent hold_arrival(@"The backlog as it stands." held: backlog, @"The message to file." message: types.message, @"How many to keep." retention: integer) -> backlog {
  let grown = array.append(target = held.messages, value = message)
  let overflow = math.max(left = 0, right = array.length(target = grown) - retention)
  backlog(
    messages = array.slice(target = grown, start = overflow, end = array.length(target = grown)),
    dropped = held.dropped + overflow,
  )
}

@"The one line that stands in for what a backlog's bound discarded, or no line at all when it discarded
nothing. It is derived from the count on every attempt rather than appended to the stored conversation,
so an outage spanning ten failed probes still produces one line; the turn that answers bakes it in and
clears the count. Internal to `serve_observations`."
agent dropped_marker(@"How many arrivals the bound discarded." dropped: integer) -> array[types.message] {
  match (dropped) {
    case 0 -> []
    case _ -> [types.turn(role = types.user_role(), text = f"[${string.to_string(value = dropped)} earlier message(s) also arrived while the model was unreachable and were dropped, oldest first, to keep this context workable. They are gone — if something seems to be missing, ask rather than guess.]", files = [])]
  }
}

@"The conversation one turn actually runs on: the stored conversation, plus the derived dropped-marker
and whatever the backlog is holding. The backlog rejoins at the attempt and not at the filing, which is
what keeps a conversation that cannot be served frozen. Internal to `serve_observations`."
agent pending_conversation(@"The served conversation's state." state: resident_state) -> array[types.message] {
  if (array.length(target = state.held.messages) == 0 && state.held.dropped == 0) {
    state.conversation
  } else {
    array.concat(
      left = array.concat(left = state.conversation, right = dropped_marker(dropped = state.held.dropped)),
      right = state.held.messages,
    )
  }
}

@"The prefix on a message that was filed rather than answered, so a model coming back can see at a glance
which arrivals nobody replied to. Internal to `serve_observations`."
agent unanswered_note() -> string {
  "[filed while the model was unreachable — nobody answered this] "
}

@"The conversation a turn leaves behind, with one line appended when the turn ended with text that
nothing delivered — the case a resident with no @deliver_to@ is in on every turn it chose to speak. A
blank final gains nothing: ending silently is a legitimate move under this protocol. The line is the only
condition tested, because who the text was for is the model's judgement. Internal to
`serve_observations`."
agent mark_undelivered_reply(@"The conversation as the turn advanced it." conversation: array[types.message], @"The turn's final text." reply: string) -> array[types.message] {
  if (string.trim(value = reply) == "") {
    conversation
  } else {
    array.append(target = conversation, value = types.turn(role = types.user_role(), text = "[that turn's final text was not delivered: this agent has no reply channel, so a turn's closing words reach nobody. If it was meant for someone, say it with the tool that reaches them.]", files = []))
  }
}

@"One observation as the turn it becomes: who it is from, then the body. @note@ prefixes it when the
report is filed rather than answered; it is the empty string on the ordinary path. Internal to
`serve_observations`."
agent observation_turn(
  @"Which fiber reported." source: string,
  @"The report." content: string,
  @"The report's files." files: array[file],
  @"The report's author tag." author: string | null,
  @"The filed-unanswered prefix, or empty." note: string,
) -> types.message {
  types.turn(
    role = types.user_role(),
    text = f"${note}Message from ${source}:\n${content}",
    files = files,
    author = author,
  )
}

@"What one observation did: the model answered. @reply@ is the turn's final text — blank when the model
chose silence, and already delivered when it was not. @tool_events@ is every tool call the turn made,
which is where a program driving `advance_resident` by hand hears about a failing tool. Internal to
`serve_observations`."
data answered(
  @"The turn's final text; blank means the model had nothing to say." reply: string,
  @"Every tool call this turn made, in dispatch order; empty when it called none." tool_events: array[tool_event] ?= [],
)

@"What one observation did: the model was not called at all — a breaker is open — so the report went into
the backlog and no model call was spent. Internal to `serve_observations`."
data filed(@"How many arrivals are now held." held: integer, @"How many the bound has discarded in total." dropped: integer)

@"What one observation did: the model was called and the step failed. The report is in the backlog, the
stored conversation is untouched, and a refused call's attachments have been shed. @tool_events@ carries
the tool calls that did run before the failure. Internal to `serve_observations`."
data step_failed(
  @"The step error the provider surfaced." error: step_error,
  @"The tool calls that ran before the step failed; empty when none did." tool_events: array[tool_event] ?= [],
)

// What one observation did to a served conversation. (Type synonyms take no docs.)
type resident_outcome = answered | filed | step_failed

@"What `advance_resident` hands back: the state as it now stands and what happened. The two move together
— a filed report advances the backlog and not the conversation, an answered one the reverse — so they are
one value and the handler writes its var from @state@ without re-deciding anything. Internal to
`serve_observations`."
data resident_turn(@"The state after this observation — write it back." state: resident_state, @"What happened." outcome: resident_outcome)

@"Advance one served conversation by one observation — the whole of a resident's per-message behaviour.
The report injects as a user turn onto the stored conversation plus whatever the backlog holds, and one
`take_turn` runs. Answered: a non-blank reply goes to @deliver_to@, the backlog clears and an over-budget
conversation compacts. Refused by an open breaker, or failed: the report is filed into the bounded
backlog and the stored conversation stays frozen, so an outage costs it nothing — and a failure
additionally sheds the attachments of the call the provider refused, across the whole backlog. A failed
turn's partial tool work is discarded rather than preserved, so the recovery turn re-drives the model
with no record of it and a non-idempotent tool can run a second time for one report.

For the extent of the dispatch it serves `inbound_provenance` with this observation's `source` and
`hop`. Internal to `serve_observations`."
agent advance_resident[effect E lacks time.race_settled](
  @"The served conversation as it stands." state: resident_state,
  @"Which fiber reported." source: string,
  @"The report." content: string,
  @"How many agent-to-agent hops the report has made." hop: integer,
  @"The report's files." files: array[file],
  @"The report's author tag." author: string | null,
  @"This conversation's tool set. A tool may perform `inbound_provenance`; this agent serves it for the dispatch." tools: array[agent never -> unknown with {...E, inbound_provenance, prelude.throw[unknown]}],
  @"Where a non-blank reply goes, or `null` for an agent that speaks only through its tools." deliver_to: (agent (reply: string) -> null with E) | null,
  @"The per-observation step budget." max_steps: integer,
  @"The per-tool-call budget in milliseconds, or `null` for no deadline." tool_budget_milliseconds: number | null,
  @"Tool names exempt from the deadline race." unbounded_tool_names: array[string],
  @"When and how the conversation compacts." policy: compaction,
) -> resident_turn {
  let injected = array.append(
    target = pending_conversation(state = state),
    value = observation_turn(source = source, content = content, files = files, author = author, note = ""),
  )
  // The provenance for this dispatch, installed above the turn so a tool the model calls finds it, and
  // answering from the observation's own values rather than from the label the turn was rendered with.
  use handler {
    request inbound_provenance() {
      next { origin = source, hop = hop }
    }
  }
  match (take_turn[{...E, inbound_provenance}](
    conversation = injected,
    tools = tools,
    max_steps = max_steps,
    tool_budget_milliseconds = tool_budget_milliseconds,
    unbounded_tool_names = unbounded_tool_names,
  )) {
    case failed_turn(conversation => _, error => error, tool_events => events) -> {
      // A refusal and a failure differ in exactly two places — whether anything was sent (so whether an
      // attachment can have been refused) and what the app is told — which is why one arm serves both.
      let refusal = breaker_refusal(error = error)
      let kind = match (refusal) {
        case null -> classify_outage(error = error)
        case _ -> waits_out()
      }
      let grown = hold_arrival(
        held = state.held,
        message = observation_turn(source = source, content = content, files = files, author = author, note = unanswered_note()),
        retention = backlog_retention(),
      )
      let settled = backlog(messages = shed_refused(kind = kind, messages = grown.messages), dropped = grown.dropped)
      let outcome = match (refusal) {
        case null -> step_failed(error = error, tool_events = events)
        case _ -> filed(held = array.length(target = settled.messages), dropped = settled.dropped)
      }
      resident_turn(
        state = resident_state(conversation = state.conversation, used_tokens = state.used_tokens, held = settled),
        outcome = outcome,
      )
    }
    case session_turn(reply => final_text, conversation => advanced, used_tokens => used, tool_events => events) -> {
      // A blank final is the resident protocol's "nothing to say". With no channel at all a non-blank
      // final is a lost answer instead, so the conversation is told once — before the budget is
      // classified, so the note is part of what a compaction summarizes rather than outliving it.
      let noted = match (deliver_to) {
        case null -> mark_undelivered_reply(conversation = advanced, reply = final_text)
        case sink -> {
          if (string.trim(value = final_text) == "") { null } else { sink(reply = final_text) }
          advanced
        }
      }
      let carried = match (classify_budget(used = used, policy = policy)) {
        case within_budget(remaining => _) -> resident_state(conversation = noted, used_tokens = used, held = empty_backlog())
        case over_budget(used => _) -> resident_state(conversation = compact(history = noted, policy = policy), used_tokens = 0, held = empty_backlog())
      }
      resident_turn(state = carried, outcome = answered(reply = final_text, tool_events = events))
    }
  }
}

@"Serve a resident conversation for the extent of @continuation@ — the serving mechanism this package
offers. One conversation behind one handler var, each `observation` advancing it and a non-blank reply
leaving through @deliver_to@; every resident behaviour comes with it (see the resident section above).

The continuation forks the conversation's sources and typically never returns (a `region.watch`). Every
fiber runs under that watch, so the ambient provider and any @E@ handlers are installed by the caller
above this line, where they cover all of them.

`observation` is served by the innermost install in scope, so one install serves one conversation; do not
install it twice in one dynamic extent, where the inner install shadows the outer and the second agent
receives nothing. Several agents are several fibers: `ai.route` + `ai.spawn` is the product form, and
`resident` is one AI's whole body for a program assembling it by hand. The providers serve `infer_step`
from a parallel handler of their own, so one provider install covers every AI in the program and no two
of their model calls serialize against each other."
agent serve_observations[R, effect E lacks time.race_settled](
  @"The tools of every turn's loop. A tool may perform `inbound_provenance`; the dispatch beneath this
serves it with the observation's own `source` and `hop`." tools: array[agent never -> unknown with {...E, inbound_provenance, prelude.throw[unknown]}],
  @"The per-observation step budget." max_steps: integer,
  @"Where a turn's non-empty reply (and the two outage lines) is delivered. `null` (the default) is
an agent that speaks only through its tools — nothing is delivered anywhere, and a turn that ended
with undelivered text is told so in its own conversation." deliver_to: (agent (reply: string) -> null with E) | null ?= null,
  @"The compaction policy — one `compaction(...)` datum; `null` (the default) is `default_compaction`." policy: compaction | null ?= null,
  @"The per-tool-call budget in milliseconds, or `null` (the default) for no deadline — see `take_turn`." tool_budget_milliseconds: number | null ?= null,
  @"Tool names exempt from the deadline race (human-latency tools) — see `take_turn`." unbounded_tool_names: array[string] ?= [],
  @"The name this AI's conversation is persisted under, so a `supervise` re-run resumes the thread rather
than starting it over (a runtime restart keeps it either way). `null` (the default) keeps nothing across a
re-run. The route stores it in a cell of its own keyed by this name — nothing about the AI's own workspace
is involved — and `recall` / `remember` are the seam. Attachments are shed before the write, so what
resumes is the text." conversation_id: string | null ?= null,
  @"The resident body: forks its sources and typically never returns (`region.watch`)." continuation: agent (value: null) -> R with {...E, observation},
) -> R {
  let effective_policy = match (policy) {
    case null -> default_compaction()
    case given -> given
  }
  // The state read back at start — a fresh one when there is no id or none is stored yet. Both the
  // conversation and the held arrivals resume, so an outage that tripped the supervisor does not lose the
  // arrivals nobody had answered.
  let initial_state = match (conversation_id) {
    case null -> fresh_resident()
    case id -> recall_conversation(name = id)
  }
  // `announced` is the transition test: a notice fires when it flips, and not per turn.
  use handler (var state: resident_state = initial_state, var announced: boolean = false) {
    request observation(source: string, content: string, hop: integer, files: array[file], author: string | null) {
      let advanced = advance_resident[E](
        state = state,
        source = source,
        content = content,
        hop = hop,
        files = files,
        author = author,
        tools = tools,
        deliver_to = deliver_to,
        max_steps = max_steps,
        tool_budget_milliseconds = tool_budget_milliseconds,
        unbounded_tool_names = unbounded_tool_names,
        policy = effective_policy,
      )
      // The state is written back after every observation — a turn that advanced the conversation, and a
      // `filed` that only grew the backlog alike — so a re-run resumes from the last arrival served rather
      // than from empty. Attachments are shed first: a resume wants the text, not files pinned forever.
      let _remembered = match (conversation_id) {
        case null -> null
        case id -> remember_conversation(name = id, state = shed_state(state = advanced.state))
      }
      match (advanced.outcome) {
        case step_failed(error => error) -> {
          // The outage notice rides the same channel a reply does, so an agent with no channel has
          // nowhere to say it — the operator's copy is `with_breaker`'s `on_transition`.
          match (deliver_to) {
            case null -> null
            case sink -> {
              if (announced) {
                null
              } else {
                sink(reply = f"(the model is not answering — this turn was dropped and what arrives is kept: ${json.stringify(value = error)})")
              }
            }
          }
          next null with { state = advanced.state, announced = true }
        }
        case filed(held => _, dropped => _) -> {
          next null with { state = advanced.state, announced = announced }
        }
        case answered(reply => _) -> {
          // The wording is `recovery_line`'s: the breaker says the same sentence on the same event, and
          // two spellings of one line is one of them going stale.
          match (deliver_to) {
            case null -> null
            case sink -> {
              if (announced) {
                sink(reply = recovery_line())
              } else {
                null
              }
            }
          }
          next null with { state = advanced.state, announced = false }
        }
      }
    }
  }
  continuation(value = null)
}

// ── several AIs, the mechanism layer: mailboxes, the register handshake, one AI's body ─────
//
// A conversation is a handler var, so several AIs are several fibers rather than several installs: one
// `resident` apiece, each running its own `serve_observations` in its own dynamic extent. Most programs
// want the product layer below (`route` / `spawn` / `mail` / `dismiss`); this one stays public for a
// program that needs something wrapped around one AI, which forks its own resident and performs
// `register` from inside it to join the route's table. The delivery discipline — a resident's mailbox is
// a second nursery, one nursery one watch, provider and breaker outside the root watch, mail as a named
// agent over plain data, at-most-once delivery — is stated once in the README.

@"The shared scope marker of every `ai` mailbox, so that a resident's mailbox and a delivery site agree on
one type without either naming the other. A sender discharges it with one
`region.provide[ai.mail_scope, ai.observation]` — a nursery opened purely to hold the stamp, which is what
`route` calls its franking — and can then fork into any resident's mailbox handle. The merge is
type-level only: a fork routes by the handle's own runtime scope identity, minted freshly per install, so
no fiber can be delivered to the wrong nursery."
effect mail_scope

// A resident's own inbox: a nursery whose fibers may raise exactly `observation`, so the only thing that
// can be delivered into one is a report for its model. (Type synonyms take no docs.)
type mailbox = region.nursery[mail_scope, observation]

@"A resident announcing its mailbox — the handshake by which an AI becomes addressable: performed once by
`resident` from inside its own `provide`, and answered by `route`, which keeps the `record[mailbox]` every
`mail` looks up. It is a request rather than a return value because a resident never returns.

It is also the door into the route's table: a program that forks a resident of its own performs this from
inside that fiber, and the route files the handle beside the AIs it spawned. `mail(to = ...)` then finds
it and the sender cannot tell the two apart; only `dismiss` can, because the route can only cancel a
fiber it forked."
request register(@"The resident's name, as the route will address it." name: string, @"Its mailbox handle." box: mailbox) -> null

@"The delivery fiber: one report carried into a resident's mailbox. Fork it — never call it: forked into
the addressee's handle — `region.fork(nursery = box, task = ai.deliver, argument = { source = \"mail:core\",
content = text, hop = 1 })` — it runs in the addressee's nursery, performs one `observation`, and settles,
while a direct call compiles and performs the observation in the caller's own position instead;
`route`'s `mail` clause is this fork plus the table lookup.

It is a named agent taking plain data because a cross-nursery fork carries its task's captured
environment into the target's instance, and a named agent captures nothing. Its parameters are
`observation`'s exactly: @files@ and @author@ may be omitted, @hop@ may not. Delivery is at-most-once —
a fork into a nursery that has already died panics; fold the fork with `supervise.once` +
`supervise.signal_panics` where a lost message must be noticed, as `route`'s `mail` clause does."
agent deliver(
  @"Who is sending (e.g. \"mail:core\"); it labels the report's injection turn for the receiving model." source: string,
  @"The message body." content: string,
  @"How many agent-to-agent hops this message has made — 1 for a first-hop send, `inbound_provenance().hop + 1` in a relaying tool." hop: integer,
  @"Files riding the message." files: array[file] ?= [],
  @"The opaque end-user tag of the human behind it, or `null`." author: string | null ?= null,
) -> null with observation {
  observation(source = source, content = content, hop = hop, files = files, author = author)
}

@"One AI's whole body, as a task to fork — the mechanism under `spawn`. Most programs write
`ai.spawn(name = \"core\", tools = core_tools, max_steps = 16)` instead; reach for the fork itself when the
AI needs something wrapped around it that the route cannot pass through (a provider install of its own, a
facility only this AI may reach). It still joins the route's table, because `register` is what puts it
there.

It bundles: its own mailbox nursery, separate from the one it was forked into and announced with
`register(name, box)`; @persona@ recomputed at every model step through `with_context`; `serve_observations`
with every knob passed through; the mailbox's own `region.watch`; and, when @workspace@ is given, the
whole fiber inside one `store.workspace`.

It raises `infer_step` (to the ambient provider, installed outside the root watch), `register` (to the
route, once at startup), and the mailbox's `region.crashed` / `region.failed` (to the root watch, where a
mail fiber's death is reported under its fork name). Its tools', @persona@'s and @deliver_to@'s own
effects @E@ pass through untouched and must be covered by the root nursery's ceiling.

Instantiate `E` explicitly at the fork — `ai.resident[io | my_request]` — because a fork takes the task as
a value, not as a call, so nothing infers its type arguments there. @name@ is what mail addresses it as,
not the fiber's name tag; giving the fork the same string is worth the keystrokes when a `crashed` event
has to be matched to an AI."
agent resident[effect E lacks time.race_settled](
  @"This AI's name, as the route addresses it (`register`)." name: string,
  @"Its tool set — the whole of what this AI can do. A tool may perform `inbound_provenance`." tools: array[agent never -> unknown with {...E, inbound_provenance, prelude.throw[unknown]}],
  @"Where a turn's non-empty reply goes; `null` (the default) is an AI that speaks only through its TOOLS." deliver_to: (agent (reply: string) -> null with {...E, prelude.throw[unknown]}) | null ?= null,
  @"The per-observation step budget." max_steps: integer,
  @"This AI's note, recomputed at every model step and injected as a turn (`with_context`) — its
character, its standing rules, and whatever it should be told about the world right now. It is an agent
rather than a string so that a note depending on something (the hour, an index that just grew, a store
cell another AI writes) can perform whatever it needs. `null` (the default) injects nothing. It is not
the system prompt: the note lands at the end of the conversation's stable region, which is what makes a
churning one safe for prompt caching — the real system position is the provider install's own `system`
parameter." persona: (agent (value: null) -> string with {...E, prelude.throw[unknown]}) | null ?= null,
  @"The store workspace this AI lives in — the whole fiber runs inside `store.workspace(path = ...)`, so
every store key its tools touch is confined to that subtree and two AIs cannot read or overwrite each
other's memory by accident. `null` (the default) runs in whatever workspace the app installed above the
route, which is what AIs sharing a place want." workspace: string | null ?= null,
  @"The compaction policy; `null` (the default) is `default_compaction`." policy: compaction | null ?= null,
  @"The per-tool-call budget in milliseconds, or `null` (the default) for no deadline." tool_budget_milliseconds: number | null ?= null,
  @"Tool names exempt from the deadline race (human-latency tools)." unbounded_tool_names: array[string] ?= [],
  @"Keep this AI's conversation so a `supervise` re-run resumes the thread rather than starting it over (a
runtime restart keeps it either way). `false` (the default) leaves the conversation in run state alone —
the right choice when a re-run is meant to be fresh, as it is for a program whose durable knowledge lives
in the store and whose conversation is ephemeral working memory (and a re-run provoked by the conversation
itself must not resume it, or it re-drives the same crash). The route keeps it in a cell of its own keyed
by @name@, apart from the AI's tool workspace; attachments are shed before the write, so what resumes is
the text, not the files. A dismissed AI's cell is cleared, so re-using its name does not resurrect its
thread." persist_conversation: boolean ?= false,
) -> never {
  // The note this AI injects at every step, or nothing at all; `with_context` skips an empty note.
  agent standing_note(value: null) -> string with {...E, prelude.throw[unknown], infer_step} {
    match (persona) {
      case null -> ""
      case derive -> derive(value = null)
    }
  }
  // The name the route persists this AI's conversation under — its own name, or `null` when off. The route
  // owns the cell, so nothing here spells a store key.
  let conversation_id = if (persist_conversation) { name } else { null }
  // The AI's whole body as one agent, because the workspace decision below has to wrap it: `use` binds
  // the rest of its own block, so an install that happens only sometimes has to be a call whose argument
  // is the body.
  agent embodied(value: null) -> never {
    // The mailbox: a nursery of this fiber's OWN, so what is forked into it lands in THIS conversation.
    let box: mailbox = use region.provide[mail_scope, observation]
    register(name = name, box = box)
    use with_context(inject = standing_note)
    // The instantiation adds what the body itself raises: the mailbox's scope marker, the two ending
    // events its watch re-emits, the throw this AI's own agents are allowed, and the persistence seam the
    // route serves. A resident assembled by hand outside a route omits `conversation_id` and never raises
    // the last two.
    use serve_observations[never, {...E, prelude.throw[unknown], mail_scope, region.crashed, region.failed, recall_conversation, remember_conversation} | io](
      tools = tools,
      max_steps = max_steps,
      deliver_to = deliver_to,
      policy = policy,
      tool_budget_milliseconds = tool_budget_milliseconds,
      unbounded_tool_names = unbounded_tool_names,
      conversation_id = conversation_id,
    )
    // The mailbox's white hole: every mail fiber's `observation` surfaces here, inside the install above,
    // and is served as one more turn of this AI's conversation.
    region.watch(nursery = box)
  }
  match (workspace) {
    case null -> embodied(value = null)
    // The workspace wraps the whole fiber rather than each dispatch, so one install confines every key
    // the AI will ever write — and because it is a fiber of its own, its serial domain is its own too.
    case path -> store.workspace(path = path, continuation = embodied)
  }
}


// ── the route: the product surface — one line per AI, and mail between them ────
//
// `route` opens the nursery the AIs live in, keeps the table of who is addressable, answers the
// `register` handshake, forks a delivery fiber per `mail`, cancels a fiber per `dismiss`, and forgets an
// AI the moment it dies. It is a transparent provider and does not watch for you: the `watch` is the
// app's line, because what the AIs' escalations mean is the app's. Every clause is a table lookup, a
// `record.set` and at most a `region.fork`; the one thing that can hold their shared lane is an app's own
// `crashed` / `failed` handler, which the route re-performs outward and waits for.

@"The scope marker of the nursery `route` opens: the route owns that nursery, so a program spawning its
AIs through this surface never spells a marker or a fiber-effect ceiling at all. Distinct from
`mail_scope` on purpose — the AIs' nursery and an AI's mailbox are different places, and distinct markers
keep a handle to one unusable against the other."
effect route_scope

// What an AI's own agents may raise: the program's effects, plus the three requests the route serves, so
// a tool can mail another AI, hire one, or dismiss one. Written once because it appears in five parameter
// types. (Type synonyms take no docs.)
type crew[effect E] = {...E, spawn[E], mail, dismiss}

@"Read a persisting AI's stored conversation by name — a fresh one when it has none yet. Served by the
route, which keeps every AI's conversation under its own `conversations/<name>` cell; a resident performs
it once at start. Internal to the route/resident seam."
request recall_conversation(name: string) -> resident_state

@"Write a persisting AI's conversation by name (attachments already shed). Served by the route into the
same `conversations/<name>` cell; a resident performs it after each turn. Internal to the route/resident
seam."
request remember_conversation(name: string, state: resident_state) -> null

// The route nursery's fiber-effect ceiling: what one AI's fiber can raise — its own agents' effects, the
// seam, the handshake, the conversation-persistence seam, a workspaced resident's store operations, and
// its mailbox watch's ending events. (Type synonyms take no docs.)
type routed[effect E] = {...crew[E], infer_step, register, recall_conversation, remember_conversation, region.crashed, region.failed, store.get, store.set, store.delete, store.list} | io

// The nursery handle `route` hands its continuation — the one thing an app does with it is `watch` it.
// (Type synonyms take no docs.)
type crew_nursery[effect E] = region.nursery[route_scope, routed[E]]

@"An AI was hired: @id@ is its fiber id (the same id `dismiss` answers with, and the one `crashed` /
`failed` names when it dies)."
data spawned(@"The new AI's fiber id." id: string)

@"No AI was hired — one of that name is already running, and @id@ is its fiber id. A name is not silently
taken over, because the replaced AI's fiber would go on living with nothing addressing it. Dismiss it
first if replacing is what you meant."
data already_running(@"The fiber id of the AI already holding the name." id: string)

// A hire's outcome. (Type synonyms take no docs.)
type spawn_outcome = spawned | already_running

@"The mail is on its way: a delivery fiber has been forked into the addressee's mailbox. A handoff and
not a receipt — the report becomes a turn when the addressee's serving handler gets to it."
data posted()

@"Nobody answers to that name: either no AI ever registered it, or the one that did is gone (its inbox
refused the delivery, and the route has just forgotten it). A value rather than a panic, because a name
is data — a model picks one, a stored routing rule holds one — so a stale addressee is anticipated input."
data no_recipient(@"The name nothing answers to." to: string)

// A mail's outcome. (Type synonyms take no docs.)
type mail_outcome = posted | no_recipient

@"The AI is dismissed: its fiber and its sources have been cancelled and its name is free again."
data dismissed(@"The fiber id that was cancelled." id: string)

@"No AI of this route answers to that name: it never ran, it has been dismissed or has died — or it is a
resident the program forked itself, which the route can address but cannot cancel, since a fiber is
cancelled through the nursery that owns it."
data unknown_resident(@"The name that matched no fiber this route forked." name: string)

// A dismissal's outcome. (Type synonyms take no docs.)
type dismiss_outcome = dismissed | unknown_resident

@"Hire one AI: fork a `resident` into the route's nursery under @name@ and — once it announces its
mailbox — its @sources@ beside it. Answers `spawned(id)`, or `already_running(id)` when the name is taken.

Spell the effect argument: `ai.spawn[io | discord.send](...)`. @E@ is the row this program's own agents
run under, and nothing infers it at a perform site — a request's type arguments are not recovered from
its arguments the way an agent call's are, so an unspelled `ai.spawn(...)` is a `K3016` — or, when a
tool's own row happens to fit, a confusing `K3001` about a request the row does not allow.

Sources start at the handshake and not at this call, so a source that mails on its very first breath
cannot post to an address that does not exist yet.

Everything in the argument record travels into a fiber the caller does not own, so `tools`, `persona`,
`deliver_to` and `sources` are named top-level agents over plain data: a named agent captures nothing,
while a closure carries the calling fiber's environment with it."
request spawn[effect E](
  @"The AI's name: how mail addresses it, how `dismiss` names it, and the fiber's own name tag." name: string,
  @"Its tool set — the whole of what this AI can do." tools: array[agent never -> unknown with {...crew[E], inbound_provenance, prelude.throw[unknown]}],
  @"The per-observation step budget." max_steps: integer,
  @"The note recomputed and injected at every model step, or `null` for none — see `resident`." persona: (agent (value: null) -> string with {...crew[E], prelude.throw[unknown]}) | null ?= null,
  @"Where a turn's non-empty reply goes; `null` (the default) is an AI that speaks only through its tools." deliver_to: (agent (reply: string) -> null with {...crew[E], prelude.throw[unknown]}) | null ?= null,
  @"This AI's own background watchers, each forked with `self` = @name@ and mailing what it sees back to it." sources: array[agent (self: string) -> null with {...crew[E], prelude.throw[unknown]}] ?= [],
  @"The store workspace this AI is confined to, or `null` (the default) to share the app's." workspace: string | null ?= null,
  @"The compaction policy; `null` (the default) is `default_compaction`." policy: compaction | null ?= null,
  @"The per-tool-call budget in milliseconds, or `null` (the default) for no deadline." tool_budget_milliseconds: number | null ?= null,
  @"Tool names exempt from the deadline race (human-latency tools)." unbounded_tool_names: array[string] ?= [],
  @"Keep this AI's conversation in the store, so a `supervise` re-run resumes its thread rather than
starting it over; `false` (the default) keeps nothing across a re-run — see `resident` for when to turn it
on." persist_conversation: boolean ?= false,
) -> spawn_outcome

@"Post one report to one AI: look @to@ up in the route's table and fork a delivery fiber into its mailbox,
where it becomes an `observation` — one more turn of that AI's conversation. Answers `posted()`, or
`no_recipient(to)` when nothing answers to the name.

It takes plain data only, and every field of it is `observation`'s. @hop@ has no default here either: write
`hop = 0` for something a person or a clock caused, and `ai.inbound_provenance().hop + 1` in a tool that
relays what it was told. Delivery is at-most-once — a mailbox that has already died refuses the fiber,
and the route answers `no_recipient` and forgets the entry, which is where the table learns of a death it
was not told about."
request mail(
  @"The AI to reach, by the name it registered." to: string,
  @"Who is sending (e.g. \"mail:core\", \"discord:#ops\"); it labels the report's injection turn." source: string,
  @"The report itself." content: string,
  @"How many agent-to-agent hops this report has already made; 0 for a person or a clock. No default, on purpose." hop: integer,
  @"Files riding the report." files: array[file] ?= [],
  @"The opaque end-user tag of the human behind it, or `null` for a system report." author: string | null ?= null,
) -> mail_outcome

@"DISMISS ONE AI: cancel its fiber and its sources, and free the name. Answers `dismissed(id)`, or
`unknown_resident(name)` when this route forked no such AI. A dismissed AI is gone for good: its
conversation goes with it — a persisted one has its cell cleared too, so re-using the name later starts a
fresh thread rather than waking the old one. (A crash is different: the cell survives it, which is how a
re-hire resumes.)"
request dismiss(@"The AI to dismiss, by name." name: string) -> dismiss_outcome

@"One AI the route has hired, as its table holds it: the resident's own fiber id, and the ids of the
source fibers forked beside it (empty until it registers). The mailbox is not here — it arrives at a
different moment, and for a resident the program forked itself it arrives with no enrolment at all, which
is how `dismiss` tells the two apart. Internal to `route`."
data enrolment(
  @"The resident fiber's runtime-minted id." id: string,
  @"The ids of the source fibers forked beside it." sources: array[string],
)

@"Open the route for the extent of @continuation@ — the `let root = use ai.route()` line. It opens the
nursery the AIs live in, hands @continuation@ its handle (to be watched as the program's tail), and
serves `spawn` / `mail` / `dismiss`, the `register` handshake the residents announce themselves with, and
the two ending events, which it uses to forget a dead AI before re-raising them outward unchanged.

The route re-performs the ending events outward, so your own handlers — the provider, the breaker,
whatever serves your tools' effects, and `region.crashed` / `region.failed` — are installed above this
line, where those re-performs reach them; one installed below this line sits below the re-performs and
never sees them.

An AI becomes addressable when its `register` handshake is served, and a fiber's escalations are held
durably until the watch is up. The first report to an AI therefore comes from something that runs after
`region.watch(nursery = root)`: a `sources` entry (forked at the handshake), a tool, or one of your own
handlers. A `mail` performed before that answers `no_recipient`, and nothing is retried.

Put a restart at the altitude of what died. A `crashed` names a dead fiber whose region is alive, so a
re-hiring handler stands inside this provider's extent (below this line, above the watch), where a
`spawn` reaches the route; above this line is outside the region, and a `spawn` there escalates past the
route to the run root as an open question. An ending travels both altitudes in order — the route evicts,
an in-region re-hire handler acts, the outer notice speaks — so a re-hire handler re-performs the event
outward first and spawns after.

It carries the four store operations whatever your AIs actually do, because `spawn`'s `workspace` option
means a resident may re-perform them and an effect row is static; read them as \"reaches the store\".
There is no pending queue for mail to an AI that has not registered yet (the caller gets `no_recipient`
and decides), no broadcast and no priorities: those are routing policy, and a program with an opinion
writes it over the mechanism layer this one is built from."
agent route[effect E lacks spawn | mail | dismiss | register | time.race_settled, R](
  @"The program under the route: spawns its AIs and ends in `region.watch(nursery = root)`." continuation: agent (value: crew_nursery[E]) -> R with {...routed[E], route_scope},
) -> R {
  // The AIs' nursery. Its ceiling is `routed[E]`, so `watch` in the continuation re-emits exactly that
  // and this handler catches the four requests below out of it.
  let root = use region.provide[route_scope, routed[E]]
  // The franking. Forking into a mailbox is gated on `mail_scope` being in the forker's row, a marker
  // only `provide` can mint — so the route opens a nursery of its own under it purely to hold the stamp.
  // It stays empty, and the merge is type-level: a fork routes by the handle's own runtime scope
  // identity.
  let _franking: mailbox = use region.provide[mail_scope, observation]
  // Fork one AI's sources at the handshake and not at the spawn, so a watcher that mails on its first
  // breath finds a mailbox to post into. Each source is numbered in the order it was given, because
  // `roster`, `crashed` and `failed` all report a fiber by its name tag: with one shared tag an AI's
  // third watcher dying reads exactly like its first.
  agent start_sources(name: string, pending: array[agent (self: string) -> null with {...crew[E], prelude.throw[unknown]}]) -> array[string] {
    for (let source in pending, var index: integer = 0) {
      next region.fiber_id(handle = region.fork(nursery = root, task = source, argument = { self = name }, name = f"${name}/source/${index}")) with { index = index + 1 }
    }
  }
  // Stop every source fiber of one AI; the resident itself is cancelled (or already dead) at the call
  // site. A stale id answers `unknown_fiber` and is discarded — a source that settled is not an error.
  agent stop_sources(table: record[enrolment], name: string) -> null {
    let _outcomes = match (record.get(target = table, key = name)) {
      case null -> []
      case enrolment(id => _, sources => sources) -> {
        for (let source_id in sources) { next region.cancel_by_id(nursery = root, id = source_id) }
      }
    }
    null
  }
  // Which AI owns a fiber id, or `null` when the id is none of the route's residents — a mail fiber that
  // died inside somebody's mailbox, a source, an id from another nursery entirely.
  agent resident_named(table: record[enrolment], id: string) -> string | null {
    for (let [name, entry] in record.entries(target = table), var found: string | null = null) {
      match (entry) {
        case enrolment(id => running, sources => _) -> {
          if (running == id) {
            next with { found = name }
          } else {
            next with { found = found }
          }
        }
      }
    } then (_entries) { found }
  }
  // One handler, because the four clauses share one table. It is sequential, which is also what makes the
  // name check in `spawn` sound: two fibers hiring the same name cannot both find it free.
  use handler (
    var boxes: record[mailbox] = {},
    var enrolled: record[enrolment] = {},
    var waiting: record[array[agent (self: string) -> null with {...crew[E], prelude.throw[unknown]}]] = {},
  ) {
    request spawn[E](
      name: string,
      tools: array[agent never -> unknown with {...crew[E], inbound_provenance, prelude.throw[unknown]}],
      max_steps: integer,
      persona: (agent (value: null) -> string with {...crew[E], prelude.throw[unknown]}) | null,
      deliver_to: (agent (reply: string) -> null with {...crew[E], prelude.throw[unknown]}) | null,
      sources: array[agent (self: string) -> null with {...crew[E], prelude.throw[unknown]}],
      workspace: string | null,
      policy: compaction | null,
      tool_budget_milliseconds: number | null,
      unbounded_tool_names: array[string],
      persist_conversation: boolean,
    ) {
      match (record.get(target = enrolled, key = name)) {
        case enrolment(id => running, sources => _) -> {
          next already_running(id = running) with { boxes = boxes, enrolled = enrolled, waiting = waiting }
        }
        case _ -> {
          // The AI's whole body is `resident`; the fork's name tag is the AI's name, so a `crashed`
          // reads as the AI.
          let child = region.fork(
            nursery = root,
            task = resident[crew[E]],
            argument = {
              name = name,
              tools = tools,
              deliver_to = deliver_to,
              max_steps = max_steps,
              persona = persona,
              workspace = workspace,
              policy = policy,
              tool_budget_milliseconds = tool_budget_milliseconds,
              unbounded_tool_names = unbounded_tool_names,
              persist_conversation = persist_conversation,
            },
            name = name,
          )
          let id = region.fiber_id(handle = child)
          next spawned(id = id) with {
            boxes = boxes,
            enrolled = record.set(target = enrolled, key = name, value = enrolment(id = id, sources = [])),
            waiting = record.set(target = waiting, key = name, value = sources),
          }
        }
      }
    }
    request register(name: string, box: mailbox) {
      // The AI is addressable from this moment, so this is also the moment its sources may start.
      let started = match (record.get(target = waiting, key = name)) {
        case null -> []
        case pending -> start_sources(name = name, pending = pending)
      }
      // A resident the program forked has no enrolment; it still gets a mailbox entry, which is the whole
      // of what `mail` needs. Only `dismiss` tells the two apart.
      let filed = match (record.get(target = enrolled, key = name)) {
        case enrolment(id => id, sources => _) -> record.set(target = enrolled, key = name, value = enrolment(id = id, sources = started))
        case _ -> enrolled
      }
      next null with {
        boxes = record.set(target = boxes, key = name, value = box),
        enrolled = filed,
        waiting = record.remove(target = waiting, key = name),
      }
    }
    request mail(to: string, source: string, content: string, hop: integer, files: array[file], author: string | null) {
      match (record.get(target = boxes, key = to)) {
        case null -> { next no_recipient(to = to) with { boxes = boxes, enrolled = enrolled, waiting = waiting } }
        case box -> {
          // A fork into a nursery that has already died panics — delivery is at-most-once and this is the
          // one place that can hear about it. Nothing is re-run, which is right for a send.
          agent posting(value: null) -> null {
            use supervise.signal_panics[never]()
            let _fiber = region.fork(
              nursery = box,
              task = deliver,
              argument = { source = source, content = content, hop = hop, files = files, author = author },
              name = f"mail:${to}",
            )
            null
          }
          match (supervise.once(task = posting)) {
            case supervise.ran(value => _) -> { next posted() with { boxes = boxes, enrolled = enrolled, waiting = waiting } }
            case supervise.signalled(failure => _) -> {
              // The inbox is gone, so the AI is: forget it and stop the watchers still feeding it, rather
              // than leaving a name that refuses every send from here on.
              stop_sources(table = enrolled, name = to)
              next no_recipient(to = to) with {
                boxes = record.remove(target = boxes, key = to),
                enrolled = record.remove(target = enrolled, key = to),
                waiting = record.remove(target = waiting, key = to),
              }
            }
          }
        }
      }
    }
    request dismiss(name: string) {
      match (record.get(target = enrolled, key = name)) {
        case enrolment(id => id, sources => _) -> {
          stop_sources(table = enrolled, name = name)
          let _stopped = region.cancel_by_id(nursery = root, id = id)
          // A dismissed AI is gone for good, so its conversation goes too — otherwise re-using the name
          // would wake a fresh AI inside the old thread. The route owns the cell, so this is a plain delete
          // of `conversations/<name>` (a no-op when the AI never persisted). A crash is NOT a dismissal:
          // its cell survives, which is what lets a re-hire resume the thread.
          let _cleared = store.delete(key = f"conversations/${name}")
          next dismissed(id = id) with {
            boxes = record.remove(target = boxes, key = name),
            enrolled = record.remove(target = enrolled, key = name),
            waiting = record.remove(target = waiting, key = name),
          }
        }
        case _ -> { next unknown_resident(name = name) with { boxes = boxes, enrolled = enrolled, waiting = waiting } }
      }
    }
    request region.crashed(id: string, name: string, message: string) {
      // A death the route can match is one of its own AIs: forget it, stop its watchers, and re-raise the
      // event unchanged so the program's own handler reports it. Everything else passes straight through.
      match (resident_named(table = enrolled, id = id)) {
        case null -> {
          next region.crashed(id = id, name = name, message = message) with { boxes = boxes, enrolled = enrolled, waiting = waiting }
        }
        case gone -> {
          stop_sources(table = enrolled, name = gone)
          next region.crashed(id = id, name = name, message = message) with {
            boxes = record.remove(target = boxes, key = gone),
            enrolled = record.remove(target = enrolled, key = gone),
            waiting = record.remove(target = waiting, key = gone),
          }
        }
      }
    }
    request region.failed(id: string, name: string, error: unknown) {
      match (resident_named(table = enrolled, id = id)) {
        case null -> {
          next region.failed(id = id, name = name, error = error) with { boxes = boxes, enrolled = enrolled, waiting = waiting }
        }
        case gone -> {
          stop_sources(table = enrolled, name = gone)
          next region.failed(id = id, name = name, error = error) with {
            boxes = record.remove(target = boxes, key = gone),
            enrolled = record.remove(target = enrolled, key = gone),
            waiting = record.remove(target = waiting, key = gone),
          }
        }
      }
    }
  }
  // Conversation persistence: the route keeps every persisting AI's conversation in a cell of its own,
  // `conversations/<name>`, so an AI's own workspace holds only what its tools write and `dismiss` clears
  // the thread with a plain delete. A resident recalls once at start and remembers after each turn.
  // Parallel: each AI writes its own key, so a per-turn write need not serialize behind a spawn or another
  // AI's.
  use parallel handler {
    request recall_conversation(name: string) {
      next store.get_or[resident_state](key = f"conversations/${name}", fallback = fresh_resident())
    }
    request remember_conversation(name: string, state: resident_state) {
      store.set(key = f"conversations/${name}", value = state)
      next null
    }
  }
  continuation(value = root)
}

// ── ambient-context middleware ────────────────────────────────────────────────

@"The index of the newest plain `turn` spoken by the user — where an ambient note is injected so that the
bytes before it never move (see `with_context`). A history with no user turn answers 0."
agent newest_user_index(@"The conversation so far." history: array[types.message]) -> integer {
  for (let message in history, var found: integer = 0, var index: integer = 0) {
    match (message) {
      case types.turn(role => role, text => _, files => _, author => _) -> {
        match (role) {
          case types.user_role(_) -> { next with { found = index, index = index + 1 } }
          case types.model_role(_) -> { next with { found = found, index = index + 1 } }
        }
      }
      case _ -> { next with { found = found, index = index + 1 } }
    }
  } then (_messages) { found }
}

@"Middleware over the seam: at every `infer_step`, insert @inject@'s freshly computed text as a user turn
just before the newest user turn, and re-perform outward to the ambient provider. Install it inside the
provider (the provider's `use` first, then this). An empty injection skips the extra turn; the injected
turn is never part of the conversation a loop persists, since it is derived fresh each step.
`infer_object` passes through un-injected.

The note lands at the end of the conversation's stable region: an ambient note is by definition the part
that changes, every model API reuses a repeated request prefix only while it stays byte-identical, and a
turn's tool loop only appends after the newest user turn."
agent with_context[R, effect E](
  @"Computes the note to inject this step — ambient state (the time, a memory index), fresh each step." inject: agent (value: null) -> string with {...E, infer_step},
  @"The program to run with the injection installed." continuation: agent (value: null) -> R with {...E, infer_step},
) -> R with E | infer_step {
  // Parallel, like every middleware at this seam: the clause computes the note and then makes the model
  // call in its own body, so a sequential handler here would put every step passing through it into one
  // FIFO — the whole program's bottleneck the moment one note stands above several AIs.
  use parallel handler {
    request infer_step(history: array[types.message], tool_metas: array[reflection.agent_metadata]) -> step_outcome {
      let note = inject(value = null)
      let injected = if (note == "") {
        history
      } else {
        let cut = newest_user_index(history = history)
        array.concat(
          left = array.append(target = array.slice(target = history, start = 0, end = cut), value = types.turn(role = types.user_role(), text = note, files = [])),
          right = array.slice(target = history, start = cut, end = array.length(target = history)),
        )
      }
      // Re-performing escalates past this handler to the ambient provider.
      next infer_step(history = injected, tool_metas = tool_metas)
    }
  }
  continuation(value = null)
}

// ── the model breaker: middleware over the seam ───────────────────────────────
//
// Absorbing a failed step is right when the provider is having a bad minute and wrong when it is out for
// the evening. Whether the provider is answering is a fact about the provider, so the breaker sits at the
// seam and one install covers every resident in the program; a provider's own retry ladder is untouched
// underneath, because it answers how hard one call tries rather than whether to start one.
//
// The handler is parallel and its few numbers live at one store key: a stateful handler here would put
// every model call in the program into one FIFO, so atomicity comes from a short `store.exclusive`
// section with the model call outside it — and the state is durable, so a restart into a standing outage
// does not re-discover it. The decision to call is read outside the section (two concurrent steps may
// both call, costing at most one extra call per transition); the bookkeeping re-reads inside it and is
// exact.

@"What a failed step says about who can end the outage: a person must act. A 400 (a spent credit balance,
a model the provider no longer serves), a 401 or 403 (a wrong, revoked or under-privileged key) and a 404
do not heal with time, so @remedy@ carries the one clause that turns an evening of silence into a
five-minute fix."
data needs_operator(@"What to check, in one clause." remedy: string)

@"What a failed step says about who can end the outage: nobody — it is the kind that passes. A rate
limit, a 5xx, a dropped connection, a reply the provider could not make sense of. The provider has already
spent its retry budget on it, so the only jobs left are to stop hammering and to say nothing an operator
cannot act on."
data waits_out()

// What a failed step says about who can end the outage. (Type synonyms take no docs.)
type outage_kind = needs_operator | waits_out

@"Classify a failed step by who can end it. An `http.auth_error` is always a person's job — 401 and 403
both name a credential nobody but an operator can replace — while an `http.api_error` needs its status
read, because that arm holds a 400 (act) beside a 429 (wait). A `json.parse_error` and a `provider_error`
land in `waits_out` deliberately: they are not transient either, but there is no lever to hand an operator
for them. Everything else waits, `http.fetch_error` included."
agent classify_outage(@"The failed step's error." error: step_error) -> outage_kind {
  match (error) {
    case http.auth_error(status => status, context => _, message => _) -> {
      match (status) {
        case 403 -> needs_operator(remedy = "the provider refused the API key's permissions — check the key's plan and model access")
        case _ -> needs_operator(remedy = "the provider refused the API key — it is wrong, revoked or expired")
      }
    }
    case http.api_error(status => status, context => _, message => _) -> {
      match (status) {
        case 400 -> needs_operator(remedy = "the provider is rejecting the request outright — check the API credit balance first, then whether the configured model name still exists")
        case 404 -> needs_operator(remedy = "the provider does not know the configured model — check the model name")
        case _ -> waits_out()
      }
    }
    case http.fetch_error(message => _) -> waits_out()
    case json.parse_error(message => _) -> waits_out()
    case provider_error(source => _, message => _, transient => _, detail => _) -> waits_out()
  }
}

@"The two lines a breaker transition is worth saying, as one agent over the classification. Both are
fixed and model-free, so neither leaks anything of a conversation; only the `needs_operator` one names
plumbing, which is why an app posting to a channel strangers read should hand this `waits_out()` whatever
the kind actually was and route the remedy to the operator instead."
agent outage_line(@"What the failure said about who can end it." kind: outage_kind) -> string {
  match (kind) {
    case needs_operator(remedy => remedy) -> f"(the model is not answering, and it will not recover on its own: ${remedy}. I have stopped calling it — what arrives is kept, and I pick it up once it works again.)"
    case waits_out(_) -> "(the model is not answering. I have stopped calling it for now — what arrives is kept, and I keep trying periodically.)"
  }
}

@"The one line a channel hears when the breaker closes: a probe got an answer. One line on the way back,
matching the one on the way out."
agent recovery_line() -> string {
  "(the model is answering again — picking up from where it stopped.)"
}

@"The breaker OPENED: the model has stopped being called at all. @kind@ chose the wording and names the
remedy when there is one."
data breaker_opened(@"What the failure that opened it said about who can end it." kind: outage_kind)

@"The breaker CLOSED: a probe got an answer and calls have resumed. @kind@ is what the outage was LAST
classified as, so a sink can tell whoever it sent to check something that there is nothing left to
check."
data breaker_closed(@"What the outage was last classified as." kind: outage_kind)

// A breaker transition. Exactly two of these happen per outage, whatever it costs. (Type synonyms take no docs.)
type breaker_event = breaker_opened | breaker_closed

@"How the breaker behaves. @failure_threshold@ consecutive failed steps open it; while open, one step
per probe interval is spent testing for recovery, starting at @probe_backoff_floor_milliseconds@ after
the first failed probe and doubling up to @probe_backoff_cap_milliseconds@."
data breaker_policy(
  @"How many CONSECUTIVE failed steps open the breaker." failure_threshold: integer,
  @"The wait before the SECOND probe of an outage — the ladder's floor, not the wait before the first, which is none." probe_backoff_floor_milliseconds: number,
  @"The longest an open breaker ever waits between probes." probe_backoff_cap_milliseconds: number,
)

@"The default breaker policy: three consecutive failures open it (one failure is noise and two can still
be one bad minute), and the probe ladder runs from 30 seconds to ten minutes."
agent default_breaker_policy() -> breaker_policy {
  breaker_policy(
    failure_threshold = 3,
    probe_backoff_floor_milliseconds = 30000.0,
    probe_backoff_cap_milliseconds = 600000.0,
  )
}

@"The breaker, CLOSED: the model is answering, and @consecutive_failures@ steps have failed back to
back since the last success (0 in the ordinary case)."
data model_answering(@"Failures since the last success; reset to 0 by any successful step." consecutive_failures: integer)

@"The breaker, open: the provider is not being called. @kind@ is what the most recent failure said about
who can fix it, re-read at every failed probe because an outage can change hands. @next_probe@ is the
earliest instant a probe may run and @next_delay@ is how far the one after it gets pushed out — the ladder
lives in the state, not in a constant."
data model_down(
  @"What the last failure said about who can end this." kind: outage_kind,
  @"The earliest epoch-millisecond instant a probe may run." next_probe: number,
  @"How long the NEXT failed probe pushes the one after it out, in milliseconds." next_delay: number,
)

// The breaker's state. One per `with_breaker` install, not one per conversation. (Type synonyms take no docs.)
type breaker_state = model_answering | model_down

@"The breaker's decision for one step: CALL the provider — either the breaker is closed (the ordinary
case) or it is open and the probe is due, so this step is spent on the one probe that tests for
recovery."
data call_now()

@"The breaker's decision for one step: do NOT call — the breaker is open and the probe is not due. The
open breaker rides the verdict so the caller never re-matches a state the decision already looked at."
data hold_off(@"The open breaker this step is refused by." down: model_down)

// What becomes of one step, decided once from the breaker state. (Type synonyms take no docs.)
type breaker_verdict = call_now | hold_off

@"The probe-due comparison, made once and turned into a sum: an open breaker spends a step on a probe
when @now@ has reached its @next_probe@ and refuses every other; a closed breaker always calls. The first
probe of an outage does not wait at all, so a three-failure blip costs the program the next step and no
more."
agent may_call(@"The breaker as it stands." breaker: breaker_state, @"The current instant, in epoch milliseconds." now: number) -> breaker_verdict {
  match (breaker) {
    case model_answering(consecutive_failures => _) -> call_now()
    case down: model_down -> {
      if (now >= down.next_probe) {
        call_now()
      } else {
        hold_off(down = down)
      }
    }
  }
}

@"The breaker after one failed step: under the threshold it stays closed with the count raised; at the
threshold it opens ready — @next_probe@ is @now@, so the next step to arrive probes immediately. An
already-open breaker climbs its ladder instead, doubling the delay up to the cap and re-reading the kind
from this failure."
agent after_failure(
  @"The breaker as it stands." breaker: breaker_state,
  @"The policy." policy: breaker_policy,
  @"What this failure said about who can end it." kind: outage_kind,
  @"The instant of the failed step, in epoch milliseconds." now: number,
) -> breaker_state {
  match (breaker) {
    case model_answering(consecutive_failures => before) -> {
      let failures = before + 1
      if (failures < policy.failure_threshold) {
        model_answering(consecutive_failures = failures)
      } else {
        model_down(kind = kind, next_probe = now, next_delay = policy.probe_backoff_floor_milliseconds)
      }
    }
    case down: model_down -> {
      model_down(
        kind = kind,
        next_probe = now + down.next_delay,
        next_delay = math.min(left = down.next_delay * 2.0, right = policy.probe_backoff_cap_milliseconds),
      )
    }
  }
}

@"The step error an open breaker answers with — a refusal, not a failure: nothing was sent. @kind@ is
what the outage was last classified as and @retry_after_milliseconds@ is how long until the next probe is
due, so a caller can say something true without asking the breaker anything."
data breaker_refused(@"What the outage was last classified as." kind: outage_kind, @"How long until a probe is due, in milliseconds." retry_after_milliseconds: number)

@"The `step_error` an open breaker resolves the seam with: a `provider_error` from this middleware, marked
transient (an open breaker is by definition a state that ends) and carrying the typed `breaker_refused` as
its detail. It rides the ordinary failure channel, so a loop that knows nothing of breakers still handles
it as the step failure it is."
agent breaker_refusal_error(@"The open breaker." down: model_down, @"The current instant, in epoch milliseconds." now: number) -> step_error {
  provider_error(
    source = "ai.with_breaker",
    message = "the model was not called: this program's breaker is open after consecutive failed steps",
    transient = true,
    detail = breaker_refused(
      kind = down.kind,
      retry_after_milliseconds = math.max(left = 0.0, right = down.next_probe - now),
    ),
  )
}

@"Read a step error as the breaker's refusal, or `null` when it is a genuine failure. A refusal spent no
model call and sent nothing, so it refused no attachment: a resident files the report and sheds nothing."
agent breaker_refusal(@"The step error to read." error: step_error) -> breaker_refused | null {
  match (error) {
    case provider_error(source => _, message => _, transient => _, detail => detail) -> {
      match (detail) {
        case breaker_refused(kind => kind, retry_after_milliseconds => wait) -> breaker_refused(kind = kind, retry_after_milliseconds = wait)
        case _ -> null
      }
    }
    case _ -> null
  }
}

@"The breaker did NOT change state on this step — the ordinary answer, on which nothing is announced."
data breaker_held()

// What one step's bookkeeping did to the breaker: nothing, or one of the two transitions worth saying
// out loud. (Type synonyms take no docs.)
type breaker_flip = breaker_held | breaker_event

@"The store key the breaker's state lives at, relative to whatever workspace `with_breaker` was installed
in. One key, because there is one breaker per program: a second install in the same workspace shares
these numbers, and one under a different workspace is a different program's breaker."
agent breaker_key() -> string {
  "ai/breaker"
}

@"Fold one step's outcome into the stored breaker state, atomically, and say whether it flipped. This is
the critical section: it re-reads the state (the decision to call was made from a read outside it, which
may be one step stale), applies this outcome, writes it back and answers the transition, all inside
`store.exclusive`. @on_transition@ is called by the caller on the answer, because a critical section that
could call out would be one holding a network."
agent record_step(
  @"Whether the step the breaker just watched succeeded." succeeded: boolean,
  @"What the failure said about who can end it (ignored on success)." kind: outage_kind,
  @"The policy." policy: breaker_policy,
  @"The instant of the step, in epoch milliseconds." now: number,
) -> breaker_flip with store.exclusive {
  agent settle(value: null) -> unknown with store.get | store.set | store.delete | store.list {
    let before = store.get_or[breaker_state](key = breaker_key(), fallback = model_answering(consecutive_failures = 0))
    if (succeeded) {
      store.set(key = breaker_key(), value = model_answering(consecutive_failures = 0))
      // The recovery notice is read off the state being LEFT, so it fires exactly once.
      match (before) {
        case model_down(kind => was, next_probe => _, next_delay => _) -> breaker_closed(kind = was)
        case model_answering(consecutive_failures => _) -> breaker_held()
      }
    } else {
      let after = after_failure(breaker = before, policy = policy, kind = kind, now = now)
      store.set(key = breaker_key(), value = after)
      // Likewise the opening notice: the transition is the pair (was closed, is now open).
      match (before) {
        case model_answering(consecutive_failures => _) -> {
          match (after) {
            case model_down(kind => opened, next_probe => _, next_delay => _) -> breaker_opened(kind = opened)
            case model_answering(consecutive_failures => _) -> breaker_held()
          }
        }
        case model_down(kind => _, next_probe => _, next_delay => _) -> breaker_held()
      }
    }
  }
  // The section's answer crosses the `exclusive` handler as `unknown`, so it is narrowed back by
  // constructor rather than validated — a validation would put a throw in this middleware's row.
  match (store.exclusive(task = settle)) {
    case breaker_opened(kind => kind) -> breaker_opened(kind = kind)
    case breaker_closed(kind => kind) -> breaker_closed(kind = kind)
    case _ -> breaker_held()
  }
}

@"Middleware over the seam: install one breaker for every model call in @continuation@'s dynamic extent —
every resident, every hand-rolled `take_turn` — inside the provider (the provider's `use` first, then
this), so a refused step never reaches the provider at all.

@failure_threshold@ consecutive failed steps open it; while open, `infer_step` answers
`inference_failed(breaker_refusal_error(...))` without calling out, except for the one probe step per
interval that tests for recovery. @on_transition@ fires on the state change and nowhere else: once on the
way out, once on the way back. Where those two lines go and how they read is the app's — the sink gets the
`outage_kind`, and `outage_line` / `recovery_line` are the wordings this package suggests.

The handler is parallel and the state lives in the store (at `breaker_key`, in whatever workspace this is
installed in), so several AIs' model calls do not serialize behind one FIFO and a program that restarts
into a standing outage still knows about it. `infer_object` passes through un-broken."
agent with_breaker[R, effect E](
  @"Where the two lines per outage go, and what they say. Called once when the breaker opens and once when it closes." on_transition: agent (event: breaker_event) -> null with {...E, infer_step},
  @"The program to run with the breaker installed." continuation: agent (value: null) -> R with {...E, infer_step},
  @"The breaker policy; `null` (the default) is `default_breaker_policy`." policy: breaker_policy | null ?= null,
) -> R with E | infer_step | io | store.get | store.set | store.exclusive {
  let rules = match (policy) {
    case null -> default_breaker_policy()
    case given -> given
  }
  // Parallel, and it can be because it holds nothing: every number this breaker owns is at one store key,
  // and the atomicity a `var` handler's FIFO would have bought comes from `store.exclusive` instead.
  use parallel handler {
    request infer_step(history: array[types.message], tool_metas: array[reflection.agent_metadata]) -> step_outcome {
      // One clock read per step, so the probe-due test and the instant recorded are the same instant.
      let now = time.now()
      let breaker = store.get_or[breaker_state](key = breaker_key(), fallback = model_answering(consecutive_failures = 0))
      match (may_call(breaker = breaker, now = now)) {
        case hold_off(down => down) -> {
          next inference_failed(error = breaker_refusal_error(down = down, now = now))
        }
        case call_now(_) -> {
          // Re-performing escalates past this handler to the ambient provider. It happens outside any
          // critical section: this is the slow part, and nothing else may wait behind it.
          let outcome = infer_step(history = history, tool_metas = tool_metas)
          // The bookkeeping decides the transition from the state it just read, so the notice is read off
          // a state change and cannot fire twice.
          let flip = match (outcome) {
            case inferred(result => _) -> record_step(succeeded = true, kind = waits_out(), policy = rules, now = now)
            case inference_failed(error => error) -> record_step(succeeded = false, kind = classify_outage(error = error), policy = rules, now = now)
          }
          match (flip) {
            case breaker_held(_) -> null
            case breaker_opened(kind => opened) -> on_transition(event = breaker_opened(kind = opened))
            case breaker_closed(kind => was) -> on_transition(event = breaker_closed(kind = was))
          }
          next outcome
        }
      }
    }
  }
  continuation(value = null)
}
